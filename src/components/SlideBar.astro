---
// SlideBar.astro - Menú Lateral de Navegación Global
interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
const currentUrl = (Astro.url.pathname || "").replace(/\/$/, "").toLowerCase();

// Helper para determinar si un enlace está activo tanto en SSR como en cliente
const isLinkActive = (path: string, url: string) => {
  if (currentPath === path) return true;
  if (currentUrl === url.toLowerCase()) return true;
  if (path === "principal" && (currentUrl === "" || currentUrl === "/dashprincipal")) return true;
  return false;
};
---

{/* Backdrop sombreado con desenfoque para cerrar al pulsar fuera */}
<div
  id="sidebar-backdrop"
  class="fixed inset-0 bg-primary/50 backdrop-blur-xs z-40 hidden transition-opacity cursor-pointer touch-none"
  aria-hidden="true"
></div>

{/* Sidebar principal: Inicia estrictamente oculto fuera de pantalla por defecto */}
<aside
  id="main-sidebar"
  class="fixed left-0 top-0 h-screen w-72 max-w-[85vw] bg-surface-container-lowest z-50 flex flex-col justify-between shadow-2xl border-r border-surface-container pointer-events-none invisible -translate-x-full"
  aria-label="Navegación principal"
  aria-hidden="true"
>
  {/* Cabecera del Sidebar: Marca & Botón Cerrar */}
  <div class="h-16 px-4 flex items-center justify-between border-b border-surface-container/60 shrink-0">
    <div class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-xl bg-secondary-container flex items-center justify-center text-on-secondary shadow-xs">
        <span class="material-symbols-outlined text-[20px]">layers</span>
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5">
          <span class="font-headline-md text-[17px] font-bold text-primary tracking-tight">StockControl</span>
          <span class="font-label-sm text-[10px] bg-surface-container text-on-surface-variant px-1.5 py-0.5 rounded-md font-semibold">v2.4</span>
        </div>
        <span class="text-[10px] text-on-surface-variant font-medium tracking-wide uppercase">Enterprise JR</span>
      </div>
    </div>

    {/* Botón cerrar visible en cualquier tamaño */}
    <button
      id="btn-close-sidebar"
      type="button"
      class="p-1.5 rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low transition-colors cursor-pointer"
      title="Cerrar menú lateral"
    >
      <span class="material-symbols-outlined text-[20px]">close</span>
    </button>
  </div>

  {/* Lista de Navegación con Scroll Interno si es necesario */}
  <div class="flex-1 overflow-y-auto px-3 py-3">
    <div class="px-2 pb-2">
      <span class="text-[11px] font-semibold text-outline uppercase tracking-wider">Módulos Operativos</span>
    </div>

    <nav class="flex flex-col gap-1">
      {/* 1. Principal */}
      <a
        href="/DashPrincipal"
        data-path="principal"
        class={`flex items-center gap-3 px-3 py-2.5 rounded-xl font-label-md text-[13px] transition-all ${
          isLinkActive("principal", "/DashPrincipal")
            ? "bg-primary-container text-on-primary font-semibold shadow-xs"
            : "text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface"
        }`}
        aria-current={isLinkActive("principal", "/DashPrincipal") ? "page" : undefined}
      >
        <span class="material-symbols-outlined text-[20px]">grid_view</span>
        <span>Principal</span>
      </a>

      {/* 2. Control de Inventario */}
      <a
        href="/ControldeInventario"
        data-path="inventario"
        class={`flex items-center gap-3 px-3 py-2.5 rounded-xl font-label-md text-[13px] transition-all ${
          isLinkActive("inventario", "/ControldeInventario")
            ? "bg-primary-container text-on-primary font-semibold shadow-xs"
            : "text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface"
        }`}
        aria-current={isLinkActive("inventario", "/ControldeInventario") ? "page" : undefined}
      >
        <span class="material-symbols-outlined text-[20px]">inventory_2</span>
        <span>Control de Inventario</span>
      </a>

      {/* 3. Registro de Ventas */}
      <a
        href="/RegVenta"
        data-path="ventas"
        class={`flex items-center gap-3 px-3 py-2.5 rounded-xl font-label-md text-[13px] transition-all ${
          isLinkActive("ventas", "/RegVenta")
            ? "bg-primary-container text-on-primary font-semibold shadow-xs"
            : "text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface"
        }`}
        aria-current={isLinkActive("ventas", "/RegVenta") ? "page" : undefined}
      >
        <span class="material-symbols-outlined text-[20px]">point_of_sale</span>
        <span>Registro de Ventas</span>
      </a>

      {/* 4. Gastos Operativos */}
      <a
        href="/GastosOperativos"
        data-path="gastos"
        class={`flex items-center gap-3 px-3 py-2.5 rounded-xl font-label-md text-[13px] transition-all ${
          isLinkActive("gastos", "/GastosOperativos")
            ? "bg-primary-container text-on-primary font-semibold shadow-xs"
            : "text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface"
        }`}
        aria-current={isLinkActive("gastos", "/GastosOperativos") ? "page" : undefined}
      >
        <span class="material-symbols-outlined text-[20px]">receipt_long</span>
        <span>Gastos Operativos</span>
      </a>

      {/* 5. Servicios */}
      <a
        href="/Servicios"
        data-path="servicios"
        class={`flex items-center gap-3 px-3 py-2.5 rounded-xl font-label-md text-[13px] transition-all ${
          isLinkActive("servicios", "/Servicios")
            ? "bg-primary-container text-on-primary font-semibold shadow-xs"
            : "text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface"
        }`}
        aria-current={isLinkActive("servicios", "/Servicios") ? "page" : undefined}
      >
        <span class="material-symbols-outlined text-[20px]">home_repair_service</span>
        <span>Servicios</span>
      </a>

      {/* 6. Usuarios y Roles */}
      <a
        href="/UsuariosRoles"
        data-path="usuarios"
        class={`flex items-center gap-3 px-3 py-2.5 rounded-xl font-label-md text-[13px] transition-all ${
          isLinkActive("usuarios", "/UsuariosRoles")
            ? "bg-primary-container text-on-primary font-semibold shadow-xs"
            : "text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface"
        }`}
        aria-current={isLinkActive("usuarios", "/UsuariosRoles") ? "page" : undefined}
      >
        <span class="material-symbols-outlined text-[20px]">admin_panel_settings</span>
        <span>Usuarios y Roles</span>
      </a>
    </nav>
  </div>

  {/* PARTE INFERIOR: Perfil del Usuario Fijo Abajo Siempre */}
  <div id="sidebar-user-card" class="p-3 border-t border-surface-container bg-surface-container-lowest shrink-0 mt-auto">
    <div class="bg-surface-container-low/90 p-2.5 rounded-xl flex items-center justify-between gap-2.5 border border-surface-container hover:border-outline/30 transition-all">
      <div class="flex items-center gap-2.5 min-w-0 flex-1">
        {/* Avatar con iniciales */}
        <div
          id="user-avatar"
          class="w-10 h-10 rounded-xl bg-primary text-on-primary font-bold text-[13px] flex items-center justify-center shrink-0 shadow-2xs tracking-wider"
        >
          OP
        </div>

        {/* Datos legibles del usuario */}
        <div class="flex flex-col min-w-0 flex-1">
          <span
            id="user-display-name"
            class="font-label-md text-[13px] text-on-surface font-bold truncate leading-tight capitalize"
            title="Nombre del Colaborador"
          >
            Colaborador
          </span>
          <div class="flex items-center gap-1 mt-0.5 text-[11px] text-on-surface-variant">
            <span
              id="user-display-username"
              class="text-secondary font-semibold truncate"
            >
              @usuario
            </span>
            <span class="text-outline/40">•</span>
            <span
              id="user-role-badge"
              class="font-medium truncate"
            >
              Operaciones
            </span>
          </div>
        </div>
      </div>

      {/* Botón Cerrar Sesión */}
      <button
        id="logout-btn"
        type="button"
        data-action="logout"
        class="text-on-surface-variant hover:text-error hover:bg-error-container/30 p-2 rounded-lg transition-colors shrink-0 cursor-pointer"
        title="Cerrar sesión corporativa"
      >
        <span class="material-symbols-outlined text-[19px]">logout</span>
      </button>
    </div>
  </div>
</aside>
