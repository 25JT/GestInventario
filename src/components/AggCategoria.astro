---
// AggCategoria.astro - Módulo / Modal de Gestión de Categorías de Inventario
---

<div
  id="categoryModal"
  class="fixed inset-0 z-50 bg-black/50 backdrop-blur-xs overflow-y-auto hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-category-title"
>
  <div class="min-h-screen p-3 sm:p-6 lg:p-8 flex items-start justify-center">
    <div
      id="categoryModalContainer"
      class="bg-surface rounded-2xl border border-surface-container/70 shadow-2xl w-full max-w-7xl my-auto p-4 sm:p-6 lg:p-8 flex flex-col gap-6"
    >
      <!-- Cabecera de Módulo y Navegación -->
      <div class="flex flex-col gap-2">
        <!-- Migas de pan y botón de cierre -->
        <div class="flex items-center justify-between">
          <nav
            class="flex items-center gap-1.5 text-on-surface-variant text-[12px] font-medium"
          >
            <button
              type="button"
              onclick="window.closeCategoryModal()"
              class="hover:text-primary transition-colors flex items-center gap-1 cursor-pointer"
            >
              <span class="material-symbols-outlined text-[15px]"
                >inventory_2</span
              >
              <span>Control de Inventario</span>
            </button>

            <span
              class="material-symbols-outlined text-[13px] text-outline-variant"
              >chevron_right</span
            >
            <span class="text-primary font-semibold">Gestión de Categorías</span
            >
          </nav>

          <button
            type="button"
            onclick="window.closeCategoryModal()"
            class="w-8 h-8 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-on-surface flex items-center justify-center transition-colors cursor-pointer"
            title="Cerrar ventana"
          >
            <span class="material-symbols-outlined text-[18px]">close</span>
          </button>
        </div>

        <!-- Barra de Título y Acciones -->
        <div
          class="flex flex-col md:flex-row md:items-center justify-between gap-4 mt-1"
        >
          <div class="flex flex-col max-w-2xl">
            <h1
              id="modal-category-title"
              class="text-[22px] sm:text-[26px] font-bold text-primary tracking-tight"
            >
              Gestión de Categorías de Inventario
            </h1>
            <p
              class="text-[13px] sm:text-[14px] text-on-surface-variant mt-0.5"
            >
              Define, organiza y personaliza las familias del catálogo maestro.
              Las categorías activas se reflejarán instantáneamente en el alta
              de productos, transferencias y filtros de punto de venta.
            </p>
          </div>
          <div class="flex items-center gap-2 shrink-0 flex-wrap">
            <button
              onclick="window.closeCategoryModal()"
              class="h-[34px] px-3.5 bg-surface-container-lowest text-on-surface text-[13px] font-medium rounded-xl hover:bg-surface-container border border-surface-container/60 shadow-xs flex items-center gap-1.5 transition-colors cursor-pointer"
              type="button"
            >
              <span class="material-symbols-outlined text-[17px]"
                >arrow_back</span
              >
              <span>Volver a Inventario</span>
            </button>
            <button
              onclick="window.showCategoryToast('Exportando taxonomía de categorías a CSV...', 'info')"
              class="h-[34px] px-3.5 bg-surface-container-lowest text-on-surface text-[13px] font-medium rounded-xl hover:bg-surface-container border border-surface-container/60 shadow-xs flex items-center gap-1.5 transition-colors cursor-pointer"
              title="Exportar taxonomía"
              type="button"
            >
              <span class="material-symbols-outlined text-[17px]"
                >file_download</span
              >
              <span>Exportar</span>
            </button>
            <button
              onclick="window.focusCategoryForm()"
              class="h-[34px] px-3.5 bg-secondary-container hover:bg-secondary text-on-secondary text-[13px] font-semibold rounded-xl shadow-xs flex items-center gap-1.5 transition-all cursor-pointer active:scale-95"
              type="button"
            >
              <span class="material-symbols-outlined text-[18px]"
                >add_circle</span
              >
              <span>Nueva Categoría</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Métricas Rápidas / KPIs Operativos -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Card 1 -->
        <div
          class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 border border-surface-container/60 shadow-xs flex flex-col justify-between"
        >
          <div class="flex items-center justify-between">
            <span
              class="text-[11px] text-on-surface-variant uppercase tracking-wider font-semibold"
              >Categorías Activas</span
            >
            <span
              class="px-2 py-0.5 rounded-lg bg-surface-container-low text-on-tertiary-container text-[11px] font-semibold flex items-center gap-1"
            >
              <span
                class="w-1.5 h-1.5 rounded-full bg-on-tertiary-container animate-pulse"
              ></span>
              Sincronizado
            </span>
          </div>
          <div class="my-2 flex items-baseline gap-2">
            <span
              id="cat-count-active"
              class="text-[28px] text-primary font-bold tracking-tight">8</span
            >
            <span class="text-[12px] text-on-surface-variant"
              >familias maestras</span
            >
          </div>
          <div
            class="text-[12px] text-on-surface-variant flex items-center gap-1"
          >
            <span class="material-symbols-outlined text-[15px] text-secondary"
              >sync_alt</span
            >
            <span>Disponibles en módulo POS y Compras</span>
          </div>
        </div>

        <!-- Card 2 -->
        <div
          class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 border border-surface-container/60 shadow-xs flex flex-col justify-between"
        >
          <div class="flex items-center justify-between">
            <span
              class="text-[11px] text-on-surface-variant uppercase tracking-wider font-semibold"
              >Artículos Vinculados</span
            >
            <div
              class="w-7 h-7 rounded-lg bg-surface-container-low flex items-center justify-center text-secondary"
            >
              <span class="material-symbols-outlined text-[17px]">category</span
              >
            </div>
          </div>
          <div class="my-2 flex items-baseline gap-2">
            <span id="cat-total-prods" class="text-[28px] text-primary font-bold tracking-tight"
              >0</span
            >
            <span class="text-[12px] text-on-tertiary-container font-semibold"
              >100% clasificado</span
            >
          </div>
          <div class="text-[12px] text-on-surface-variant">
            <span>Sin ítems huérfanos en catálogo actual</span>
          </div>
        </div>

        <!-- Card 3 -->
        <div
          class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 border border-surface-container/60 shadow-xs flex flex-col justify-between"
        >
          <div class="flex items-center justify-between">
            <span
              class="text-[11px] text-on-surface-variant uppercase tracking-wider font-semibold"
              >Líder en Valorización</span
            >
            <span
              class="px-2 py-0.5 rounded-lg bg-surface-container text-on-surface text-[11px] font-semibold"
              >Top #1</span
            >
          </div>
          <div class="my-2 flex flex-col">
            <span id="cat-leader-name" class="text-[16px] text-primary font-bold truncate"
              >Ninguna</span
            >
            <div
              class="flex items-center gap-1.5 mt-0.5 text-on-surface-variant text-[11px]"
            >
              <span id="cat-leader-units">0 unidades</span>
              <span>•</span>
              <span id="cat-leader-val" class="font-semibold text-primary font-mono"
                >$ 0 COP</span
              >
            </div>
          </div>
          <div
            class="w-full bg-surface-container h-1.5 rounded-full overflow-hidden mt-1"
          >
            <div id="cat-leader-bar" class="bg-secondary h-full rounded-full" style="width: 0%">
            </div>
          </div>
        </div>

        <!-- Card 4 -->
        <div
          class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 border border-surface-container/60 shadow-xs flex flex-col justify-between"
        >
          <div class="flex items-center justify-between">
            <span
              class="text-[11px] text-on-surface-variant uppercase tracking-wider font-semibold"
              >Disponibles / Vacías</span
            >
            <span
              class="px-2 py-0.5 rounded-lg bg-surface-container-low text-secondary text-[11px] font-semibold"
              >Preparadas</span
            >
          </div>
          <div class="my-2 flex items-baseline gap-2">
            <span id="cat-empty-count" class="text-[28px] text-primary font-bold tracking-tight"
              >0</span
            >
            <span class="text-[12px] text-on-surface-variant"
              >categorías sin productos</span
            >
          </div>
          <div
            class="text-[12px] text-on-surface-variant flex items-center gap-1"
          >
            <span
              class="material-symbols-outlined text-[15px] text-on-tertiary-container"
              >check_circle</span
            >
            <span>Apta para carga masiva y SKU</span>
          </div>
        </div>
      </div>

      <!-- Layout Principal de 2 Columnas -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- COLUMNA IZQUIERDA: Formulario de Creación / Edición Dinámica -->
        <div
          class="lg:col-span-4 bg-surface-container-lowest rounded-2xl border border-surface-container/60 shadow-xs p-5 sm:p-6 flex flex-col gap-4"
        >
          <div
            class="flex items-center justify-between pb-2 border-b border-surface-container/60"
          >
            <div class="flex items-center gap-2.5">
              <div
                class="w-9 h-9 rounded-xl bg-secondary-container text-on-secondary flex items-center justify-center shadow-xs"
                id="form-icon-preview"
              >
                <span
                  class="material-symbols-outlined text-[20px]"
                  id="preview-icon-symbol">bolt</span
                >
              </div>
              <div>
                <h2
                  class="text-[16px] text-primary font-bold"
                  id="form-heading"
                >
                  Nueva Categoría
                </h2>
                <p class="text-[11px] text-on-surface-variant">
                  Configura prefijo, visuales y reglas
                </p>
              </div>
            </div>
            <button
              class="text-on-surface-variant hover:text-primary p-1.5 rounded-lg hover:bg-surface-container transition-colors cursor-pointer"
              onclick="window.resetCategoryForm()"
              title="Restablecer formulario"
              type="button"
            >
              <span class="material-symbols-outlined text-[18px]"
                >restart_alt</span
              >
            </button>
          </div>

          <form
            class="flex flex-col gap-4"
            id="category-form"
            onsubmit="window.handleCategoryFormSubmit(event)"
          >
            <!-- Campo: Nombre -->
            <div class="flex flex-col gap-1">
              <label
                class="text-[12px] text-primary font-semibold flex items-center justify-between"
                for="cat-name"
              >
                <span
                  >Nombre de Categoría <span class="text-error">*</span></span
                >
                <span class="text-[11px] text-on-surface-variant font-normal"
                  >Obligatorio</span
                >
              </label>
              <input
                class="w-full h-10 px-3 bg-surface rounded-xl text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-surface-container/60 focus:outline-none focus:bg-surface-container-lowest transition-all"
                id="cat-name"
                name="name"
                oninput="window.autoGeneratePrefix(this.value)"
                placeholder="Ej. Electrodomésticos Menores"
                required
                type="text"
              />
            </div>

            <!-- Campo: Código / Prefijo SKU sugerido -->
            <div class="flex flex-col gap-1">
              <div class="flex items-center justify-between">
                <label
                  class="text-[12px] text-primary font-semibold"
                  for="cat-prefix">Prefijo SKU Sugerido</label
                >
                <span class="text-[11px] text-secondary font-medium"
                  >Autogenerado</span
                >
              </div>
              <div class="relative flex items-center">
                <input
                  class="w-full h-10 pl-3 pr-16 uppercase bg-surface rounded-xl font-mono text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-surface-container/60 focus:outline-none focus:bg-surface-container-lowest tracking-wider font-semibold"
                  id="cat-prefix"
                  maxlength="5"
                  name="prefix"
                  placeholder="ELEC"
                  type="text"
                />
                <div
                  class="absolute right-2 px-2 py-0.5 rounded bg-surface-container text-on-surface-variant text-[11px] font-mono font-semibold"
                >
                  -XXXX
                </div>
              </div>
              <span class="text-[11px] text-on-surface-variant"
                >Se antepondrá como formato estándar para nuevos artículos
                vinculados.</span
              >
            </div>

            <!-- Selector de Color e Icono -->
            <div class="flex flex-col gap-2">
              <label class="text-[12px] text-primary font-semibold"
                >Color de Etiqueta &amp; Identificador</label
              >
              <!-- Paleta de colores de diseño -->
              <div class="grid grid-cols-6 gap-2" id="color-palette-group">
                <button
                  class="color-badge-opt h-8 rounded-xl bg-secondary-container flex items-center justify-center transition-all active:scale-95 shadow-xs ring-2 ring-primary cursor-pointer"
                  data-color="blue"
                  onclick="window.selectColorBadge('blue', '#316bf3', this)"
                  type="button"
                >
                  <span class="material-symbols-outlined text-white text-[16px]"
                    >check</span
                  >
                </button>
                <button
                  class="color-badge-opt h-8 rounded-xl bg-on-tertiary-container flex items-center justify-center transition-all active:scale-95 shadow-xs cursor-pointer"
                  data-color="emerald"
                  onclick="window.selectColorBadge('emerald', '#00a472', this)"
                  type="button"
                >
                  <span
                    class="material-symbols-outlined text-white text-[16px] hidden"
                    >check</span
                  >
                </button>
                <button
                  class="color-badge-opt h-8 rounded-xl bg-secondary flex items-center justify-center transition-all active:scale-95 shadow-xs cursor-pointer"
                  data-color="indigo"
                  onclick="window.selectColorBadge('indigo', '#0051d5', this)"
                  type="button"
                >
                  <span
                    class="material-symbols-outlined text-white text-[16px] hidden"
                    >check</span
                  >
                </button>
                <button
                  class="color-badge-opt h-8 rounded-xl bg-amber-600 flex items-center justify-center transition-all active:scale-95 shadow-xs cursor-pointer"
                  data-color="amber"
                  onclick="window.selectColorBadge('amber', '#d97706', this)"
                  type="button"
                >
                  <span
                    class="material-symbols-outlined text-white text-[16px] hidden"
                    >check</span
                  >
                </button>
                <button
                  class="color-badge-opt h-8 rounded-xl bg-primary flex items-center justify-center transition-all active:scale-95 shadow-xs cursor-pointer"
                  data-color="dark"
                  onclick="window.selectColorBadge('dark', '#091426', this)"
                  type="button"
                >
                  <span
                    class="material-symbols-outlined text-white text-[16px] hidden"
                    >check</span
                  >
                </button>
                <button
                  class="color-badge-opt h-8 rounded-xl bg-error flex items-center justify-center transition-all active:scale-95 shadow-xs cursor-pointer"
                  data-color="rose"
                  onclick="window.selectColorBadge('rose', '#ba1a1a', this)"
                  type="button"
                >
                  <span
                    class="material-symbols-outlined text-white text-[16px] hidden"
                    >check</span
                  >
                </button>
              </div>

              <!-- Selector de Icono Rápido -->
              <div
                class="mt-1 flex items-center justify-between gap-1 overflow-x-auto py-1"
                id="icon-palette-group"
              >
                <button
                  class="icon-opt p-1.5 rounded-lg bg-surface-container text-primary hover:bg-surface-container-high transition-colors cursor-pointer"
                  data-icon="bolt"
                  onclick="window.selectIconSymbol('bolt', this)"
                  title="Eléctrico"
                  type="button"
                >
                  <span class="material-symbols-outlined text-[18px]">bolt</span
                  >
                </button>
                <button
                  class="icon-opt p-1.5 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-colors cursor-pointer"
                  data-icon="devices"
                  onclick="window.selectIconSymbol('devices', this)"
                  title="Dispositivos"
                  type="button"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >devices</span
                  >
                </button>
                <button
                  class="icon-opt p-1.5 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-colors cursor-pointer"
                  data-icon="handyman"
                  onclick="window.selectIconSymbol('handyman', this)"
                  title="Herramientas"
                  type="button"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >handyman</span
                  >
                </button>
                <button
                  class="icon-opt p-1.5 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-colors cursor-pointer"
                  data-icon="science"
                  onclick="window.selectIconSymbol('science', this)"
                  title="Químicos"
                  type="button"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >science</span
                  >
                </button>
                <button
                  class="icon-opt p-1.5 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-colors cursor-pointer"
                  data-icon="settings"
                  onclick="window.selectIconSymbol('settings', this)"
                  title="Repuestos"
                  type="button"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >settings</span
                  >
                </button>
                <button
                  class="icon-opt p-1.5 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-colors cursor-pointer"
                  data-icon="kitchen"
                  onclick="window.selectIconSymbol('kitchen', this)"
                  title="Electrodomésticos"
                  type="button"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >kitchen</span
                  >
                </button>
                <button
                  class="icon-opt p-1.5 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary transition-colors cursor-pointer"
                  data-icon="print"
                  onclick="window.selectIconSymbol('print', this)"
                  title="Periféricos"
                  type="button"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >print</span
                  >
                </button>
              </div>
            </div>

            <!-- Campo: Descripción / Notas -->
            <div class="flex flex-col gap-1">
              <label
                class="text-[12px] text-primary font-semibold"
                for="cat-desc">Descripción y Criterios Operativos</label
              >
              <textarea
                class="w-full p-2.5 bg-surface rounded-xl text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-surface-container/60 focus:outline-none focus:bg-surface-container-lowest resize-none transition-all"
                id="cat-desc"
                name="description"
                placeholder="Aparatos para cocina, limpieza y climatización del hogar..."
                rows="2"></textarea>
            </div>

            <!-- Select: Estado de la Categoría -->
            <div class="flex flex-col gap-1">
              <label
                class="text-[12px] text-primary font-semibold"
                for="cat-status">Visibilidad en Catálogo</label
              >
              <select
                class="w-full h-10 px-3 bg-surface rounded-xl text-[13px] text-on-surface border border-surface-container/60 focus:outline-none focus:bg-surface-container-lowest transition-all cursor-pointer"
                id="cat-status"
                name="status"
              >
                <option selected value="active"
                  >Activa (Visible en formularios de nuevo producto)</option
                >
                <option value="inactive"
                  >Inactiva / Oculta (No seleccionable temporalmente)</option
                >
              </select>
            </div>

            <!-- Conmutador: Trazabilidad / Número de serie -->
            <div
              class="p-3 bg-surface-container-low rounded-xl flex items-start justify-between gap-3 border border-surface-container/40"
            >
              <div class="flex flex-col">
                <span
                  class="text-[12px] text-on-surface font-semibold flex items-center gap-1"
                >
                  <span>Trazabilidad por Serial (S/N)</span>
                  <span
                    class="material-symbols-outlined text-[15px] text-secondary"
                    >verified_user</span
                  >
                </span>
                <span class="text-[11px] text-on-surface-variant"
                  >Obliga a registrar número de serie en cada recepción de
                  compra.</span
                >
              </div>
              <label
                class="relative inline-flex items-center cursor-pointer mt-0.5 shrink-0"
              >
                <input
                  checked
                  class="sr-only peer"
                  id="cat-trace"
                  type="checkbox"
                />
                <div
                  class="w-9 h-5 bg-surface-container peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-secondary-container"
                >
                </div>
              </label>
            </div>

            <!-- Botones de Acción -->
            <div class="flex items-center gap-2 pt-2">
              <button
                class="flex-1 h-10 bg-primary hover:bg-primary-container text-on-primary text-[13px] font-semibold rounded-xl flex items-center justify-center gap-1.5 shadow-xs transition-all cursor-pointer active:scale-95"
                type="submit"
              >
                <span class="material-symbols-outlined text-[18px]">save</span>
                <span id="submit-btn-text">Guardar Categoría</span>
              </button>
              <button
                class="h-10 px-4 bg-surface text-on-surface-variant hover:text-on-surface hover:bg-surface-container text-[13px] font-medium rounded-xl border border-surface-container/60 transition-colors cursor-pointer"
                onclick="window.resetCategoryForm()"
                type="button"
              >
                Limpiar
              </button>
            </div>
          </form>
        </div>

        <!-- COLUMNA DERECHA: Matriz de Categorías & Búsqueda -->
        <div class="lg:col-span-8 flex flex-col gap-4">
          <!-- Barra de Filtros, Búsqueda y Herramientas -->
          <div
            class="bg-surface-container-lowest rounded-2xl p-4 border border-surface-container/60 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3"
          >
            <!-- Input de Búsqueda Dinámica -->
            <div class="relative w-full sm:w-80">
              <span
                class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]"
                >search</span
              >
              <input
                class="w-full h-9 pl-9 pr-8 bg-surface rounded-xl text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-surface-container/60 focus:outline-none focus:bg-surface-container-lowest transition-all"
                id="search-category-input"
                onkeyup="window.filterCategoryTable()"
                placeholder="Buscar por nombre, prefijo o regla..."
                type="text"
              />
              <button
                class="absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface text-[14px] cursor-pointer"
                onclick="window.clearCategorySearch()"
                type="button"
                title="Limpiar búsqueda"
              >
                <span class="material-symbols-outlined text-[16px]">close</span>
              </button>
            </div>

            <!-- Filtros Rápidos de Estado -->
            <div
              class="flex items-center gap-1.5 self-stretch sm:self-auto overflow-x-auto"
            >
              <button
                id="tab-cat-all"
                class="status-filter-tab px-3 py-1.5 rounded-lg text-[12px] font-semibold bg-primary text-on-primary shadow-xs transition-all cursor-pointer"
                onclick="window.filterCategoriesByStatus('all', this)"
                type="button"
              >
                Todas (0)
              </button>
              <button
                id="tab-cat-active"
                class="status-filter-tab px-3 py-1.5 rounded-lg text-[12px] font-semibold text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all cursor-pointer"
                onclick="window.filterCategoriesByStatus('active', this)"
                type="button"
              >
                Activas (0)
              </button>
              <button
                id="tab-cat-inactive"
                class="status-filter-tab px-3 py-1.5 rounded-lg text-[12px] font-semibold text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all cursor-pointer"
                onclick="window.filterCategoriesByStatus('inactive', this)"
                type="button"
              >
                Inactivas (0)
              </button>
              <div class="w-px h-5 bg-surface-container mx-1 hidden sm:block">
              </div>
              <button
                class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors cursor-pointer"
                onclick="window.showCategoryToast('Ordenamiento por nombre alfabético aplicado.', 'info')"
                title="Ordenar columnas"
                type="button"
              >
                <span class="material-symbols-outlined text-[18px]"
                  >sort_by_alpha</span
                >
              </button>
            </div>
          </div>

          <!-- Tabla de Datos Maestro -->
          <div
            class="bg-surface-container-lowest rounded-2xl border border-surface-container/60 shadow-xs overflow-hidden flex flex-col"
          >
            <div class="overflow-x-auto">
              <table
                class="w-full text-left border-collapse text-[13px] min-w-[700px]"
              >
                <thead>
                  <tr
                    class="bg-surface-container-low h-10 text-on-surface-variant text-[11px] uppercase tracking-wider font-semibold border-b border-surface-container/60"
                  >
                    <th class="px-4 py-2 w-12 text-center">Ident.</th>
                    <th class="px-4 py-2">Categoría &amp; Prefijo</th>
                    <th class="px-4 py-2">Descripción</th>
                    <th class="px-4 py-2 text-right">Productos</th>
                    <th class="px-4 py-2 text-right">Valorización</th>
                    <th class="px-4 py-2 text-center">Estado</th>
                    <th class="px-4 py-2 text-right w-24">Acciones</th>
                  </tr>
                </thead>
                <tbody
                  class="divide-y divide-surface-container/40"
                  id="categories-table-body"
                >
                  <tr>
                    <td colspan="7" class="px-4 py-8 text-center text-on-surface-variant">
                      Cargando categorías de la base de datos...
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Pie de Tabla con Paginación Compacta -->
            <div
              class="bg-surface-container-lowest px-4 py-3 flex items-center justify-between text-on-surface-variant text-[12px] border-t border-surface-container/60"
            >
              <span id="cat-table-summary"
                >Mostrando 8 de 8 categorías registradas</span
              >
              <div class="flex items-center gap-1.5">
                <button
                  class="p-1 text-on-surface-variant/40 rounded cursor-not-allowed"
                  disabled
                  type="button"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >chevron_left</span
                  >
                </button>
                <span
                  class="px-2.5 py-0.5 bg-surface-container rounded-lg font-semibold text-on-surface text-[11px]"
                  >Página 1</span
                >
                <button
                  class="p-1 text-on-surface-variant/40 rounded cursor-not-allowed"
                  disabled
                  type="button"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >chevron_right</span
                  >
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Banner Informativo / Gobernanza de Catálogo -->
      <div
        class="bg-surface-container-low rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border border-surface-container/60 shadow-2xs"
      >
        <div class="flex items-start sm:items-center gap-3">
          <div
            class="w-9 h-9 rounded-xl bg-secondary-container/15 text-secondary flex items-center justify-center shrink-0"
          >
            <span class="material-symbols-outlined text-[20px]">lightbulb</span>
          </div>
          <div class="flex flex-col">
            <span class="text-[13px] text-primary font-semibold"
              >Integración Inmediata en todo el ERP</span
            >
            <span class="text-[12px] text-on-surface-variant">
              Las categorías creadas aquí estarán inmediatamente disponibles en
              el selector de <strong>"Agregar Producto"</strong>, plantillas de <strong
                >"Carga Masiva"</strong
              > y en la botonera táctil del <strong>Punto de Venta (POS)</strong
              >.
            </span>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button
            class="text-[12px] text-secondary hover:underline font-semibold flex items-center gap-1 cursor-pointer"
            type="button"
            onclick="window.showCategoryToast('Abriendo guía de taxonomía y mejores prácticas SKU...', 'info')"
          >
            <span>Guía de Taxonomía</span>
            <span class="material-symbols-outlined text-[15px]"
              >open_in_new</span
            >
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast Notificador Ligero -->
  <div
    class="fixed bottom-6 right-6 hidden bg-primary text-on-primary px-4 py-3 rounded-xl shadow-xl flex items-center gap-2.5 z-50 transition-all pointer-events-none"
    id="toast-category"
  >
    <span
      class="material-symbols-outlined text-[20px] text-secondary-fixed"
      id="toast-category-icon">check_circle</span
    >
    <span class="text-[13px] font-medium" id="toast-category-message"
      >Categoría actualizada con éxito</span
    >
  </div>
</div>

<script>
  import gsap from "gsap";

  let currentColor = "blue";
  let currentIcon = "bolt";
  let editingCategoryId: string | null = null;
  let toastTimer: any = null;

  const API_CATEGORIAS = "http://localhost:3000/api/categorias";

  function getColorClasses(colorName: string): string {
    switch (colorName) {
      case "emerald":
        return "bg-on-tertiary-container text-white";
      case "indigo":
        return "bg-secondary text-on-secondary";
      case "amber":
        return "bg-amber-600 text-white";
      case "dark":
        return "bg-primary text-on-primary";
      case "rose":
        return "bg-error text-white";
      case "blue":
      default:
        return "bg-secondary-container text-on-secondary";
    }
  }

  function escapeAttr(str?: string): string {
    if (!str) return "";
    return str.replace(/'/g, "\\'").replace(/"/g, "&quot;");
  }

  // Cargar categorías reales desde la API del backend
  async function loadBackendCategories() {
    try {
      const res = await fetch(API_CATEGORIAS);
      if (!res.ok) return;
      const json = await res.json();
      if (json.success && json.data) {
        const { categorias, metricas } = json.data;
        // Métricas superiores
        const activeCount = document.getElementById("cat-count-active");
        if (activeCount) activeCount.textContent = String(metricas?.total_activas || categorias.length || 0);

        const totalProds = document.getElementById("cat-total-prods");
        if (totalProds) totalProds.textContent = String(metricas?.total_articulos ?? 0);

        const leaderName = document.getElementById("cat-leader-name");
        if (leaderName) leaderName.textContent = metricas?.lider?.nombre || "Ninguna";

        const leaderUnits = document.getElementById("cat-leader-units");
        if (leaderUnits) leaderUnits.textContent = `${metricas?.lider?.unidades || 0} unidades`;

        const leaderVal = document.getElementById("cat-leader-val");
        if (leaderVal) leaderVal.textContent = `${metricas?.lider?.valor_formato || "$ 0"} COP`;

        const leaderBar = document.getElementById("cat-leader-bar");
        if (leaderBar) {
          const totalVal = categorias.reduce((sum: number, x: any) => sum + (x.valor_inventario || 0), 0);
          const pct = totalVal > 0 ? Math.min(100, Math.round(((metricas?.lider?.valor || 0) / totalVal) * 100)) : 0;
          leaderBar.style.width = `${pct}%`;
        }

        const emptyCount = document.getElementById("cat-empty-count");
        if (emptyCount) emptyCount.textContent = String(metricas?.vacias ?? 0);

        // Actualizar pestañas de conteo
        const tabAll = document.getElementById("tab-cat-all");
        if (tabAll) tabAll.textContent = `Todas (${categorias.length})`;

        const activeCats = categorias.filter((c: any) => c.estado !== "Inactiva");
        const inactiveCats = categorias.filter((c: any) => c.estado === "Inactiva");

        const tabActive = document.getElementById("tab-cat-active");
        if (tabActive) tabActive.textContent = `Activas (${activeCats.length})`;

        const tabInactive = document.getElementById("tab-cat-inactive");
        if (tabInactive) tabInactive.textContent = `Inactivas (${inactiveCats.length})`;

        const tableSummary = document.getElementById("cat-table-summary");
        if (tableSummary) tableSummary.textContent = `Mostrando ${categorias.length} de ${categorias.length} categorías registradas`;

        // Tabla de categorías
        const tbody = document.getElementById("categories-table-body");
        if (tbody && Array.isArray(categorias)) {
          if (categorias.length === 0) {
            tbody.innerHTML = `
              <tr>
                <td colspan="7" class="px-4 py-8 text-center text-on-surface-variant">
                  No hay categorías registradas en la base de datos.
                </td>
              </tr>
            `;
          } else {
            tbody.innerHTML = categorias
              .map((c: any) => `
                <tr class="hover:bg-surface-container-low/50 transition-colors group" data-id="${c.id}" data-status="${c.estado === 'Inactiva' ? 'inactive' : 'active'}">
                  <td class="px-4 py-3 text-center">
                    <div class="w-8 h-8 mx-auto rounded-lg ${getColorClasses(c.color)} flex items-center justify-center shadow-xs">
                      <span class="material-symbols-outlined text-[18px]">${c.icono || "bolt"}</span>
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex flex-col">
                      <span class="font-semibold text-primary group-hover:text-secondary transition-colors">${c.nombre}</span>
                      <span class="font-mono text-[11px] text-on-surface-variant font-semibold tracking-wider">SKU: <span class="text-secondary font-bold">${c.prefijo || "GEN"}</span></span>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-on-surface-variant text-[12px] max-w-xs truncate">${c.descripcion || "Sin descripción"}</td>
                  <td class="px-4 py-3 text-right font-bold text-on-surface">${c.total_productos} SKUs</td>
                  <td class="px-4 py-3 text-right font-mono font-bold text-primary">${c.valor_inventario_formato || "$ 0"}</td>
                  <td class="px-4 py-3 text-center">
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full ${c.estado === 'Inactiva' ? 'bg-surface-container text-on-surface-variant' : 'bg-surface-container-high text-on-tertiary-container'} text-[11px] font-bold">
                      <span class="w-1.5 h-1.5 rounded-full ${c.estado === 'Inactiva' ? 'bg-outline' : 'bg-on-tertiary-container'}"></span>
                      ${c.estado || "Activa"}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <div class="flex items-center justify-end gap-1">
                      <button
                        class="p-1 rounded-lg text-on-surface-variant hover:text-secondary hover:bg-surface-container transition-colors cursor-pointer"
                        title="Editar categoría"
                        type="button"
                        onclick="window.editCategory('${c.id}', '${escapeAttr(c.nombre)}', '${escapeAttr(c.prefijo)}', '${escapeAttr(c.descripcion)}', '${c.icono || 'bolt'}', '${c.color || 'blue'}', '${c.estado || 'Activa'}')"
                      >
                        <span class="material-symbols-outlined text-[17px]">edit</span>
                      </button>
                      <button
                        class="p-1 rounded-lg text-on-surface-variant hover:text-error hover:bg-error-container/40 transition-colors cursor-pointer"
                        title="Eliminar categoría"
                        type="button"
                        onclick="window.deleteCategory && window.deleteCategory('${c.id}', '${escapeAttr(c.nombre)}', ${c.total_productos})"
                      >
                        <span class="material-symbols-outlined text-[17px]">delete</span>
                      </button>
                    </div>
                  </td>
                </tr>
              `)
              .join("");
          }
        }
      }
    } catch (e) {
      console.warn("No se pudieron cargar categorías del servidor:", e);
    }
  }

  // Apertura y Cierre con animación GSAP
  (window as any).openCategoryModal = function () {
    const modal = document.getElementById("categoryModal");
    const container = document.getElementById("categoryModalContainer");
    if (!modal || !container) return;

    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    loadBackendCategories();

    gsap.fromTo(
      modal,
      { opacity: 0 },
      { opacity: 1, duration: 0.22, ease: "power2.out" },
    );
    gsap.fromTo(
      container,
      { y: 30, scale: 0.96, opacity: 0 },
      { y: 0, scale: 1, opacity: 1, duration: 0.28, ease: "back.out(1.2)" },
    );
  };

  (window as any).closeCategoryModal = function () {
    const modal = document.getElementById("categoryModal");
    const container = document.getElementById("categoryModalContainer");
    if (!modal || !container) return;

    document.body.style.overflow = "";

    gsap.to(container, {
      y: 20,
      scale: 0.96,
      opacity: 0,
      duration: 0.18,
      ease: "power2.in",
    });

    gsap.to(modal, {
      opacity: 0,
      duration: 0.2,
      ease: "power2.in",
      onComplete: () => {
        modal.classList.add("hidden");
      },
    });
  };

  // Selector de Color
  (window as any).selectColorBadge = function (
    colorName: string,
    hex?: string,
    btnElement?: HTMLElement,
  ) {
    currentColor = colorName || "blue";
    const buttons = document.querySelectorAll(".color-badge-opt");
    buttons.forEach((btn) => {
      const icon = btn.querySelector(".material-symbols-outlined");
      if (icon) icon.classList.add("hidden");
      btn.classList.remove("ring-2", "ring-primary");
    });

    let trigger = btnElement;
    if (!trigger && typeof event !== "undefined" && (event as any)?.currentTarget) {
      trigger = (event as any).currentTarget as HTMLElement;
    }
    if (!trigger) {
      const matching = document.querySelector(`.color-badge-opt[data-color="${colorName}"]`) as HTMLElement | null;
      if (matching) trigger = matching;
    }

    if (trigger) {
      trigger.classList.add("ring-2", "ring-primary");
      const activeIcon = trigger.querySelector(".material-symbols-outlined");
      if (activeIcon) activeIcon.classList.remove("hidden");
    }

    // Actualizar preview en cabecera de formulario
    const previewBox = document.getElementById("form-icon-preview");
    if (previewBox) {
      previewBox.className = `w-9 h-9 rounded-xl ${getColorClasses(currentColor)} flex items-center justify-center shadow-xs`;
    }
  };

  // Selector de Ícono
  (window as any).selectIconSymbol = function (
    iconName: string,
    btnElement?: HTMLElement,
  ) {
    currentIcon = iconName || "bolt";
    const buttons = document.querySelectorAll(".icon-opt");
    buttons.forEach((btn) => {
      btn.classList.remove("bg-surface-container", "text-primary");
      btn.classList.add("text-on-surface-variant");
    });

    let trigger = btnElement;
    if (!trigger && typeof event !== "undefined" && (event as any)?.currentTarget) {
      trigger = (event as any).currentTarget as HTMLElement;
    }
    if (!trigger) {
      const matching = document.querySelector(`.icon-opt[data-icon="${iconName}"]`) as HTMLElement | null;
      if (matching) trigger = matching;
    }

    if (trigger) {
      trigger.classList.add("bg-surface-container", "text-primary");
      trigger.classList.remove("text-on-surface-variant");
    }

    const preview = document.getElementById("preview-icon-symbol");
    if (preview) preview.textContent = currentIcon;
  };

  // Generador de Prefijo
  (window as any).autoGeneratePrefix = function (val: string) {
    if (editingCategoryId) return;
    const prefixInput = document.getElementById(
      "cat-prefix",
    ) as HTMLInputElement | null;
    if (!prefixInput) return;

    if (!val || val.trim().length === 0) {
      prefixInput.value = "";
      return;
    }

    const words = val.trim().split(/\s+/);
    if (words.length >= 2) {
      prefixInput.value = (
        words[0].substring(0, 2) + words[1].substring(0, 2)
      ).toUpperCase();
    } else {
      prefixInput.value = val.substring(0, 3).toUpperCase();
    }
  };

  (window as any).focusCategoryForm = function () {
    (window as any).resetCategoryForm();
    const input = document.getElementById(
      "cat-name",
    ) as HTMLInputElement | null;
    if (input) {
      input.focus();
      input.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  };

  (window as any).resetCategoryForm = function () {
    editingCategoryId = null;
    const form = document.getElementById(
      "category-form",
    ) as HTMLFormElement | null;
    if (form) form.reset();

    const heading = document.getElementById("form-heading");
    const btnText = document.getElementById("submit-btn-text");
    const preview = document.getElementById("preview-icon-symbol");

    if (heading) heading.textContent = "Nueva Categoría";
    if (btnText) btnText.textContent = "Guardar Categoría";
    if (preview) preview.textContent = "bolt";

    (window as any).selectColorBadge("blue");
    (window as any).selectIconSymbol("bolt");
  };

  (window as any).editCategory = function (
    id: string,
    name: string,
    prefix: string,
    desc: string,
    icon: string,
    color: string,
    status: string,
  ) {
    editingCategoryId = id;
    const nameEl = document.getElementById("cat-name") as HTMLInputElement | null;
    const prefixEl = document.getElementById("cat-prefix") as HTMLInputElement | null;
    const descEl = document.getElementById("cat-desc") as HTMLTextAreaElement | null;
    const statusEl = document.getElementById("cat-status") as HTMLSelectElement | null;

    if (nameEl) nameEl.value = name;
    if (prefixEl) prefixEl.value = prefix;
    if (descEl) descEl.value = desc;
    if (statusEl) statusEl.value = (status === "Inactiva" || status === "inactive") ? "inactive" : "active";

    const heading = document.getElementById("form-heading");
    const btnText = document.getElementById("submit-btn-text");
    if (heading) heading.textContent = "Editar: " + name;
    if (btnText) btnText.textContent = "Actualizar Cambios";

    (window as any).selectColorBadge(color || "blue");
    (window as any).selectIconSymbol(icon || "bolt");

    if (nameEl) {
      nameEl.focus();
      nameEl.scrollIntoView({ behavior: "smooth", block: "start" });
    }
    (window as any).showCategoryToast(
      'Modo edición activado para "' + name + '"',
      "info",
    );
  };

  (window as any).deleteCategory = async function (
    id: string,
    name: string,
    productCount: number,
  ) {
    if (productCount > 0) {
      alert(
        `⚠️ Acción Bloqueada:\nLa categoría "${name}" posee ${productCount} productos asociados en el inventario activo. Para eliminarla, reubica previamente los productos a otra familia.`,
      );
      return;
    }

    if (
      confirm(
        `¿Estás seguro de eliminar la categoría "${name}"? Esta acción no se puede deshacer.`,
      )
    ) {
      try {
        const res = await fetch(`${API_CATEGORIAS}/${id}`, {
          method: "DELETE",
        });
        const json = await res.json();
        if (json.success) {
          (window as any).showCategoryToast(
            `Categoría "${name}" eliminada correctamente.`,
          );
          loadBackendCategories();
          window.dispatchEvent(new CustomEvent("categoriaActualizada"));
        } else {
          alert(json.error || "No se pudo eliminar la categoría.");
        }
      } catch (err) {
        console.error("Error al eliminar categoría:", err);
        alert("Error al conectar con el servidor.");
      }
    }
  };

  (window as any).handleCategoryFormSubmit = async function (e: Event) {
    e.preventDefault();
    const nameInput = document.getElementById(
      "cat-name",
    ) as HTMLInputElement | null;
    const prefixInput = document.getElementById(
      "cat-prefix",
    ) as HTMLInputElement | null;
    const descInput = document.getElementById(
      "cat-desc",
    ) as HTMLTextAreaElement | null;
    const statusSelect = document.getElementById(
      "cat-status",
    ) as HTMLSelectElement | null;

    const name = nameInput?.value.trim() || "";
    const prefix = prefixInput?.value.trim() || "";
    const descripcion = descInput?.value.trim() || "";
    const estado = statusSelect?.value === "inactive" ? "Inactiva" : "Activa";

    if (!name) {
      alert("Por favor ingrese el nombre de la categoría.");
      nameInput?.focus();
      return;
    }

    const payload = {
      nombre: name,
      prefijo: prefix,
      descripcion,
      icono: currentIcon || "bolt",
      color: currentColor || "blue",
      estado,
    };

    try {
      if (editingCategoryId) {
        const res = await fetch(`${API_CATEGORIAS}/${editingCategoryId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (json.success) {
          (window as any).showCategoryToast(
            `Categoría "${name}" actualizada con éxito.`,
          );
          (window as any).resetCategoryForm();
          loadBackendCategories();
          window.dispatchEvent(new CustomEvent("categoriaActualizada"));
        } else {
          alert(json.error || "No se pudo actualizar la categoría.");
        }
      } else {
        const res = await fetch(API_CATEGORIAS, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const json = await res.json();
        if (json.success) {
          (window as any).showCategoryToast(
            `Categoría "${name}" agregada al catálogo.`,
          );
          (window as any).resetCategoryForm();
          loadBackendCategories();
          window.dispatchEvent(new CustomEvent("categoriaActualizada"));
        } else {
          alert(json.error || "No se pudo agregar la categoría.");
        }
      }
    } catch (err) {
      console.error("Error al guardar categoría:", err);
      alert("Error al conectar con el servidor.");
    }
  };

  (window as any).filterCategoryTable = function () {
    const searchInput = document.getElementById(
      "search-category-input",
    ) as HTMLInputElement | null;
    const term = (searchInput?.value || "").toLowerCase().trim();
    const rows = document.querySelectorAll("#categories-table-body tr");
    rows.forEach((row) => {
      const text = (row as HTMLElement).innerText.toLowerCase();
      (row as HTMLElement).style.display = text.includes(term) ? "" : "none";
    });
  };

  (window as any).clearCategorySearch = function () {
    const input = document.getElementById(
      "search-category-input",
    ) as HTMLInputElement | null;
    if (input) input.value = "";
    (window as any).filterCategoryTable();
  };

  (window as any).filterCategoriesByStatus = function (
    status: string,
    trigger: HTMLElement,
  ) {
    const tabs = document.querySelectorAll(".status-filter-tab");
    tabs.forEach((t) => {
      t.className =
        "status-filter-tab px-3 py-1.5 rounded-lg text-[12px] font-semibold text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-all cursor-pointer";
    });
    trigger.className =
      "status-filter-tab px-3 py-1.5 rounded-lg text-[12px] font-semibold bg-primary text-on-primary shadow-xs transition-all cursor-pointer";

    const rows = document.querySelectorAll("#categories-table-body tr");
    rows.forEach((row) => {
      const rowStatus = row.getAttribute("data-status");
      if (status === "all" || rowStatus === status) {
        (row as HTMLElement).style.display = "";
      } else {
        (row as HTMLElement).style.display = "none";
      }
    });
  };

  (window as any).showCategoryToast = function (msg: string, type = "success") {
    const toast = document.getElementById("toast-category");
    const toastMsg = document.getElementById("toast-category-message");
    const toastIcon = document.getElementById("toast-category-icon");

    if (!toast || !toastMsg) return;

    toastMsg.textContent = msg;

    if (toastIcon) {
      if (type === "warning") {
        toastIcon.textContent = "warning";
      } else if (type === "info") {
        toastIcon.textContent = "info";
      } else {
        toastIcon.textContent = "check_circle";
      }
    }

    if (toastTimer) clearTimeout(toastTimer);

    toast.classList.remove("hidden");
    gsap.fromTo(
      toast,
      { y: 30, opacity: 0, scale: 0.9 },
      { y: 0, opacity: 1, scale: 1, duration: 0.25, ease: "back.out(1.5)" },
    );

    toastTimer = setTimeout(() => {
      gsap.to(toast, {
        y: 30,
        opacity: 0,
        scale: 0.9,
        duration: 0.2,
        ease: "power2.in",
        onComplete: () => {
          toast.classList.add("hidden");
        },
      });
    }, 3200);
  };

  // Cargar al inicio y suscripción a eventos
  loadBackendCategories();

  window.addEventListener("categoriaActualizada", () => {
    loadBackendCategories();
  });

  document.addEventListener("astro:page-load", () => {
    loadBackendCategories();
  });

  // Cerrar con Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const modal = document.getElementById("categoryModal");
      if (modal && !modal.classList.contains("hidden")) {
        (window as any).closeCategoryModal();
      }
    }
  });

  // Cerrar al click en el backdrop oscuro exterior
  const modalBackdrop = document.getElementById("categoryModal");
  if (modalBackdrop) {
    modalBackdrop.addEventListener("click", (e) => {
      if (e.target === modalBackdrop) {
        (window as any).closeCategoryModal();
      }
    });
  }
</script>
