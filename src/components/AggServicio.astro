---
// AggServicio.astro - Modal Corporativo de Registro de Nuevo Servicio Técnico
---

<!-- OVERLAY / MODAL BACKDROP -->
<div
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-3 sm:p-4 overflow-y-auto hidden"
  id="serviceModalOverlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="service-modal-title"
>
  <!-- MODAL CONTAINER -->
  <div
    class="relative w-full max-w-4xl my-auto bg-surface-container-lowest rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-surface-container/70 max-h-[92vh]"
    id="serviceModalContainer"
  >
    <!-- Modal Header -->
    <div class="px-5 sm:px-6 py-4 bg-surface-container-low flex items-start justify-between gap-4 border-b border-surface-container/60 shrink-0">
      <div class="flex items-start gap-3.5">
        <div class="w-11 h-11 rounded-xl bg-primary text-on-primary flex items-center justify-center shadow-xs shrink-0">
          <span class="material-symbols-outlined text-[24px]">home_repair_service</span>
        </div>
        <div class="flex flex-col gap-0.5">
          <div class="flex items-center gap-2 flex-wrap">
            <h2 id="service-modal-title" class="text-[17px] sm:text-[19px] font-bold text-primary tracking-tight">
              Registrar Nuevo Servicio
            </h2>
            <span class="bg-secondary-fixed text-on-secondary-fixed text-[11px] px-2 py-0.5 rounded-lg flex items-center gap-1 font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
              Módulo de Servicios
            </span>
            <span class="bg-surface-container text-on-surface-variant text-[11px] px-2 py-0.5 rounded-lg font-medium">
              Borrador Automático
            </span>
          </div>
          <p class="text-[12px] sm:text-[13px] text-on-surface-variant mt-0.5">
            Define el código, tarifa, categoría técnica, duración estimada y requerimientos de insumos o repuestos.
          </p>
        </div>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <button
          class="w-8 h-8 rounded-lg bg-surface-container text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface flex items-center justify-center transition-colors cursor-pointer"
          id="closeServiceModalBtn"
          onclick="window.closeServiceModal && window.closeServiceModal()"
          title="Cerrar modal (Esc)"
          type="button"
        >
          <span class="material-symbols-outlined text-[18px]">close</span>
        </button>
      </div>
    </div>

    <!-- Modal Core Scrollable Content -->
    <div class="p-5 sm:p-6 flex flex-col gap-6 overflow-y-auto">

      <!-- SECCIÓN 1: Identificación y Datos Básicos -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-md bg-surface-container-high text-primary flex items-center justify-center text-[11px] font-bold">1</span>
            <h3 class="text-[15px] sm:text-[16px] font-bold text-primary">Identificación y Parámetros Operativos</h3>
          </div>
          <span class="text-[11px] text-on-surface-variant">Campos con (*) son obligatorios</span>
        </div>

        <div class="grid grid-cols-12 gap-3 sm:gap-4">
          <!-- Código SKU -->
          <div class="col-span-12 md:col-span-4 flex flex-col gap-1.5">
            <div class="flex items-center justify-between">
              <label class="text-[12px] text-on-surface font-semibold" for="service-sku">
                Código / SKU Técnico *
              </label>
              <button
                class="text-[11px] text-secondary hover:underline flex items-center gap-0.5 cursor-pointer font-medium"
                id="btn-generate-sku"
                type="button"
              >
                <span class="material-symbols-outlined text-[14px]">autorenew</span>
                Auto-generar
              </button>
            </div>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">qr_code_2</span>
              <input
                class="w-full h-[38px] pl-9 pr-3 bg-surface rounded-xl font-mono text-[13px] font-semibold text-primary placeholder:text-on-surface-variant focus:outline-none focus:bg-surface-container-lowest border border-transparent hover:border-surface-container focus:border-secondary shadow-2xs transition-all"
                id="service-sku"
                type="text"
                value="SRV-MNT-06"
              />
            </div>
            <span class="text-[11px] text-on-surface-variant">Clave unívoca visible en cotizaciones y órdenes de taller.</span>
          </div>

          <!-- Nombre del Servicio -->
          <div class="col-span-12 md:col-span-8 flex flex-col gap-1.5">
            <label class="text-[12px] text-on-surface font-semibold" for="service-name">
              Nombre Comercial del Servicio *
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">engineering</span>
              <input
                class="w-full h-[38px] pl-9 pr-3 bg-surface rounded-xl text-[13px] font-medium text-on-surface placeholder:text-on-surface-variant focus:outline-none focus:bg-surface-container-lowest border border-transparent hover:border-surface-container focus:border-secondary shadow-2xs transition-all"
                id="service-name"
                type="text"
                value="Mantenimiento Correctivo de Servidores y Fuentes Redundantes"
              />
            </div>
            <span class="text-[11px] text-on-surface-variant">Nombre legible para el cliente final y comprobante de venta POS.</span>
          </div>

          <!-- Categoría Técnica -->
          <div class="col-span-12 md:col-span-4 flex flex-col gap-1.5">
            <label class="text-[12px] text-on-surface font-semibold" for="service-category">
              Categoría Técnica *
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">category</span>
              <select
                class="w-full h-[38px] pl-9 pr-8 bg-surface rounded-xl text-[12px] text-on-surface focus:outline-none focus:bg-surface-container-lowest appearance-none border border-transparent hover:border-surface-container focus:border-secondary shadow-2xs transition-all cursor-pointer"
                id="service-category"
              >
                <option selected value="mantenimiento">Mantenimiento y Diagnóstico</option>
                <option value="redes">Instalación y Cableado Estructurado</option>
                <option value="pos">Soporte Hardware POS &amp; Fiscal</option>
                <option value="laboratorio">Laboratorio Electrónico SMD</option>
                <option value="consultoria">Consultoría IT &amp; Arquitectura</option>
              </select>
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] pointer-events-none">expand_more</span>
            </div>
          </div>

          <!-- Área de Aplicación -->
          <div class="col-span-12 md:col-span-4 flex flex-col gap-1.5">
            <label class="text-[12px] text-on-surface font-semibold" for="service-area">
              Centro de Operaciones / Taller
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">domain</span>
              <select
                class="w-full h-[38px] pl-9 pr-8 bg-surface rounded-xl text-[12px] text-on-surface focus:outline-none focus:bg-surface-container-lowest appearance-none border border-transparent hover:border-surface-container focus:border-secondary shadow-2xs transition-all cursor-pointer"
                id="service-area"
              >
                <option selected value="central">Taller Central - Sucursal 01</option>
                <option value="en-sitio">Servicio En Sitio / Campo (In-Situ)</option>
                <option value="remoto">Soporte Remoto / Noc Helpdesk</option>
              </select>
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] pointer-events-none">expand_more</span>
            </div>
          </div>

          <!-- Estado Inicial -->
          <div class="col-span-12 md:col-span-4 flex flex-col gap-1.5">
            <label class="text-[12px] text-on-surface font-semibold" for="service-status">
              Estado Operativo Inicial
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">toggle_on</span>
              <select
                class="w-full h-[38px] pl-9 pr-8 bg-surface rounded-xl text-[12px] text-on-surface focus:outline-none focus:bg-surface-container-lowest appearance-none border border-transparent hover:border-surface-container focus:border-secondary shadow-2xs transition-all cursor-pointer"
                id="service-status"
              >
                <option selected value="activo">Activo / En Catálogo</option>
                <option value="pausa">En Pausa / No Disponible</option>
                <option value="interno">Solo Uso Interno</option>
              </select>
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] pointer-events-none">expand_more</span>
            </div>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 2: Esquema de Tarifas, Costos y Duración -->
      <div class="p-4 sm:p-5 rounded-xl bg-surface-container-low flex flex-col gap-4 border border-surface-container/60">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-md bg-secondary text-on-secondary flex items-center justify-center text-[11px] font-bold">2</span>
            <h3 class="text-[15px] sm:text-[16px] font-bold text-primary">Esquema de Tarifas, Costos y Tiempos</h3>
          </div>
          <span class="text-[11px] text-on-surface-variant font-medium">Cálculos automáticos de rentabilidad</span>
        </div>

        <!-- Modalidad de Cobro (Pills interactivos) -->
        <div class="flex flex-col gap-2">
          <label class="text-[12px] text-on-surface font-semibold">
            Modalidad de Facturación del Servicio
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2.5" id="billing-modes">
            <!-- Card 1: Tarifa Fija (Selected) -->
            <div
              class="billing-card cursor-pointer p-3 rounded-xl bg-surface-container-lowest text-on-surface shadow-xs border border-secondary/30 flex flex-col gap-1 transition-all"
              data-mode="fixed"
            >
              <div class="flex items-center justify-between">
                <div class="w-7 h-7 rounded-lg bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center">
                  <span class="material-symbols-outlined text-[16px]">price_check</span>
                </div>
                <span class="billing-radio w-4 h-4 rounded-full bg-secondary flex items-center justify-center text-on-secondary">
                  <span class="material-symbols-outlined text-[12px] font-bold">check</span>
                </span>
              </div>
              <span class="text-[13px] font-semibold text-primary mt-1">Tarifa Fija</span>
              <span class="text-[11px] text-on-surface-variant">Monto cerrado por evento técnico</span>
            </div>

            <!-- Card 2: Por Hora -->
            <div
              class="billing-card cursor-pointer p-3 rounded-xl bg-surface hover:bg-surface-container-lowest text-on-surface shadow-none border border-transparent flex flex-col gap-1 transition-all opacity-80 hover:opacity-100"
              data-mode="hourly"
            >
              <div class="flex items-center justify-between">
                <div class="w-7 h-7 rounded-lg bg-surface-container text-on-surface-variant flex items-center justify-center">
                  <span class="material-symbols-outlined text-[16px]">schedule</span>
                </div>
                <span class="billing-radio w-4 h-4 rounded-full bg-surface-container flex items-center justify-center text-transparent">
                  <span class="material-symbols-outlined text-[12px]">check</span>
                </span>
              </div>
              <span class="text-[13px] font-semibold text-primary mt-1">Por Hora / H-Hombre</span>
              <span class="text-[11px] text-on-surface-variant">Tarificación por tiempo invertido</span>
            </div>

            <!-- Card 3: Por Punto / Nodo -->
            <div
              class="billing-card cursor-pointer p-3 rounded-xl bg-surface hover:bg-surface-container-lowest text-on-surface shadow-none border border-transparent flex flex-col gap-1 transition-all opacity-80 hover:opacity-100"
              data-mode="unit"
            >
              <div class="flex items-center justify-between">
                <div class="w-7 h-7 rounded-lg bg-surface-container text-on-surface-variant flex items-center justify-center">
                  <span class="material-symbols-outlined text-[16px]">lan</span>
                </div>
                <span class="billing-radio w-4 h-4 rounded-full bg-surface-container flex items-center justify-center text-transparent">
                  <span class="material-symbols-outlined text-[12px]">check</span>
                </span>
              </div>
              <span class="text-[13px] font-semibold text-primary mt-1">Por Punto / Nodo</span>
              <span class="text-[11px] text-on-surface-variant">Escalable por boca o dispositivo</span>
            </div>

            <!-- Card 4: Por Proyecto -->
            <div
              class="billing-card cursor-pointer p-3 rounded-xl bg-surface hover:bg-surface-container-lowest text-on-surface shadow-none border border-transparent flex flex-col gap-1 transition-all opacity-80 hover:opacity-100"
              data-mode="custom"
            >
              <div class="flex items-center justify-between">
                <div class="w-7 h-7 rounded-lg bg-surface-container text-on-surface-variant flex items-center justify-center">
                  <span class="material-symbols-outlined text-[16px]">request_quote</span>
                </div>
                <span class="billing-radio w-4 h-4 rounded-full bg-surface-container flex items-center justify-center text-transparent">
                  <span class="material-symbols-outlined text-[12px]">check</span>
                </span>
              </div>
              <span class="text-[13px] font-semibold text-primary mt-1">Cotización / Proyecto</span>
              <span class="text-[11px] text-on-surface-variant">Presupuesto libre por alcance</span>
            </div>
          </div>
        </div>

        <!-- Finanzas y Cálculos en tiempo real -->
        <div class="grid grid-cols-12 gap-3 sm:gap-4 items-center">
          <!-- Precio Base Venta -->
          <div class="col-span-12 md:col-span-4 flex flex-col gap-1.5">
            <label class="text-[12px] text-on-surface font-semibold" for="price-sale">
              Precio de Venta Base (COP) *
            </label>
            <div class="relative">
              <span class="font-mono text-[17px] font-bold text-secondary absolute left-3 top-1/2 -translate-y-1/2">$</span>
              <input
                class="w-full h-11 pl-9 pr-3 bg-surface-container-lowest rounded-xl font-mono text-[18px] font-bold text-primary focus:outline-none border border-surface-container/70 focus:border-secondary shadow-xs transition-all"
                id="price-sale"
                step="500"
                type="number"
                value="95000"
              />
            </div>
            <span class="text-[11px] text-on-surface-variant">Tarifa al cliente sin impuestos adicionales (Pesos COP).</span>
          </div>

          <!-- Costo Interno Estimado -->
          <div class="col-span-12 md:col-span-4 flex flex-col gap-1.5">
            <label class="text-[12px] text-on-surface font-semibold" for="price-cost">
              Costo Interno (Mano de Obra COP) *
            </label>
            <div class="relative">
              <span class="font-mono text-[17px] font-bold text-on-surface-variant absolute left-3 top-1/2 -translate-y-1/2">$</span>
              <input
                class="w-full h-11 pl-9 pr-3 bg-surface-container-lowest rounded-xl font-mono text-[18px] font-bold text-on-surface focus:outline-none border border-surface-container/70 focus:border-secondary shadow-xs transition-all"
                id="price-cost"
                step="500"
                type="number"
                value="35000"
              />
            </div>
            <span class="text-[11px] text-on-surface-variant">Asignación al técnico o costo base estimado.</span>
          </div>

          <!-- Margen Operativo Widget -->
          <div class="col-span-12 md:col-span-4 flex flex-col justify-end">
            <div class="h-11 bg-surface-container-lowest rounded-xl px-3 flex items-center justify-between shadow-xs border border-surface-container/70">
              <div class="flex flex-col">
                <span class="text-[11px] text-on-surface-variant">Margen Neto Estimado</span>
                <span class="font-mono text-[13px] text-primary font-bold" id="label-profit">$60.000 COP de ganancia</span>
              </div>
              <div class="bg-tertiary-fixed text-on-tertiary text-[12px] px-2.5 py-1 rounded-lg font-bold flex items-center gap-1" id="badge-margin">
                <span class="material-symbols-outlined text-[16px] text-tertiary-container">trending_up</span>
                <span class="text-tertiary-container font-semibold" id="margin-value">+63.2% Margen</span>
              </div>
            </div>
            <span class="text-[11px] text-on-surface-variant mt-1.5">Fórmula: [(Venta - Costo) / Venta] × 100</span>
          </div>
        </div>

        <!-- Tiempo / Duración Estimada -->
        <div class="grid grid-cols-12 gap-3 sm:gap-4 pt-1">
          <div class="col-span-12 md:col-span-6 flex flex-col gap-1.5">
            <label class="text-[12px] text-on-surface font-semibold">
              Duración Estimada de Ejecución *
            </label>
            <div class="grid grid-cols-2 gap-2">
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">timer</span>
                <input
                  class="w-full h-[38px] pl-9 pr-12 bg-surface-container-lowest rounded-xl font-mono text-[13px] font-semibold text-primary focus:outline-none border border-surface-container/70 focus:border-secondary shadow-xs"
                  id="service-hours"
                  max="99"
                  min="0"
                  type="number"
                  value="2"
                />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[11px] text-on-surface-variant font-medium">horas</span>
              </div>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">pace</span>
                <input
                  class="w-full h-[38px] pl-9 pr-12 bg-surface-container-lowest rounded-xl font-mono text-[13px] font-semibold text-primary focus:outline-none border border-surface-container/70 focus:border-secondary shadow-xs"
                  id="service-minutes"
                  max="59"
                  min="0"
                  step="15"
                  type="number"
                  value="30"
                />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[11px] text-on-surface-variant font-medium">min</span>
              </div>
            </div>
            <span class="text-[11px] text-on-surface-variant">Se cargará como ventana horaria sugerida en el calendario técnico.</span>
          </div>

          <div class="col-span-12 md:col-span-6 flex flex-col gap-1.5">
            <label class="text-[12px] text-on-surface font-semibold" for="service-warranty">
              Garantía Post-Servicio
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">verified_user</span>
              <select
                class="w-full h-[38px] pl-9 pr-8 bg-surface-container-lowest rounded-xl text-[12px] text-on-surface focus:outline-none appearance-none border border-surface-container/70 focus:border-secondary shadow-xs transition-all cursor-pointer"
                id="service-warranty"
              >
                <option value="none">Sin garantía extendida</option>
                <option value="15">15 días continuos</option>
                <option selected value="30">30 días de cobertura post-entrega (Estándar)</option>
                <option value="60">60 días de cobertura para empresas</option>
                <option value="90">90 días de soporte integral</option>
              </select>
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] pointer-events-none">expand_more</span>
            </div>
            <span class="text-[11px] text-on-surface-variant">Aplica bajo condiciones normales de operación del cliente.</span>
          </div>
        </div>
      </div>

      <!-- SECCIÓN 3: Asignación, Inventario y Especificaciones -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-md bg-surface-container-high text-primary flex items-center justify-center text-[11px] font-bold">3</span>
            <h3 class="text-[15px] sm:text-[16px] font-bold text-primary">Asignación, Insumos y Protocolo Técnico</h3>
          </div>
          <span class="text-[11px] text-on-surface-variant">Requerimientos de mano de obra y repuestos</span>
        </div>

        <div class="grid grid-cols-12 gap-3 sm:gap-4">
          <!-- Técnico Sugerido -->
          <div class="col-span-12 md:col-span-6 flex flex-col gap-1.5">
            <label class="text-[12px] text-on-surface font-semibold" for="service-lead-tech">
              Técnico Responsable Sugerido
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">badge</span>
              <select
                class="w-full h-[38px] pl-9 pr-8 bg-surface rounded-xl text-[12px] text-on-surface focus:outline-none focus:bg-surface-container-lowest appearance-none border border-transparent hover:border-surface-container focus:border-secondary shadow-2xs transition-all cursor-pointer"
                id="service-lead-tech"
              >
                <option value="any">Cualquier Técnico Calificado</option>
                <option selected value="carlos">Ing. Carlos Mendoza (Sistemas & Redes)</option>
                <option value="mariana">Lic. Mariana Silva (Hardware POS)</option>
                <option value="roberto">Téc. Roberto Gómez (Microelectrónica)</option>
              </select>
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] pointer-events-none">expand_more</span>
            </div>
          </div>

          <!-- Requerimiento de Insumos -->
          <div class="col-span-12 md:col-span-6 flex flex-col gap-1.5">
            <label class="text-[12px] text-on-surface font-semibold" for="service-parts-req">
              Requerimiento de Repuestos / Materiales
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">inventory_2</span>
              <select
                class="w-full h-[38px] pl-9 pr-8 bg-surface rounded-xl text-[12px] text-on-surface focus:outline-none focus:bg-surface-container-lowest appearance-none border border-transparent hover:border-surface-container focus:border-secondary shadow-2xs transition-all cursor-pointer"
                id="service-parts-req"
              >
                <option value="standard">Solo Mano de Obra (Sin insumos obligatorios)</option>
                <option selected value="consumables">Requiere Insumos Básicos de Taller (Pasta, Estaño, etc.)</option>
                <option value="critical">Requiere Repuestos Específicos (Cotización Adicional)</option>
              </select>
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] pointer-events-none">expand_more</span>
            </div>
          </div>

          <!-- Alcance del servicio / notas -->
          <div class="col-span-12 flex flex-col gap-1.5">
            <label class="text-[12px] text-on-surface font-semibold" for="service-description">
              Protocolo Técnico / Alcance del Servicio
            </label>
            <textarea
              id="service-description"
              rows="2"
              class="w-full p-3 bg-surface rounded-xl text-[12px] text-on-surface placeholder:text-on-surface-variant/70 border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest shadow-2xs transition-all resize-none"
              placeholder="Detalla las tareas técnicas comprendidas en la orden..."
            >Incluye diagnóstico integral, limpieza de chasis por ultrasonido, cambio de pasta térmica de alto rendimiento, sustitución de fuentes redundantes y prueba de estrés de 2 horas con informe técnico de conformidad.</textarea>
          </div>
        </div>
      </div>

    </div>

    <!-- Modal Footer Actions -->
    <div class="px-5 sm:px-6 py-3.5 bg-surface-container-low flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-surface-container/60 shrink-0">
      <div class="flex items-center gap-2 text-on-surface-variant">
        <span class="material-symbols-outlined text-[18px] text-secondary">info</span>
        <span class="text-[12px]">
          El servicio se registrará con disponibilidad inmediata para cajas POS y órdenes de taller.
        </span>
      </div>
      <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
        <button
          class="h-[38px] px-3.5 bg-surface hover:bg-surface-container text-on-surface-variant hover:text-on-surface rounded-xl text-[12px] font-medium transition-colors cursor-pointer"
          id="cancelServiceModalBtn"
          onclick="window.closeServiceModal && window.closeServiceModal()"
          type="button"
        >
          Cancelar
        </button>
        <button
          class="h-[38px] px-3.5 bg-surface-container-lowest hover:bg-surface text-primary rounded-xl text-[12px] font-medium shadow-xs transition-colors flex items-center gap-1.5 cursor-pointer border border-surface-container/70 active:scale-95"
          type="button"
          onclick="window.saveNewService && window.saveNewService(true)"
        >
          <span class="material-symbols-outlined text-[17px]">add_circle</span>
          <span>Guardar y Crear Otro</span>
        </button>
        <button
          class="h-[38px] px-4 bg-secondary hover:bg-secondary-container text-on-secondary rounded-xl text-[12px] font-semibold shadow-xs hover:shadow-md flex items-center gap-1.5 transition-all cursor-pointer active:scale-95"
          id="btn-submit-service"
          type="button"
          onclick="window.saveNewService && window.saveNewService(false)"
        >
          <span class="material-symbols-outlined text-[18px]">check_circle</span>
          <span id="btn-submit-label">Registrar Servicio ($95.000 COP)</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Scripts de Interactividad y Cálculos del Servicio -->
<script>
  import gsap from "gsap";

  // Apertura global del modal de servicios
  (window as any).openServiceModal = function () {
    const modal = document.getElementById("serviceModalOverlay");
    const container = document.getElementById("serviceModalContainer");
    if (!modal || !container) return;

    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";

    gsap.killTweensOf([modal, container]);
    gsap.fromTo(modal, { opacity: 0 }, { opacity: 1, duration: 0.2, ease: "power2.out" });
    gsap.fromTo(
      container,
      { scale: 0.94, y: 16, opacity: 0 },
      { scale: 1, y: 0, opacity: 1, duration: 0.25, ease: "power2.out" }
    );
  };

  // Cierre global del modal de servicios
  (window as any).closeServiceModal = function () {
    const modal = document.getElementById("serviceModalOverlay");
    const container = document.getElementById("serviceModalContainer");
    if (!modal || !container) return;

    document.body.style.overflow = "";

    gsap.killTweensOf([modal, container]);
    gsap.to(container, {
      scale: 0.96,
      opacity: 0,
      duration: 0.16,
      ease: "power2.in",
    });
    gsap.to(modal, {
      opacity: 0,
      duration: 0.18,
      ease: "power2.in",
      onComplete: () => {
        modal.classList.add("hidden");
      },
    });
  };

  // Sincronización y cálculo de margen en tiempo real
  function initServiceCalculations() {
    const priceSaleInput = document.getElementById("price-sale") as HTMLInputElement | null;
    const priceCostInput = document.getElementById("price-cost") as HTMLInputElement | null;
    const labelProfit = document.getElementById("label-profit");
    const marginValue = document.getElementById("margin-value");
    const btnSubmitLabel = document.getElementById("btn-submit-label");
    const btnGenerateSku = document.getElementById("btn-generate-sku");
    const serviceSku = document.getElementById("service-sku") as HTMLInputElement | null;

    function updateCalculations() {
      const sale = parseFloat(priceSaleInput?.value || "0") || 0;
      const cost = parseFloat(priceCostInput?.value || "0") || 0;
      const profit = sale - cost;
      const margin = sale > 0 ? ((profit / sale) * 100).toFixed(1) : "0.0";

      const formattedProfit = Math.round(profit).toLocaleString("es-CO");
      const formattedSale = Math.round(sale).toLocaleString("es-CO");

      if (labelProfit) labelProfit.textContent = `$${formattedProfit} COP de ganancia`;
      if (marginValue) marginValue.textContent = `${parseFloat(margin) >= 0 ? "+" : ""}${margin}% Margen`;
      if (btnSubmitLabel) btnSubmitLabel.textContent = `Registrar Servicio ($${formattedSale} COP)`;
    }

    if (priceSaleInput) priceSaleInput.addEventListener("input", updateCalculations);
    if (priceCostInput) priceCostInput.addEventListener("input", updateCalculations);

    // Auto-generación de SKU
    if (btnGenerateSku && serviceSku) {
      btnGenerateSku.addEventListener("click", () => {
        const rand = Math.floor(10 + Math.random() * 90);
        const types = ["MNT", "SRV", "RED", "LAB", "POS"];
        const picked = types[Math.floor(Math.random() * types.length)];
        serviceSku.value = `SRV-${picked}-${rand}`;
        gsap.fromTo(serviceSku, { scale: 0.97 }, { scale: 1, duration: 0.2 });
      });
    }

    // Modalidad de cobro (cards seleccionables)
    const billingCards = document.querySelectorAll(".billing-card");
    billingCards.forEach((card) => {
      card.addEventListener("click", function () {
        billingCards.forEach((c) => {
          c.classList.remove("bg-surface-container-lowest", "shadow-xs", "border-secondary/30", "opacity-100");
          c.classList.add("bg-surface", "shadow-none", "border-transparent", "opacity-80");
          const iconBg = c.querySelector(".billing-radio");
          if (iconBg) {
            iconBg.classList.remove("bg-secondary", "text-on-secondary");
            iconBg.classList.add("bg-surface-container", "text-transparent");
          }
        });

        this.classList.remove("bg-surface", "shadow-none", "border-transparent", "opacity-80");
        this.classList.add("bg-surface-container-lowest", "shadow-xs", "border-secondary/30", "opacity-100");
        const activeRadio = this.querySelector(".billing-radio");
        if (activeRadio) {
          activeRadio.classList.remove("bg-surface-container", "text-transparent");
          activeRadio.classList.add("bg-secondary", "text-on-secondary");
        }
      });
    });
  }

  // Guardar servicio técnico (mockup reactivo)
  (window as any).saveNewService = function (repeat = false) {
    const sku = (document.getElementById("service-sku") as HTMLInputElement | null)?.value.trim() || "SRV-MNT-06";
    const name = (document.getElementById("service-name") as HTMLInputElement | null)?.value.trim() || "";
    const sale = (document.getElementById("price-sale") as HTMLInputElement | null)?.value.trim() || "95000";
    const formattedSale = Math.round(parseFloat(sale) || 0).toLocaleString("es-CO");

    if (!name) {
      if ((window as any).showServiceToast) {
        (window as any).showServiceToast("Por favor ingrese el nombre del servicio técnico.", "warning");
      }
      return;
    }

    if ((window as any).showServiceToast) {
      (window as any).showServiceToast(`Servicio "${name}" [${sku}] por $${formattedSale} COP incorporado exitosamente.`);
    }

    if (!repeat) {
      (window as any).closeServiceModal();
    } else {
      const nameInput = document.getElementById("service-name") as HTMLInputElement | null;
      const skuInput = document.getElementById("service-sku") as HTMLInputElement | null;
      if (nameInput) nameInput.value = "";
      if (skuInput) {
        const rand = Math.floor(10 + Math.random() * 90);
        skuInput.value = `SRV-NEW-${rand}`;
      }
    }
  };

  // Atajo de teclado Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const modal = document.getElementById("serviceModalOverlay");
      if (modal && !modal.classList.contains("hidden")) {
        (window as any).closeServiceModal();
      }
    }
  });

  // Cerrar al hacer clic en el backdrop exterior
  function setupOverlayBackdrop() {
    const overlay = document.getElementById("serviceModalOverlay");
    if (overlay) {
      overlay.addEventListener("click", (e) => {
        if (e.target === overlay) {
          (window as any).closeServiceModal();
        }
      });
    }
  }

  document.addEventListener("astro:page-load", () => {
    initServiceCalculations();
    setupOverlayBackdrop();
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initServiceCalculations();
      setupOverlayBackdrop();
    });
  } else {
    initServiceCalculations();
    setupOverlayBackdrop();
  }
</script>
