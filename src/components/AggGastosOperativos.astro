---
// AggGastosOperativos.astro - Modal Corporativo de Registro de Gastos Operativos
---

<!-- OVERLAY / MODAL BACKDROP -->
<div
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-xs p-3 sm:p-4 overflow-y-auto hidden"
  id="expenseModalOverlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="expense-modal-title"
>
  <!-- MODAL CONTAINER -->
  <div
    class="relative w-full max-w-4xl my-auto bg-surface-container-lowest rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-surface-container/70"
    id="expenseModalContainer"
  >
    <!-- Modal Header -->
    <div class="px-5 sm:px-6 py-4 bg-surface-container-low flex items-start justify-between gap-4 border-b border-surface-container/60">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-primary text-on-primary flex items-center justify-center shrink-0 shadow-xs">
          <span class="material-symbols-outlined text-[22px]">receipt_long</span>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-2 flex-wrap">
            <h2 id="expense-modal-title" class="text-[17px] sm:text-[19px] font-bold text-primary tracking-tight">
              Registrar Nuevo Gasto Operativo
            </h2>
            <span class="text-[11px] font-semibold bg-secondary-container/15 text-secondary border border-secondary/20 px-2.5 py-0.5 rounded-full">
              Afecta Caja
            </span>
          </div>
          <p class="text-[12px] sm:text-[13px] text-on-surface-variant mt-0.5">
            Ingresa los detalles del comprobante, categoría contable y método de pago para imputación financiera.
          </p>
        </div>
      </div>
      <button
        class="text-on-surface-variant hover:text-on-surface hover:bg-surface-container p-1.5 rounded-xl transition-colors shrink-0 cursor-pointer"
        id="closeModalBtn"
        onclick="window.closeExpenseModal && window.closeExpenseModal()"
        title="Cerrar modal (Esc)"
        type="button"
      >
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <!-- Modal Body Form -->
    <form
      class="flex flex-col p-5 sm:p-6 gap-5 max-h-[calc(88vh-140px)] overflow-y-auto text-[13px]"
      id="expenseForm"
      onsubmit="event.preventDefault(); window.saveExpenseRecord && window.saveExpenseRecord();"
    >
      <!-- SECTION 1: Tipo de Comprobante & Datos Documentarios -->
      <div class="flex flex-col gap-2.5">
        <div class="flex items-center justify-between">
          <span class="text-[11px] text-on-surface-variant uppercase tracking-wider font-semibold flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-secondary">fact_check</span>
            1. Identificación del Comprobante
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2">
          <!-- Pill 1: Factura -->
          <label class="cursor-pointer">
            <input checked class="peer sr-only" name="voucher_type" type="radio" value="factura" />
            <div class="p-2.5 rounded-xl bg-surface-container-low peer-checked:bg-primary peer-checked:text-on-primary text-on-surface hover:bg-surface-container transition-all flex items-center gap-2 border border-surface-container/60 peer-checked:border-primary">
              <span class="material-symbols-outlined text-[18px]">receipt</span>
              <div class="flex flex-col">
                <span class="text-[12px] font-semibold leading-tight">Factura Electrónica</span>
                <span class="text-[10px] opacity-75">Con crédito fiscal</span>
              </div>
            </div>
          </label>
          <!-- Pill 2: Boleta -->
          <label class="cursor-pointer">
            <input class="peer sr-only" name="voucher_type" type="radio" value="boleta" />
            <div class="p-2.5 rounded-xl bg-surface-container-low peer-checked:bg-primary peer-checked:text-on-primary text-on-surface hover:bg-surface-container transition-all flex items-center gap-2 border border-surface-container/60 peer-checked:border-primary">
              <span class="material-symbols-outlined text-[18px]">description</span>
              <div class="flex flex-col">
                <span class="text-[12px] font-semibold leading-tight">Boleta / Recibo</span>
                <span class="text-[10px] opacity-75">Consumo simple</span>
              </div>
            </div>
          </label>
          <!-- Pill 3: Vale Caja Chica -->
          <label class="cursor-pointer">
            <input class="peer sr-only" name="voucher_type" type="radio" value="vale" />
            <div class="p-2.5 rounded-xl bg-surface-container-low peer-checked:bg-primary peer-checked:text-on-primary text-on-surface hover:bg-surface-container transition-all flex items-center gap-2 border border-surface-container/60 peer-checked:border-primary">
              <span class="material-symbols-outlined text-[18px]">request_quote</span>
              <div class="flex flex-col">
                <span class="text-[12px] font-semibold leading-tight">Vale Caja Chica</span>
                <span class="text-[10px] opacity-75">Gasto menor interno</span>
              </div>
            </div>
          </label>
          <!-- Pill 4: Sin comprobante -->
          <label class="cursor-pointer">
            <input class="peer sr-only" name="voucher_type" type="radio" value="ninguno" />
            <div class="p-2.5 rounded-xl bg-surface-container-low peer-checked:bg-primary peer-checked:text-on-primary text-on-surface hover:bg-surface-container transition-all flex items-center gap-2 border border-surface-container/60 peer-checked:border-primary">
              <span class="material-symbols-outlined text-[18px]">do_not_disturb_on</span>
              <div class="flex flex-col">
                <span class="text-[12px] font-semibold leading-tight">Sin Comprobante</span>
                <span class="text-[10px] opacity-75">Declaración jurada</span>
              </div>
            </div>
          </label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-1">
          <!-- Folio / Nro -->
          <div class="flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-on-surface" for="expenseFolioInput">N° de Comprobante / Folio *</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">pin</span>
              <input
                id="expenseFolioInput"
                class="w-full h-10 pl-9 pr-3 bg-surface rounded-xl font-mono text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-surface-container/60 focus:outline-none focus:bg-surface-container-lowest transition-all"
                placeholder="Ej: F001-0004892"
                type="text"
                value="F001-0004892"
              />
            </div>
          </div>
          <!-- Fecha y Hora -->
          <div class="flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-on-surface">Fecha y Hora de Emisión *</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">calendar_today</span>
              <input
                id="expenseDateInput"
                class="w-full h-10 pl-9 pr-3 bg-surface rounded-xl font-mono text-[13px] text-on-surface border border-surface-container/60 focus:outline-none focus:bg-surface-container-lowest transition-all"
                type="datetime-local"
                value="2024-10-24T14:30"
              />
            </div>
          </div>
          <!-- Período Fiscal Contable -->
          <div class="flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-on-surface">Período Contable</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">event_note</span>
              <input
                class="w-full h-10 pl-9 pr-3 bg-surface-container-low text-on-surface-variant text-[12px] font-medium rounded-xl border border-surface-container/60 cursor-not-allowed"
                readonly
                type="text"
                value="Octubre 2024 (Abierto)"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 2: Clasificación y Monto Total Destacado -->
      <div class="flex flex-col gap-2.5 bg-surface-container-low/60 p-4 rounded-2xl border border-surface-container/50">
        <div class="flex items-center justify-between">
          <span class="text-[11px] text-on-surface-variant uppercase tracking-wider font-semibold flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-secondary">category</span>
            2. Clasificación Contable y Monto
          </span>
          <div class="flex items-center gap-1 text-[11px] font-medium text-on-surface-variant">
            <span>Impuesto:</span>
            <span class="font-semibold text-on-surface">IVA / IGV 19% incluido</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-start">
          <!-- Categoría Selector -->
          <div class="md:col-span-4 flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-on-surface">Categoría Operativa *</label>
            <div class="relative">
              <select
                id="expenseCategorySelect"
                class="w-full h-10 pl-3 pr-8 bg-surface-container-lowest rounded-xl text-[12px] font-medium text-on-surface border border-surface-container/60 appearance-none focus:outline-none cursor-pointer"
              >
                <option selected value="suministros">📦 Suministros y Empaque</option>
                <option value="servicios">⚡ Servicios Básicos (Luz/Agua/Net)</option>
                <option value="mantenimiento">🔧 Mantenimiento &amp; Reparaciones</option>
                <option value="fletes">🚚 Logística y Fletes Internos</option>
                <option value="viaticos">🥪 Viáticos &amp; Alimentación</option>
                <option value="alquiler">🏢 Alquiler de Local / Almacén</option>
                <option value="software">💻 Licencias &amp; Telecomunicaciones</option>
              </select>
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
            </div>
          </div>

          <!-- Centro de Costos / Almacén -->
          <div class="md:col-span-4 flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-on-surface">Centro de Costo / Sucursal *</label>
            <div class="relative">
              <select
                id="expenseBranchSelect"
                class="w-full h-10 pl-3 pr-8 bg-surface-container-lowest rounded-xl text-[12px] font-medium text-on-surface border border-surface-container/60 appearance-none focus:outline-none cursor-pointer"
              >
                <option selected value="central_alm">Sucursal Central 01 - Almacén General</option>
                <option value="central_pos">Sucursal Central 01 - Punto de Venta POS</option>
                <option value="taller_tec">Sucursal Central 01 - Taller de Reparación</option>
                <option value="sucursal_norte">Sucursal 02 - Norte Distribución</option>
                <option value="admin">Administración General y Finanzas</option>
              </select>
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
            </div>
          </div>

          <!-- Monto Total Hero Display -->
          <div class="md:col-span-4 bg-surface-container-lowest p-3.5 rounded-xl border border-surface-container/60 flex flex-col gap-1 shadow-xs">
            <div class="flex items-center justify-between">
              <label class="text-[11px] font-semibold text-on-surface-variant">Importe Total del Gasto *</label>
              <div class="flex items-center gap-1 bg-surface-container-low px-1.5 py-0.5 rounded text-[10px] font-semibold text-on-surface">
                <span class="text-secondary font-bold">USD $</span>
                <span class="text-outline">/</span>
                <span class="text-on-surface-variant">PEN S/</span>
              </div>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[20px] font-bold text-primary">$</span>
              <input
                class="w-full text-[24px] text-primary font-bold bg-transparent focus:outline-none tracking-tight font-mono"
                id="totalAmountInput"
                type="number"
                step="0.01"
                min="0"
                value="385.00"
                oninput="window.syncAmountDisplays(this.value)"
              />
            </div>
            <div class="flex items-center justify-between text-[11px] text-on-surface-variant pt-1 border-t border-surface-container/40">
              <span>Subtotal: <strong id="expenseSubtotal" class="text-on-surface font-mono">$326.27</strong></span>
              <span>IGV (18%): <strong id="expenseTax" class="text-on-surface font-mono">$58.73</strong></span>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 3: Detalle del Proveedor y Concepto -->
      <div class="flex flex-col gap-2.5">
        <div class="flex items-center justify-between">
          <span class="text-[11px] text-on-surface-variant uppercase tracking-wider font-semibold flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-secondary">domain</span>
            3. Proveedor / Beneficiario &amp; Detalle del Gasto
          </span>
          <button
            class="text-secondary text-[12px] font-semibold hover:underline flex items-center gap-1 cursor-pointer"
            type="button"
            onclick="alert('Módulo de Alta de Proveedores disponible próximamente.')"
          >
            <span class="material-symbols-outlined text-[16px]">add_circle</span>
            <span>Nuevo Proveedor</span>
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-3">
          <!-- Proveedor Select / Search -->
          <div class="md:col-span-7 flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-on-surface">Razón Social / Nombre Comercial *</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">store</span>
              <input
                id="expenseProviderName"
                class="w-full h-10 pl-9 pr-8 bg-surface rounded-xl text-[13px] text-on-surface border border-surface-container/60 focus:outline-none focus:bg-surface-container-lowest transition-all"
                placeholder="Buscar proveedor por nombre..."
                type="text"
                value="Papelera &amp; Distribuidora Central S.A.C."
              />
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-tertiary-container text-[18px]" title="Proveedor verificado">verified</span>
            </div>
          </div>

          <!-- Tax ID / RUC -->
          <div class="md:col-span-5 flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-on-surface">Identificación Fiscal (RUC / RFC) *</label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">badge</span>
              <input
                id="expenseProviderRuc"
                class="w-full h-10 pl-9 pr-3 bg-surface rounded-xl font-mono text-[13px] text-on-surface border border-surface-container/60 focus:outline-none focus:bg-surface-container-lowest transition-all"
                placeholder="RUC de 11 dígitos"
                type="text"
                value="20491823049"
              />
            </div>
          </div>

          <!-- Concepto / Descripción completa -->
          <div class="md:col-span-12 flex flex-col gap-1">
            <label class="text-[11px] font-semibold text-on-surface">Concepto / Glosa Justificativa *</label>
            <textarea
              id="expenseConceptDescription"
              class="w-full p-3 bg-surface rounded-xl text-[12px] text-on-surface placeholder:text-on-surface-variant/70 border border-surface-container/60 focus:outline-none focus:bg-surface-container-lowest transition-all resize-none"
              placeholder="Describe brevemente el destino de los insumos o el trabajo ejecutado..."
              rows="2"
            >Adquisición de 25 rollos térmicos de 80mm para impresoras POS de recepción y 15 resmas papel bond A4 para guías de remisión física.</textarea>
          </div>
        </div>
      </div>

      <!-- SECTION 4: Origen de Fondos y Digitalización -->
      <div class="flex flex-col gap-2.5">
        <div class="flex items-center justify-between">
          <span class="text-[11px] text-on-surface-variant uppercase tracking-wider font-semibold flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-secondary">payments</span>
            4. Origen de Fondos &amp; Liquidación
          </span>
          <span class="text-[11px] text-on-tertiary-container font-semibold flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-on-tertiary-container animate-pulse"></span>
            Saldo disponible suficiente
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-2">
          <!-- Method 1 -->
          <label class="cursor-pointer">
            <input checked class="peer sr-only" name="payment_method" type="radio" value="caja_chica" />
            <div class="p-3 rounded-xl bg-surface peer-checked:bg-primary-container peer-checked:text-on-primary hover:bg-surface-container-low transition-all flex flex-col gap-1 border border-surface-container/60">
              <div class="flex items-center justify-between">
                <span class="material-symbols-outlined text-[20px] text-secondary-container">point_of_sale</span>
                <span class="text-[11px] text-on-surface-variant">Caja 01</span>
              </div>
              <span class="text-[12px] font-semibold text-on-surface peer-checked:text-on-primary">Caja Chica Operativa</span>
              <span class="font-mono text-[11px] text-on-surface-variant peer-checked:text-on-primary-container">Disp: $1,360.00</span>
            </div>
          </label>

          <!-- Method 2 -->
          <label class="cursor-pointer">
            <input class="peer sr-only" name="payment_method" type="radio" value="tarjeta_debito" />
            <div class="p-3 rounded-xl bg-surface peer-checked:bg-primary-container peer-checked:text-on-primary hover:bg-surface-container-low transition-all flex flex-col gap-1 border border-surface-container/60">
              <div class="flex items-center justify-between">
                <span class="material-symbols-outlined text-[20px] text-secondary-container">credit_card</span>
                <span class="text-[11px] text-on-surface-variant">**** 8941</span>
              </div>
              <span class="text-[12px] font-semibold text-on-surface peer-checked:text-on-primary">Tarjeta Débito Corp</span>
              <span class="font-mono text-[11px] text-on-surface-variant peer-checked:text-on-primary-container">Banco de Crédito</span>
            </div>
          </label>

          <!-- Method 3 -->
          <label class="cursor-pointer">
            <input class="peer sr-only" name="payment_method" type="radio" value="transferencia" />
            <div class="p-3 rounded-xl bg-surface peer-checked:bg-primary-container peer-checked:text-on-primary hover:bg-surface-container-low transition-all flex flex-col gap-1 border border-surface-container/60">
              <div class="flex items-center justify-between">
                <span class="material-symbols-outlined text-[20px] text-secondary-container">account_balance</span>
                <span class="text-[11px] text-on-surface-variant">Cta Cte</span>
              </div>
              <span class="text-[12px] font-semibold text-on-surface peer-checked:text-on-primary">Transferencia Bancaria</span>
              <span class="font-mono text-[11px] text-on-surface-variant peer-checked:text-on-primary-container">Interbank Operativo</span>
            </div>
          </label>

          <!-- Method 4 -->
          <label class="cursor-pointer">
            <input class="peer sr-only" name="payment_method" type="radio" value="credito" />
            <div class="p-3 rounded-xl bg-surface peer-checked:bg-primary-container peer-checked:text-on-primary hover:bg-surface-container-low transition-all flex flex-col gap-1 border border-surface-container/60">
              <div class="flex items-center justify-between">
                <span class="material-symbols-outlined text-[20px] text-secondary-container">pending_actions</span>
                <span class="text-[11px] text-error font-semibold">Por Pagar</span>
              </div>
              <span class="text-[12px] font-semibold text-on-surface peer-checked:text-on-primary">Crédito a 30 Días</span>
              <span class="font-mono text-[11px] text-on-surface-variant peer-checked:text-on-primary-container">Cuenta por pagar</span>
            </div>
          </label>
        </div>
      </div>

      <!-- Optional Operational Tags -->
      <div class="flex items-center justify-between pt-1 text-on-surface-variant text-[12px]">
        <span>Registrado por: <strong class="text-on-surface">C. Mendoza</strong></span>
        <span class="font-mono text-[11px]">Audit ID: OP-2024-EXP-1104</span>
      </div>
    </form>

    <!-- Modal Footer -->
    <div class="px-5 sm:px-6 py-4 bg-surface-container-low flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-surface-container/60">
      <button
        class="h-10 px-4 bg-surface-container-lowest hover:bg-surface text-on-surface rounded-xl text-[13px] font-medium transition-colors border border-surface-container/60 cursor-pointer w-full sm:w-auto"
        id="cancelModalBtn"
        onclick="window.closeExpenseModal && window.closeExpenseModal()"
        type="button"
      >
        Cancelar
      </button>

      <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
        <button
          class="h-10 px-4 bg-surface-container-lowest hover:bg-surface text-on-surface rounded-xl text-[13px] font-medium flex items-center gap-1.5 transition-colors border border-surface-container/60 cursor-pointer"
          onclick="window.saveExpenseRecord && window.saveExpenseRecord(true)"
          type="button"
        >
          <span class="material-symbols-outlined text-[18px]">replay</span>
          <span>Guardar y Registrar Otro</span>
        </button>
        <button
          class="h-10 px-5 bg-secondary-container hover:bg-secondary text-on-secondary rounded-xl text-[13px] font-semibold flex items-center gap-2 shadow-xs transition-all cursor-pointer active:scale-95"
          id="submitExpenseBtn"
          onclick="window.saveExpenseRecord && window.saveExpenseRecord(false)"
          type="button"
        >
          <span class="material-symbols-outlined text-[18px]">check_circle</span>
          <span id="submitExpenseBtnText">Registrar Gasto ($385.00)</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";

  // Apertura del modal con animación GSAP
  (window as any).openExpenseModal = function () {
    const modal = document.getElementById("expenseModalOverlay") || document.getElementById("expenseModal");
    const container = document.getElementById("expenseModalContainer") || document.getElementById("expenseModalPanel");
    if (!modal || !container) return;

    modal.classList.remove("hidden");
    document.body.style.overflow = "hidden";

    gsap.fromTo(modal, { opacity: 0 }, { opacity: 1, duration: 0.22, ease: "power2.out" });
    gsap.fromTo(
      container,
      { y: 30, scale: 0.96, opacity: 0 },
      { y: 0, scale: 1, opacity: 1, duration: 0.28, ease: "back.out(1.2)" }
    );
  };

  // Cierre del modal con animación GSAP
  (window as any).closeExpenseModal = function () {
    const modal = document.getElementById("expenseModalOverlay") || document.getElementById("expenseModal");
    const container = document.getElementById("expenseModalContainer") || document.getElementById("expenseModalPanel");
    if (!modal || !container) return;

    document.body.style.overflow = "";

    gsap.to(container, {
      y: 20,
      scale: 0.96,
      opacity: 0,
      duration: 0.18,
      ease: "power2.in",
    });

    gsap.to(modal, {
      opacity: 0,
      duration: 0.2,
      ease: "power2.in",
      onComplete: () => {
        modal.classList.add("hidden");
      },
    });
  };

  // Sincronizar importes, subtotal, IGV y texto del botón
  (window as any).syncAmountDisplays = function (val: string) {
    const amount = parseFloat(val) || 0;
    const btnText = document.getElementById("submitExpenseBtnText");
    if (btnText) {
      btnText.textContent = `Registrar Gasto ($${amount.toFixed(2)})`;
    }

    const subtotalEl = document.getElementById("expenseSubtotal");
    const taxEl = document.getElementById("expenseTax");
    if (subtotalEl && taxEl) {
      const subtotal = amount / 1.18;
      const tax = amount - subtotal;
      subtotalEl.textContent = `$${subtotal.toFixed(2)}`;
      taxEl.textContent = `$${tax.toFixed(2)}`;
    }
  };

  // Guardar registro de gasto (mockup reactivo)
  (window as any).saveExpenseRecord = function (repeat = false) {
    const amountInput = document.getElementById("totalAmountInput") as HTMLInputElement | null;
    const folioInput = document.getElementById("expenseFolioInput") as HTMLInputElement | null;
    const descInput = document.getElementById("expenseConceptDescription") as HTMLTextAreaElement | null;

    const amount = amountInput?.value || "385.00";
    const folio = folioInput?.value || "F001-0004892";

    if (window.showExpenseToast) {
      window.showExpenseToast(`Gasto ${folio} por $${amount} registrado exitosamente e imputado a libros.`);
    }

    if (!repeat) {
      (window as any).closeExpenseModal();
    } else {
      if (amountInput) amountInput.value = "";
      if (descInput) descInput.value = "";
      (window as any).syncAmountDisplays("0.00");
    }
  };

  // Atajo de teclado Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const modal = document.getElementById("expenseModalOverlay");
      if (modal && !modal.classList.contains("hidden")) {
        (window as any).closeExpenseModal();
      }
    }
  });

  // Cerrar al hacer clic en el backdrop exterior
  const overlay = document.getElementById("expenseModalOverlay");
  if (overlay) {
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) {
        (window as any).closeExpenseModal();
      }
    });
  }
</script>
