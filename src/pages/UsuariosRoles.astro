  <script>
    import {
      initUsuarios,
      openUserModal,
      closeUserModal,
      showUserToast,
      filterRoleTab,
    } from "../animaciones/animaUsuarios.js";

    // Exponer funciones necesarias a window para atributos onclick y forms
    (window as any).openUserModal = openUserModal;
    (window as any).closeUserModal = closeUserModal;
    (window as any).showUserToast = showUserToast;
    (window as any).filterRoleTab = filterRoleTab;

    (window as any).saveNewUser = function() {
      const nameInput = document.getElementById("newUserName") as HTMLInputElement | null;
      const emailInput = document.getElementById("newUserEmail") as HTMLInputElement | null;
      const roleSelect = document.getElementById("newUserRole") as HTMLSelectElement | null;

      const name = nameInput?.value.trim();
      const email = emailInput?.value.trim();
      const role = roleSelect?.options[roleSelect.selectedIndex]?.text || "Vendedor POS";

      if (!name || !email) {
        showUserToast("Por favor complete el nombre y correo corporativo.", "warning");
        return;
      }

      closeUserModal();
      showUserToast(`Invitación enviada a ${name} (${role}) con token de seguridad.`);
      if (nameInput) nameInput.value = "";
      if (emailInput) emailInput.value = "";
    };

    function setupUsuarios() {
      initUsuarios();
    }

    document.addEventListener("astro:page-load", setupUsuarios);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupUsuarios);
    } else {
      setupUsuarios();
    }
  </script>
</Layout>
