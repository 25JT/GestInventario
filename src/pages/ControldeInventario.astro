---
// ControldeInventario.astro - Módulo Maestro de Control de Inventario
import Layout from "../layouts/Layout.astro";
import SlideBar from "../components/SlideBar.astro";
import NavBar from "../components/Nav.astro";
import AggCategoria from "../components/AggCategoria.astro";
import CarMasivaProductos from "../components/CarMasivaProductos.astro";

// Carga inicial SSR desde la API local de Node/Express
let initialKpis: any = {
  total_skus: 0,
  valorizacion_total: 0,
  valorizacion_formato: "$ 0",
  en_alerta: 0,
  agotados: 0,
  unidades_totales: 0,
  rotacion_dias: 0,
};

let initialProducts: any[] = [];
let initialCategories: any[] = [];
let totalItemsCount = 0;

try {
  const [resKpis, resInv, resCat] = await Promise.all([
    fetch("http://localhost:3000/api/inventario/kpis", { signal: AbortSignal.timeout(2000) }),
    fetch("http://localhost:3000/api/inventario?limit=50", { signal: AbortSignal.timeout(2000) }),
    fetch("http://localhost:3000/api/categorias", { signal: AbortSignal.timeout(2000) }),
  ]);
  if (resKpis.ok) {
    const jsonK = await resKpis.json();
    if (jsonK.success) initialKpis = jsonK.data;
  }
  if (resInv.ok) {
    const jsonI = await resInv.json();
    if (jsonI.success) {
      initialProducts = jsonI.data.items || [];
      totalItemsCount = jsonI.data.total || 0;
    }
  }
  if (resCat.ok) {
    const jsonC = await resCat.json();
    if (jsonC.success) initialCategories = jsonC.data.categorias || [];
  }
} catch (e) {
  // Manejo silencioso si el backend está reiniciando
}
---

<Layout title="Control de Inventario - StockControl Enterprise JR">
  <div class="min-h-screen bg-surface flex flex-col font-body-md text-on-surface">
    {/* Barra lateral y superior globales y responsivas */}
    <SlideBar currentPath="inventario" />
    <NavBar storeName="Central Sucursal 01" operationStatus="Operación Normal" />

    {/* Contenedor principal */}
    <div id="app-content" class="pt-16 min-h-screen flex flex-col flex-1">
      <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">

        <!-- Top Operations & Header Bar -->
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6">
          <div class="flex flex-col">
            <div class="flex items-center gap-2 mb-1">
              <span class="font-label-sm text-[12px] uppercase tracking-wider text-secondary-container font-semibold bg-surface-container-high px-2 py-0.5 rounded-lg">
                Módulo Almacén
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-outline-variant"></span>
            </div>
            <h1 class="text-[24px] sm:text-[28px] font-bold text-primary tracking-tight">
              Control de Inventario
            </h1>
            <p class="text-[13px] sm:text-[14px] text-on-surface-variant mt-0.5 max-w-2xl">
              Catálogo maestro de existencias, valuación en tiempo real y rotación de activos físicos.
            </p>
          </div>

          <!-- Quick Action Controls -->
          <div class="flex flex-wrap items-center gap-2.5">
            {/* 1. Botón Carga Masiva (abre componente modal CarMasivaProductos) */}
            <button
              id="btn-bulk-upload"
              class="h-[38px] px-3.5 bg-surface-container-lowest hover:bg-surface-container-low text-on-surface rounded-xl font-label-md text-[13px] font-medium border border-surface-container/70 shadow-2xs hover:shadow-xs transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
              type="button"
              onclick="window.openBulkUploadModal && window.openBulkUploadModal()"
              title="Importar catálogo masivo vía CSV o Excel"
            >
              <span class="material-symbols-outlined text-[18px] text-on-surface-variant">upload_file</span>
              <span>Carga masiva</span>
            </button>

            {/* 2. Botón Agregar Categoría (abre componente modal AggCategoria) */}
            <button
              id="btn-open-category"
              class="h-[38px] px-3.5 bg-surface-container-lowest hover:bg-surface-container-low text-on-surface rounded-xl font-label-md text-[13px] font-medium border border-surface-container/70 shadow-2xs hover:shadow-xs transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
              type="button"
              onclick="window.openCategoryModal && window.openCategoryModal()"
              title="Gestionar y agregar nuevas categorías de productos"
            >
              <span class="material-symbols-outlined text-[18px] text-on-surface-variant">category</span>
              <span>Agregar categoría</span>
            </button>

            {/* 3. Botón Agregar Producto (despliega Drawer) */}
            <button
              id="btn-open-drawer"
              class="h-[38px] px-4 bg-primary hover:bg-secondary text-on-primary rounded-xl font-label-md text-[13px] font-semibold shadow-xs hover:shadow-md transition-all flex items-center gap-2 cursor-pointer active:scale-95"
              type="button"
            >
              <span class="material-symbols-outlined text-[18px]">add_box</span>
              <span>Agregar Producto</span>
            </button>
          </div>
        </div>

        <!-- KPI Live Metric Bento Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
          <!-- KPI 1: Catálogo Total SKUs -->
          <div class="inv-kpi-card bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between relative overflow-hidden transition-all hover:shadow-md">
            <div class="flex items-center justify-between">
              <span class="text-[12px] uppercase tracking-wide text-on-surface-variant font-semibold">
                Catálogo Total SKUs
              </span>
              <span class="px-2 py-0.5 rounded-lg bg-surface-container text-[11px] font-semibold text-secondary-container">
                Activos
              </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
              <span id="kpi-total-skus" class="text-[26px] sm:text-[28px] text-primary font-bold tracking-tight">
                {initialKpis.total_skus}
              </span>
              <span class="text-[12px] text-on-surface-variant">ítems registrados</span>
            </div>
            <div class="w-full bg-surface-container h-1.5 rounded-full mt-3 overflow-hidden">
              <div class="bg-secondary-container h-full w-[82%] rounded-full"></div>
            </div>
          </div>

          <!-- KPI 2: Valorización Total -->
          <div class="inv-kpi-card bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between relative overflow-hidden transition-all hover:shadow-md">
            <div class="flex items-center justify-between">
              <span class="text-[12px] uppercase tracking-wide text-on-surface-variant font-semibold">
                Valorización de Activos
              </span>
              <span class="px-2 py-0.5 rounded-lg bg-surface-container-high text-[11px] font-semibold text-on-tertiary-container">
                Valuación Costo
              </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
              <span id="kpi-valorizacion" class="text-[26px] sm:text-[28px] text-primary font-bold tracking-tight">
                {initialKpis.valorizacion_formato}
              </span>
              <span class="text-[12px] text-on-surface-variant font-medium">COP costo repo.</span>
            </div>
            <div class="w-full bg-surface-container h-1.5 rounded-full mt-3 overflow-hidden">
              <div class="bg-on-tertiary-container h-full w-[64%] rounded-full"></div>
            </div>
          </div>

          <!-- KPI 3: Productos en Riesgo -->
          <div class="inv-kpi-card bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between relative overflow-hidden transition-all hover:shadow-md">
            <div class="flex items-center justify-between">
              <span class="text-[12px] uppercase tracking-wide text-on-surface-variant font-semibold">
                Stock en Umbral Crítico
              </span>
              <span class="px-2 py-0.5 rounded-lg bg-error-container text-error text-[11px] font-bold animate-pulse">
                Alerta
              </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
              <span id="kpi-alerta-count" class="text-[26px] sm:text-[28px] text-error font-bold tracking-tight">
                {initialKpis.en_alerta}
              </span>
              <span class="text-[12px] text-on-surface-variant">requieren reabastecimiento</span>
            </div>
            <div class="w-full bg-surface-container h-1.5 rounded-full mt-3 overflow-hidden">
              <div class="bg-error h-full w-[28%] rounded-full"></div>
            </div>
          </div>

          <!-- KPI 4: Rotación Promedio -->
          <div class="inv-kpi-card bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between relative overflow-hidden transition-all hover:shadow-md">
            <div class="flex items-center justify-between">
              <span class="text-[12px] uppercase tracking-wide text-on-surface-variant font-semibold">
                Índice Rotación Días
              </span>
              <span class="px-2 py-0.5 rounded-lg bg-surface-container text-[11px] font-semibold text-on-surface-variant">
                Saludable
              </span>
            </div>
            <div class="mt-3 flex items-baseline gap-2">
              <span id="kpi-rotacion" class="text-[26px] sm:text-[28px] text-primary font-bold tracking-tight">
                {initialKpis.rotacion_dias}
              </span>
              <span class="text-[12px] text-on-surface-variant">días de permanencia</span>
            </div>
            <div class="w-full bg-surface-container h-1.5 rounded-full mt-3 overflow-hidden">
              <div class="bg-primary-container h-full w-[76%] rounded-full"></div>
            </div>
          </div>
        </div>

        <!-- Filtration & Search Bar (Dense Ergonomic Strip) -->
        <div class="bg-surface-container-lowest p-3 rounded-xl border border-surface-container/60 shadow-xs mb-4 flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
          <!-- Live Search -->
          <div class="relative flex-1 min-w-[260px]">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">
              search
            </span>
            <input
              id="inventory-search"
              class="w-full h-9 pl-9 pr-14 bg-surface rounded-xl text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all"
              placeholder="Filtrar por Nombre de artículo, SKU o Código EAN-13..."
              type="text"
            />
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[10px] font-semibold uppercase bg-surface-container px-1.5 py-0.5 rounded text-on-surface-variant pointer-events-none">
              Esc
            </span>
          </div>

          <!-- Quick Filter Selectors -->
          <div class="flex flex-wrap items-center gap-2">
            <!-- Categoria -->
            <div class="relative">
              <select
                id="filter-category"
                class="h-9 pl-3 pr-7 bg-surface hover:bg-surface-container-low text-on-surface rounded-xl text-[12px] font-medium appearance-none cursor-pointer border border-transparent hover:border-surface-container focus:outline-none focus:bg-surface-container-lowest transition-all"
              >
                <option value="">Categoría: Todas</option>
                {initialCategories.map((c: any) => (
                  <option value={c.id}>{c.nombre} ({c.prefijo || "GEN"})</option>
                ))}
              </select>
              <span class="material-symbols-outlined pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-[16px] text-on-surface-variant">
                expand_more
              </span>
            </div>

            <!-- Estado Stock -->
            <div class="relative">
              <select
                id="filter-status"
                class="h-9 pl-3 pr-7 bg-surface hover:bg-surface-container-low text-on-surface rounded-xl text-[12px] font-medium appearance-none cursor-pointer border border-transparent hover:border-surface-container focus:outline-none focus:bg-surface-container-lowest transition-all"
              >
                <option value="">Salud Stock: Todo</option>
                <option value="opt">En Stock (Normal)</option>
                <option value="low">Stock Crítico (< Mínimo)</option>
                <option value="zero">Agotado (0 Unidades)</option>
              </select>
              <span class="material-symbols-outlined pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-[16px] text-on-surface-variant">
                expand_more
              </span>
            </div>

            <!-- Almacén Selector -->
            <div class="relative">
              <select
                id="filter-warehouse"
                class="h-9 pl-3 pr-7 bg-surface hover:bg-surface-container-low text-on-surface rounded-xl text-[12px] font-semibold appearance-none cursor-pointer border border-transparent hover:border-surface-container focus:outline-none focus:bg-surface-container-lowest transition-all"
              >
                <option value="main">Depósito: Sucursal Principal</option>
                <option value="north">Depósito: Bodega Norte 02</option>
                <option value="transit">En Tránsito Logístico</option>
              </select>
              <span class="material-symbols-outlined pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 text-[16px] text-on-surface-variant">
                expand_more
              </span>
            </div>

            <!-- Clear / Reset Filter Button -->
            <button
              id="btn-reset-filters"
              class="h-9 w-9 bg-surface hover:bg-surface-container-low text-on-surface-variant hover:text-on-surface rounded-xl text-[12px] flex items-center justify-center transition-colors cursor-pointer border border-transparent hover:border-surface-container"
              title="Restablecer filtros"
              type="button"
            >
              <span class="material-symbols-outlined text-[18px]">restart_alt</span>
            </button>
          </div>
        </div>

        <!-- High-Density Inventory Data Table Canvas -->
        <div class="bg-surface-container-lowest rounded-xl border border-surface-container/60 shadow-xs overflow-hidden flex flex-col">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-[13px]">
              <thead>
                <tr class="bg-surface-container-low h-10 text-on-surface-variant uppercase text-[11px] tracking-wider border-b border-surface-container/60">
                  <th class="w-10 px-3 py-2 text-center">
                    <input class="w-4 h-4 rounded text-secondary-container focus:ring-0 cursor-pointer" type="checkbox" />
                  </th>
                  <th class="px-3 py-2 font-semibold">SKU / Código</th>
                  <th class="px-3 py-2 font-semibold min-w-[220px]">Producto / Descripción</th>
                  <th class="px-3 py-2 font-semibold">Categoría</th>
                  <th class="px-3 py-2 font-semibold text-right">P. Compra (COP)</th>
                  <th class="px-3 py-2 font-semibold text-right">P. Venta (COP)</th>
                  <th class="px-3 py-2 font-semibold text-right">Margen</th>
                  <th class="px-3 py-2 font-semibold text-center min-w-[140px]">Salud / Existencias</th>
                  <th class="px-3 py-2 font-semibold min-w-[140px]">Ubicación</th>
                  <th class="px-4 py-2 font-semibold text-right min-w-[120px]">Acciones</th>
                </tr>
              </thead>
              <tbody id="inventory-table-body" class="divide-y divide-surface-container/40">
                {initialProducts.length > 0 ? (
                  initialProducts.map((item: any) => (
                    <tr
                      class="inventory-row h-12 hover:bg-surface-container-low transition-colors group"
                      data-id={item.id}
                      data-category={item.categoria_id}
                      data-status={item.salud_status}
                    >
                      <td class="px-3 py-2 text-center">
                        <input class="row-checkbox w-4 h-4 rounded text-secondary-container focus:ring-0 cursor-pointer" type="checkbox" value={item.id} />
                      </td>
                      <td class="px-3 py-2 font-semibold text-primary">
                        {item.sku}
                        <div class="text-[11px] text-on-surface-variant font-normal">{item.codigo_barras || "S/C"}</div>
                      </td>
                      <td class="px-3 py-2">
                        <div class="flex items-center gap-2.5">
                          <div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center shrink-0 text-on-surface-variant">
                            <span class="material-symbols-outlined text-[19px]">
                              {item.tipo === "FISICO" ? "inventory_2" : item.tipo === "CONSUMIBLE" ? "format_paint" : "build"}
                            </span>
                          </div>
                          <div class="flex flex-col min-w-0">
                            <span class="font-semibold text-on-surface truncate">{item.nombre}</span>
                            <span class="text-[11px] text-on-surface-variant truncate">{item.tipo || "Producto físico"}</span>
                          </div>
                        </div>
                      </td>
                      <td class="px-3 py-2">
                        <span class="px-2 py-0.5 rounded-lg bg-surface-container text-[11px] text-on-surface font-medium">
                          {item.categoria || "General"}
                        </span>
                      </td>
                      <td class="px-3 py-2 text-right text-on-surface-variant font-medium">{item.precio_compra_formato}</td>
                      <td class="px-3 py-2 text-right text-on-surface font-bold">{item.precio_venta_formato}</td>
                      <td class="px-3 py-2 text-right">
                        <span class="text-[11px] text-on-tertiary-container font-semibold bg-surface-container-high px-1.5 py-0.5 rounded-lg">
                          {item.margen_porcentaje}
                        </span>
                      </td>
                      <td class="px-3 py-2 text-center">
                        <div class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg text-[11px] ${item.badge_class}`}>
                          <span class={`w-1.5 h-1.5 rounded-full ${item.dot_class}`}></span>
                          <span>{item.salud_label}</span>
                        </div>
                      </td>
                      <td class="px-3 py-2 text-[12px] text-on-surface-variant">{item.ubicacion || "Bodega Central"}</td>
                      <td class="px-4 py-2 text-right">
                        <div class="flex items-center justify-end gap-1 opacity-80 group-hover:opacity-100 transition-opacity">
                          <button
                            class="p-1 text-on-surface-variant hover:text-secondary-container hover:bg-surface-container rounded-lg cursor-pointer"
                            title="Ajustar Stock Rápido"
                            type="button"
                            onclick={`window.quickAdjustStock && window.quickAdjustStock('${item.id}', '${item.sku}', ${item.stock_actual})`}
                          >
                            <span class="material-symbols-outlined text-[18px]">tune</span>
                          </button>
                          <button
                            class="p-1 text-on-surface-variant hover:text-error hover:bg-error-container/40 rounded-lg cursor-pointer"
                            title="Eliminar producto"
                            type="button"
                            onclick={`window.deleteProductItem && window.deleteProductItem('${item.id}', '${item.nombre}')`}
                          >
                            <span class="material-symbols-outlined text-[18px]">delete</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td colspan="10" class="px-4 py-12 text-center text-on-surface-variant">
                      No hay productos registrados en el inventario. Haz clic en "Agregar Producto" o "Carga Masiva".
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>

          <!-- Ergonomic Pagination Footer -->
          <div class="p-3 bg-surface-container-low flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-surface-container/60">
            <div class="flex items-center gap-4 text-[12px] text-on-surface-variant">
              <span>
                Mostrando <span id="inventory-visible-count" class="text-on-surface font-semibold">{initialProducts.length}</span> de <span id="inventory-total-count" class="text-on-surface font-semibold">{totalItemsCount}</span> artículos
              </span>
              <div class="flex items-center gap-1.5">
                <span>Filas:</span>
                <select class="h-6 px-1.5 bg-surface text-on-surface rounded text-[11px] border border-surface-container focus:outline-none cursor-pointer">
                  <option>10</option>
                  <option>25</option>
                  <option>50</option>
                  <option>100</option>
                </select>
              </div>
            </div>

            <div class="flex items-center gap-1">
              <button class="h-7 w-7 rounded-lg bg-surface text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest flex items-center justify-center transition-colors disabled:opacity-40 cursor-pointer" disabled type="button">
                <span class="material-symbols-outlined text-[16px]">first_page</span>
              </button>
              <button class="h-7 w-7 rounded-lg bg-surface text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest flex items-center justify-center transition-colors disabled:opacity-40 cursor-pointer" disabled type="button">
                <span class="material-symbols-outlined text-[16px]">chevron_left</span>
              </button>
              <button class="h-7 px-2.5 rounded-lg bg-primary-container text-on-primary text-[12px] font-semibold cursor-pointer" type="button">1</button>
              <button class="h-7 px-2.5 rounded-lg bg-surface hover:bg-surface-container-lowest text-on-surface text-[12px] font-medium cursor-pointer" type="button">2</button>
              <button class="h-7 px-2.5 rounded-lg bg-surface hover:bg-surface-container-lowest text-on-surface text-[12px] font-medium cursor-pointer" type="button">3</button>
              <span class="text-[12px] text-on-surface-variant px-1">...</span>
              <button class="h-7 px-2.5 rounded-lg bg-surface hover:bg-surface-container-lowest text-on-surface text-[12px] font-medium cursor-pointer" type="button">86</button>
              <button class="h-7 w-7 rounded-lg bg-surface text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest flex items-center justify-center transition-colors cursor-pointer" type="button">
                <span class="material-symbols-outlined text-[16px]">chevron_right</span>
              </button>
              <button class="h-7 w-7 rounded-lg bg-surface text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest flex items-center justify-center transition-colors cursor-pointer" type="button">
                <span class="material-symbols-outlined text-[16px]">last_page</span>
              </button>
            </div>
          </div>
        </div>

      </main>
    </div>
  </div>

  <!-- Slide-Over Drawer: 'Agregar Inventario / Nuevo Ítem' Flow -->
  <div
    id="drawer-backdrop"
    class="fixed inset-0 bg-primary/40 backdrop-blur-xs z-50 transition-opacity hidden pointer-events-none"
    aria-hidden="true"
  >
    <div
      id="drawer-panel"
      class="fixed top-0 right-0 h-full w-full max-w-lg bg-surface-container-lowest shadow-2xl flex flex-col justify-between z-50 pointer-events-none translate-x-full border-l border-surface-container"
    >
      <!-- Drawer Header -->
      <div class="p-4 sm:p-5 bg-surface-container-low flex items-center justify-between border-b border-surface-container/60 shrink-0">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-primary flex items-center justify-center text-on-primary shadow-xs">
            <span class="material-symbols-outlined text-[20px]">add_box</span>
          </div>
          <div>
            <h2 class="text-[17px] font-bold text-primary leading-tight">Agregar Producto</h2>
            <p class="text-[12px] text-on-surface-variant">Flujo de alta en catálogo maestro de almacén</p>
          </div>
        </div>
        <button
          id="btn-close-drawer"
          class="p-1.5 rounded-xl text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors cursor-pointer"
          type="button"
          title="Cerrar formulario"
        >
          <span class="material-symbols-outlined text-[22px]">close</span>
        </button>
      </div>

      <!-- Drawer Body (Form Fields) -->
      <div class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-4">
        <!-- Nombre del Producto -->
        <div class="space-y-1">
          <label class="text-[12px] font-semibold text-on-surface uppercase tracking-wide">
            Nombre del Producto / Activo *
          </label>
          <input
            id="drawer-name"
            class="w-full h-9 px-3 bg-surface rounded-xl text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all"
            placeholder="Ej. Multímetro Digital True RMS Fluke-117"
            type="text"
          />
        </div>

        <!-- SKU y Código de Barras -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="text-[12px] font-semibold text-on-surface uppercase tracking-wide">
              SKU Interno *
            </label>
            <input
              id="drawer-sku"
              class="w-full h-9 px-3 bg-surface rounded-xl text-[13px] text-on-surface font-semibold border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest"
              type="text"
              value="SKU-2024-"
            />
          </div>
          <div class="space-y-1">
            <label class="text-[12px] font-semibold text-on-surface uppercase tracking-wide">
              Código de Barras EAN
            </label>
            <div class="relative">
              <input
                id="drawer-ean"
                class="w-full h-9 px-3 pr-8 bg-surface rounded-xl text-[13px] text-on-surface border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest"
                placeholder="750XXXXXXXX"
                type="text"
              />
              <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-[18px] text-on-surface-variant pointer-events-none">
                barcode_scanner
              </span>
            </div>
          </div>
        </div>

        <!-- Categoría y Ubicación -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label class="text-[12px] font-semibold text-on-surface uppercase tracking-wide">
              Categoría *
            </label>
            <select
              id="drawer-category"
              class="w-full h-9 px-3 bg-surface text-on-surface rounded-xl text-[13px] border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest"
            >
              <option value="">Seleccione categoría...</option>
              {initialCategories.map((c: any) => (
                <option value={c.id}>{c.nombre} ({c.prefijo || "GEN"})</option>
              ))}
            </select>
          </div>
          <div class="space-y-1">
            <label class="text-[12px] font-semibold text-on-surface uppercase tracking-wide">
              Ubicación / Gaveta
            </label>
            <input
              id="drawer-location"
              class="w-full h-9 px-3 bg-surface rounded-xl text-[13px] text-on-surface border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest"
              placeholder="Ej. Pasillo C · Est. 02"
              type="text"
            />
          </div>
        </div>

        <!-- Cantidades y Umbrales -->
        <div class="p-3 bg-surface-container-low rounded-xl space-y-2 border border-surface-container/60">
          <span class="text-[11px] text-on-surface-variant font-semibold uppercase tracking-wider">
            Gestión de Stock Inicial
          </span>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-on-surface">Cantidad Inicial (Ingreso)</label>
              <input
                id="drawer-stock-initial"
                class="w-full h-9 px-3 bg-surface-container-lowest rounded-xl text-[13px] text-primary font-bold border border-surface-container/60 focus:outline-none focus:border-secondary"
                min="0"
                type="number"
                value="10"
              />
            </div>
            <div class="space-y-1">
              <label class="text-[11px] font-semibold text-on-surface">Alerta Stock Mínimo</label>
              <input
                id="drawer-stock-min"
                class="w-full h-9 px-3 bg-surface-container-lowest rounded-xl text-[13px] text-error font-bold border border-surface-container/60 focus:outline-none focus:border-error"
                min="1"
                type="number"
                value="5"
              />
            </div>
          </div>
        </div>

        <!-- Precios y Márgenes con cálculo dinámico -->
        <div class="grid grid-cols-3 gap-2">
          <div class="space-y-1">
            <label class="text-[11px] font-semibold text-on-surface uppercase tracking-wide">P. Compra (COP $)</label>
            <input
              id="drawer-cost"
              class="w-full h-9 px-2.5 bg-surface rounded-xl text-[13px] text-on-surface border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary"
              placeholder="0"
              type="number"
              step="100"
            />
          </div>
          <div class="space-y-1">
            <label class="text-[11px] font-semibold text-on-surface uppercase tracking-wide">P. Venta (COP $)</label>
            <input
              id="drawer-price"
              class="w-full h-9 px-2.5 bg-surface rounded-xl text-[13px] text-primary font-bold border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary"
              placeholder="0"
              type="number"
              step="100"
            />
          </div>
          <div class="space-y-1">
            <label class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wide">Margen Est.</label>
            <div
              id="drawer-margin"
              class="h-9 px-2 bg-surface-container-high rounded-xl flex items-center justify-center text-[12px] text-on-tertiary-container font-bold transition-colors"
            >
              0.0%
            </div>
          </div>
        </div>

        <!-- Proveedor -->
        <div class="space-y-1">
          <label class="text-[12px] font-semibold text-on-surface uppercase tracking-wide">
            Proveedor Asignado
          </label>
          <select
            id="drawer-supplier"
            class="w-full h-9 px-3 bg-surface text-on-surface rounded-xl text-[13px] border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary"
          >
            <option>Importadora Logística Global S.A.</option>
            <option>Distribuidora Industrial del Norte</option>
            <option>Electro Componentes Monterrey</option>
          </select>
        </div>

        <!-- Notas Operativas -->
        <div class="space-y-1">
          <label class="text-[12px] font-semibold text-on-surface uppercase tracking-wide">
            Notas / Observaciones de Recepción
          </label>
          <textarea
            id="drawer-notes"
            class="w-full p-2.5 bg-surface rounded-xl text-[13px] text-on-surface border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary resize-none"
            placeholder="Especificaciones de almacenaje, lote de fábrica o condiciones de garantía..."
            rows="2"
          ></textarea>
        </div>
      </div>

      <!-- Drawer Footer Action Bar -->
      <div class="p-4 sm:p-5 bg-surface-container-low flex items-center justify-end gap-3 border-t border-surface-container/60 shrink-0">
        <button
          id="btn-cancel-drawer"
          class="h-9 px-4 bg-surface hover:bg-surface-container text-on-surface-variant hover:text-on-surface rounded-xl text-[13px] font-medium transition-colors cursor-pointer"
          type="button"
        >
          Cancelar
        </button>
        <button
          id="btn-save-drawer"
          class="h-9 px-5 bg-secondary-container hover:bg-secondary text-on-secondary rounded-xl text-[13px] font-semibold shadow-xs hover:shadow-md transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
          type="button"
        >
          <span class="material-symbols-outlined text-[18px]">save</span>
          <span>Guardar Producto</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Notification Toast Global de Inventario -->
  <div
    id="inventory-toast"
    class="fixed bottom-6 right-6 bg-primary text-on-primary px-4 py-3 rounded-xl shadow-xl flex items-center gap-2.5 z-50 pointer-events-none opacity-0 translate-y-20 transition-all duration-300"
  >
    <span id="inventory-toast-icon" class="material-symbols-outlined text-secondary-fixed text-[20px]">
      check_circle
    </span>
    <span id="inventory-toast-text" class="text-[13px] font-medium">
      Producto registrado exitosamente en el catálogo.
    </span>
  </div>

  <!-- Componente Modal de Gestión y Creación de Categorías -->
  <AggCategoria />

  <!-- Componente Modal de Carga Masiva de Productos -->
  <CarMasivaProductos />

  <script>
    import {
      initInventoryAnimations,
      openProductDrawer,
      closeProductDrawer,
      showInventoryToast,
    } from "../animaciones/animaInventario.js";

    const API_BASE = "http://localhost:3000/api";

    // Exponer funciones necesarias al scope global
    (window as any).openProductDrawer = openProductDrawer;
    (window as any).closeProductDrawer = closeProductDrawer;
    (window as any).showInventoryToast = showInventoryToast;

    // Vincular apertura del modal de categorías
    (window as any).onOpenCategoryModal = function() {
      if (typeof (window as any).openCategoryModal === "function") {
        (window as any).openCategoryModal();
      }
    };

    // Vincular apertura del modal de carga masiva
    (window as any).onOpenBulkUploadModal = function() {
      if (typeof (window as any).openBulkUploadModal === "function") {
        (window as any).openBulkUploadModal();
      }
    };

    // Formatear COP en el cliente
    function formatCOP(val: number | string) {
      const num = Number(val) || 0;
      return new Intl.NumberFormat("es-CO", {
        style: "currency",
        currency: "COP",
        maximumFractionDigits: 0,
      }).format(num);
    }

    // 1. Cargar productos desde la base de datos
    async function fetchInventory(search = "", category = "", status = "") {
      try {
        const params = new URLSearchParams();
        if (search) params.append("q", search);
        if (category) params.append("categoria", category);
        if (status) params.append("salud", status);
        params.append("limit", "100");

        const res = await fetch(`${API_BASE}/inventario?${params.toString()}`);
        if (!res.ok) throw new Error("HTTP error " + res.status);
        const json = await res.json();
        if (json.success && json.data) {
          renderTableRows(json.data.items || []);
          const visibleCountEl = document.getElementById("inventory-visible-count");
          const totalCountEl = document.getElementById("inventory-total-count");
          if (visibleCountEl) visibleCountEl.textContent = String(json.data.items?.length || 0);
          if (totalCountEl) totalCountEl.textContent = String(json.data.total || 0);
        }
      } catch (err) {
        console.error("Error al cargar inventario:", err);
      }
    }

    // 2. Cargar KPIs desde la base de datos
    async function fetchKpis() {
      try {
        const res = await fetch(`${API_BASE}/inventario/kpis`);
        if (!res.ok) throw new Error("HTTP error " + res.status);
        const json = await res.json();
        if (json.success && json.data) {
          const k = json.data;
          const totalSkusEl = document.getElementById("kpi-total-skus");
          const valEl = document.getElementById("kpi-valorizacion");
          const alertaEl = document.getElementById("kpi-alerta-count");
          const rotEl = document.getElementById("kpi-rotacion");

          if (totalSkusEl) totalSkusEl.textContent = String(k.total_skus || 0);
          if (valEl) valEl.textContent = k.valorizacion_formato || "$ 0";
          if (alertaEl) alertaEl.textContent = String(k.en_alerta || 0);
          if (rotEl) rotEl.textContent = String(k.rotacion_dias || 0);
        }
      } catch (err) {
        console.error("Error al cargar KPIs:", err);
      }
    }

    // 3. Cargar categorías dinámicas en los selectores
    async function fetchCategories() {
      try {
        const res = await fetch(`${API_BASE}/categorias`);
        if (!res.ok) throw new Error("HTTP error " + res.status);
        const json = await res.json();
        if (json.success && json.data && Array.isArray(json.data.categorias)) {
          const cats = json.data.categorias;

          // Selector de filtro de tabla
          const filterCat = document.getElementById("filter-category") as HTMLSelectElement | null;
          if (filterCat) {
            const currentVal = filterCat.value;
            filterCat.innerHTML = `<option value="">Categoría: Todas</option>` +
              cats.map((c: any) => `<option value="${c.id}" ${currentVal === c.id ? "selected" : ""}>${c.nombre} (${c.prefijo || "GEN"})</option>`).join("");
          }

          // Selector del Drawer
          const drawerCat = document.getElementById("drawer-category") as HTMLSelectElement | null;
          if (drawerCat) {
            drawerCat.innerHTML = `<option value="">Seleccione categoría...</option>` +
              cats.map((c: any) => `<option value="${c.id}">${c.nombre} (${c.prefijo || "GEN"})</option>`).join("");
          }
        }
      } catch (err) {
        console.error("Error al cargar categorías:", err);
      }
    }

    // Renderizar filas de la tabla de inventario
    function renderTableRows(items: any[]) {
      const tbody = document.getElementById("inventory-table-body");
      if (!tbody) return;

      if (!items || items.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="10" class="px-4 py-12 text-center text-on-surface-variant">
              No se encontraron productos que coincidan con los filtros aplicados.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = items
        .map((item) => {
          const icon = item.tipo === "FISICO" ? "inventory_2" : item.tipo === "CONSUMIBLE" ? "format_paint" : "build";
          return `
            <tr
              class="inventory-row h-12 hover:bg-surface-container-low transition-colors group"
              data-id="${item.id}"
              data-category="${item.categoria_id}"
              data-status="${item.salud_status}"
            >
              <td class="px-3 py-2 text-center">
                <input class="row-checkbox w-4 h-4 rounded text-secondary-container focus:ring-0 cursor-pointer" type="checkbox" value="${item.id}" />
              </td>
              <td class="px-3 py-2 font-semibold text-primary">
                ${item.sku}
                <div class="text-[11px] text-on-surface-variant font-normal">${item.codigo_barras || "S/C"}</div>
              </td>
              <td class="px-3 py-2">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center shrink-0 text-on-surface-variant">
                    <span class="material-symbols-outlined text-[19px]">${icon}</span>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-semibold text-on-surface truncate">${item.nombre}</span>
                    <span class="text-[11px] text-on-surface-variant truncate">${item.tipo || "Producto físico"}</span>
                  </div>
                </div>
              </td>
              <td class="px-3 py-2">
                <span class="px-2 py-0.5 rounded-lg bg-surface-container text-[11px] text-on-surface font-medium">
                  ${item.categoria || "General"}
                </span>
              </td>
              <td class="px-3 py-2 text-right text-on-surface-variant font-medium">${item.precio_compra_formato}</td>
              <td class="px-3 py-2 text-right text-on-surface font-bold">${item.precio_venta_formato}</td>
              <td class="px-3 py-2 text-right">
                <span class="text-[11px] text-on-tertiary-container font-semibold bg-surface-container-high px-1.5 py-0.5 rounded-lg">
                  ${item.margen_porcentaje}
                </span>
              </td>
              <td class="px-3 py-2 text-center">
                <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg text-[11px] ${item.badge_class}">
                  <span class="w-1.5 h-1.5 rounded-full ${item.dot_class}"></span>
                  <span>${item.salud_label}</span>
                </div>
              </td>
              <td class="px-3 py-2 text-[12px] text-on-surface-variant">${item.ubicacion || "Bodega Central"}</td>
              <td class="px-4 py-2 text-right">
                <div class="flex items-center justify-end gap-1 opacity-80 group-hover:opacity-100 transition-opacity">
                  <button
                    class="p-1 text-on-surface-variant hover:text-secondary-container hover:bg-surface-container rounded-lg cursor-pointer"
                    title="Ajustar Stock Rápido"
                    type="button"
                    onclick="window.quickAdjustStock && window.quickAdjustStock('${item.id}', '${item.sku}', ${item.stock_actual})"
                  >
                    <span class="material-symbols-outlined text-[18px]">tune</span>
                  </button>
                  <button
                    class="p-1 text-on-surface-variant hover:text-error hover:bg-error-container/40 rounded-lg cursor-pointer"
                    title="Eliminar producto"
                    type="button"
                    onclick="window.deleteProductItem && window.deleteProductItem('${item.id}', '${item.nombre}')"
                  >
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                  </button>
                </div>
              </td>
            </tr>
          `;
        })
        .join("");
    }

    // 4. Ajuste rápido de stock vía PATCH
    (window as any).quickAdjustStock = async function(id: string, sku: string, currentStock: number) {
      const input = prompt(`Ajustar stock para ${sku} (Stock actual: ${currentStock}):\nIngrese la nueva cantidad:`, String(currentStock));
      if (input === null) return;
      const nuevaCantidad = parseInt(input.trim(), 10);
      if (isNaN(nuevaCantidad) || nuevaCantidad < 0) {
        alert("Por favor ingrese un número entero válido mayor o igual a 0.");
        return;
      }

      try {
        const res = await fetch(`${API_BASE}/inventario/producto/${id}/stock`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            cantidad: nuevaCantidad,
            motivo: "Ajuste manual desde panel de control",
          }),
        });
        const json = await res.json();
        if (json.success) {
          showInventoryToast(`Stock de ${sku} actualizado a ${nuevaCantidad} unidades.`);
          fetchInventory(
            (document.getElementById("inventory-search") as HTMLInputElement)?.value || "",
            (document.getElementById("filter-category") as HTMLSelectElement)?.value || "",
            (document.getElementById("filter-status") as HTMLSelectElement)?.value || ""
          );
          fetchKpis();
        } else {
          alert(json.error || "No se pudo actualizar el stock.");
        }
      } catch (err) {
        console.error("Error al actualizar stock:", err);
        alert("Error de conexión con el servidor.");
      }
    };

    // 5. Eliminar producto vía DELETE
    (window as any).deleteProductItem = async function(id: string, name: string) {
      if (!confirm(`¿Estás seguro de eliminar el producto "${name}" del catálogo?`)) return;

      try {
        const res = await fetch(`${API_BASE}/inventario/producto/${id}`, {
          method: "DELETE",
        });
        const json = await res.json();
        if (json.success) {
          showInventoryToast(`Producto "${name}" eliminado del catálogo.`);
          fetchInventory(
            (document.getElementById("inventory-search") as HTMLInputElement)?.value || "",
            (document.getElementById("filter-category") as HTMLSelectElement)?.value || "",
            (document.getElementById("filter-status") as HTMLSelectElement)?.value || ""
          );
          fetchKpis();
          fetchCategories();
        } else {
          alert(json.error || "No se pudo eliminar el producto.");
        }
      } catch (err) {
        console.error("Error al eliminar producto:", err);
        alert("Error de conexión con el servidor.");
      }
    };

    // 6. Guardar nuevo producto desde el Drawer
    function setupDrawerForm() {
      const btnSave = document.getElementById("btn-save-drawer");
      const costInput = document.getElementById("drawer-cost") as HTMLInputElement | null;
      const priceInput = document.getElementById("drawer-price") as HTMLInputElement | null;
      const marginEl = document.getElementById("drawer-margin");

      // Cálculo de margen en tiempo real en el Drawer
      const updateMargin = () => {
        const cost = Number(costInput?.value) || 0;
        const price = Number(priceInput?.value) || 0;
        if (price > 0 && cost > 0) {
          const margin = (((price - cost) / price) * 100).toFixed(1);
          if (marginEl) marginEl.textContent = `+${margin}%`;
        } else {
          if (marginEl) marginEl.textContent = "0.0%";
        }
      };

      costInput?.addEventListener("input", updateMargin);
      priceInput?.addEventListener("input", updateMargin);

      if (btnSave) {
        btnSave.addEventListener("click", async () => {
          const nameInput = document.getElementById("drawer-name") as HTMLInputElement | null;
          const skuInput = document.getElementById("drawer-sku") as HTMLInputElement | null;
          const eanInput = document.getElementById("drawer-ean") as HTMLInputElement | null;
          const catSelect = document.getElementById("drawer-category") as HTMLSelectElement | null;
          const locInput = document.getElementById("drawer-location") as HTMLInputElement | null;
          const stockInput = document.getElementById("drawer-stock-initial") as HTMLInputElement | null;
          const minInput = document.getElementById("drawer-stock-min") as HTMLInputElement | null;

          const nombre = nameInput?.value.trim();
          const sku = skuInput?.value.trim();
          const categoria_id = catSelect?.value;
          const precio_compra = Number(costInput?.value) || 0;
          const precio_venta = Number(priceInput?.value) || 0;
          const stock_inicial = Number(stockInput?.value) || 0;
          const stock_minimo = Number(minInput?.value) || 5;
          const ubicacion = locInput?.value.trim() || "";
          const codigo_barras = eanInput?.value.trim() || "";

          if (!nombre) {
            alert("Por favor ingrese el nombre del producto.");
            nameInput?.focus();
            return;
          }
          if (!sku) {
            alert("Por favor ingrese un SKU.");
            skuInput?.focus();
            return;
          }
          if (!categoria_id) {
            alert("Por favor seleccione una categoría.");
            catSelect?.focus();
            return;
          }

          try {
            btnSave.setAttribute("disabled", "true");
            btnSave.innerHTML = `<span class="material-symbols-outlined text-[18px] animate-spin">sync</span><span>Guardando...</span>`;

            const res = await fetch(`${API_BASE}/inventario/producto`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                nombre,
                sku,
                categoria_id,
                precio_compra,
                precio_venta,
                stock_inicial,
                stock_minimo,
                ubicacion,
                codigo_barras,
              }),
            });

            const json = await res.json();
            if (json.success) {
              showInventoryToast(`Producto "${nombre}" registrado con éxito.`);
              closeProductDrawer();
              // Limpiar formulario
              if (nameInput) nameInput.value = "";
              if (skuInput) skuInput.value = "SKU-";
              if (eanInput) eanInput.value = "";
              if (costInput) costInput.value = "";
              if (priceInput) priceInput.value = "";
              if (locInput) locInput.value = "";
              // Refrescar inventario y métricas
              fetchInventory();
              fetchKpis();
              fetchCategories();
            } else {
              alert(json.error || "No se pudo registrar el producto.");
            }
          } catch (err) {
            console.error("Error al registrar producto:", err);
            alert("Error al conectar con el servidor.");
          } finally {
            btnSave.removeAttribute("disabled");
            btnSave.innerHTML = `<span class="material-symbols-outlined text-[18px]">save</span><span>Guardar Producto</span>`;
          }
        });
      }
    }

    // 7. Configuración de filtros reactivos
    function setupFilters() {
      const searchInput = document.getElementById("inventory-search") as HTMLInputElement | null;
      const catSelect = document.getElementById("filter-category") as HTMLSelectElement | null;
      const statusSelect = document.getElementById("filter-status") as HTMLSelectElement | null;
      const btnReset = document.getElementById("btn-reset-filters");

      let debounceTimer: any = null;

      const triggerFilter = () => {
        const q = searchInput?.value.trim() || "";
        const c = catSelect?.value || "";
        const s = statusSelect?.value || "";
        fetchInventory(q, c, s);
      };

      searchInput?.addEventListener("input", () => {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(triggerFilter, 250);
      });

      catSelect?.addEventListener("change", triggerFilter);
      statusSelect?.addEventListener("change", triggerFilter);

      btnReset?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        if (catSelect) catSelect.value = "";
        if (statusSelect) statusSelect.value = "";
        triggerFilter();
      });
    }

    // Inicializar eventos y micro-interacciones de inventario
    function setupInventory() {
      initInventoryAnimations();
      setupDrawerForm();
      setupFilters();

      // Cargar datos en vivo
      fetchInventory();
      fetchKpis();
      fetchCategories();
    }

    // Escuchar eventos globales de actualización
    window.addEventListener("categoriaActualizada", () => {
      fetchCategories();
      fetchInventory();
      fetchKpis();
    });

    window.addEventListener("inventarioActualizado", () => {
      fetchInventory();
      fetchKpis();
      fetchCategories();
    });

    document.addEventListener("astro:page-load", setupInventory);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupInventory);
    } else {
      setupInventory();
    }
  </script>
</Layout>
