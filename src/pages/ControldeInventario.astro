  </div>

  <!-- Notification Toast Global de Inventario -->
  <div
    id="inventory-toast"
    class="fixed bottom-6 right-6 bg-primary text-on-primary px-4 py-3 rounded-xl shadow-xl flex items-center gap-2.5 z-50 pointer-events-none opacity-0 translate-y-20 transition-all duration-300"
  >
    <span id="inventory-toast-icon" class="material-symbols-outlined text-secondary-fixed text-[20px]">
      check_circle
    </span>
    <span id="inventory-toast-text" class="text-[13px] font-medium">
      Producto registrado exitosamente en el catálogo.
    </span>
  </div>

  <!-- Componente Modal de Gestión y Creación de Categorías -->
  <AggCategoria />

  <!-- Componente Modal de Carga Masiva de Productos -->
  <CarMasivaProductos />

  <script>
    import {
      initInventoryAnimations,
      openProductDrawer,
      closeProductDrawer,
      showInventoryToast,
    } from "../animaciones/animaInventario.js";
    import { getApiUrl } from "../scripts/apiConfig.js";

    const API_BASE = getApiUrl();

    // Exponer funciones necesarias al scope global
    (window as any).openProductDrawer = openProductDrawer;
    (window as any).closeProductDrawer = closeProductDrawer;
    (window as any).showInventoryToast = showInventoryToast;

    // Vincular apertura del modal de categorías
    (window as any).onOpenCategoryModal = function() {
      if (typeof (window as any).openCategoryModal === "function") {
        (window as any).openCategoryModal();
      }
    };

    // Vincular apertura del modal de carga masiva
    (window as any).onOpenBulkUploadModal = function() {
      if (typeof (window as any).openBulkUploadModal === "function") {
        (window as any).openBulkUploadModal();
      }
    };

    // Formatear COP en el cliente
    function formatCOP(val: number | string) {
      const num = Number(val) || 0;
      return new Intl.NumberFormat("es-CO", {
        style: "currency",
        currency: "COP",
        maximumFractionDigits: 0,
      }).format(num);
    }

    let masterInventoryList: any[] = [];
    let allInventoryItems: any[] = [];
    let inventoryCurrentPage = 1;
    let inventoryPageSize = 10;

    function normalizeText(str: any) {
      return String(str || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim();
    }

    // Aplica filtros de búsqueda, salud de stock y ordenamiento
    function applyFiltersAndSort(items: any[], search: string, status: string, sort: string) {
      let filtered = [...items];

      // Filtro de texto (insensible a tildes y mayúsculas/minúsculas)
      if (search) {
        const q = normalizeText(search);
        filtered = filtered.filter((it: any) => {
          const name = normalizeText(it.nombre);
          const sku = normalizeText(it.sku);
          const ean = normalizeText(it.codigo_barras);
          return name.includes(q) || sku.includes(q) || ean.includes(q);
        });
      }

      // Filtro de salud de stock
      if (status === "urgente") {
        filtered = filtered.filter((it: any) => (Number(it.stock_actual) || 0) <= 4);
      } else if (status === "proximo") {
        filtered = filtered.filter((it: any) => {
          const st = Number(it.stock_actual) || 0;
          return st >= 5 && st <= 6;
        });
      } else if (status === "ok") {
        filtered = filtered.filter((it: any) => (Number(it.stock_actual) || 0) >= 7);
      } else if (status === "zero") {
        filtered = filtered.filter((it: any) => (Number(it.stock_actual) || 0) === 0);
      }

      // Filtros especiales de existencias
      if (sort === "has_stock") {
        filtered = filtered.filter((it: any) => (Number(it.stock_actual) || 0) > 0);
      } else if (sort === "no_stock") {
        filtered = filtered.filter((it: any) => (Number(it.stock_actual) || 0) === 0);
      }

      // Criterios de ordenamiento
      if (sort === "alpha_asc" || !sort || sort === "has_stock" || sort === "no_stock") {
        filtered.sort((a: any, b: any) => (a.nombre || "").localeCompare(b.nombre || "", "es", { sensitivity: "base" }));
      } else if (sort === "alpha_desc") {
        filtered.sort((a: any, b: any) => (b.nombre || "").localeCompare(a.nombre || "", "es", { sensitivity: "base" }));
      } else if (sort === "stock_desc") {
        filtered.sort((a: any, b: any) => (Number(b.stock_actual) || 0) - (Number(a.stock_actual) || 0));
      } else if (sort === "stock_asc") {
        filtered.sort((a: any, b: any) => (Number(a.stock_actual) || 0) - (Number(b.stock_actual) || 0));
      } else if (sort === "price_desc") {
        filtered.sort((a: any, b: any) => (Number(b.precio_venta) || 0) - (Number(a.precio_venta) || 0));
      } else if (sort === "price_asc") {
        filtered.sort((a: any, b: any) => (Number(a.precio_venta) || 0) - (Number(b.precio_venta) || 0));
      }

      return filtered;
    }

    // Filtrado instantáneo en memoria para respuesta a 0ms
    function triggerLocalFilter() {
      const searchInput = document.getElementById("inventory-search") as HTMLInputElement | null;
      const statusSelect = document.getElementById("filter-status") as HTMLSelectElement | null;
      const sortSelect = document.getElementById("filter-sort") as HTMLSelectElement | null;

      const search = searchInput?.value.trim() || "";
      const status = statusSelect?.value || "";
      const sort = sortSelect?.value || "alpha_asc";

      if (masterInventoryList.length > 0) {
        allInventoryItems = applyFiltersAndSort(masterInventoryList, search, status, sort);
        inventoryCurrentPage = 1;
        renderPaginatedInventory();
      }
    }

    // 1. Cargar productos desde la base de datos con ordenamiento alfabético y filtros
    async function fetchInventory(searchParam?: string, statusParam?: string, sortParam?: string) {
      try {
        const searchInput = document.getElementById("inventory-search") as HTMLInputElement | null;
        const statusSelect = document.getElementById("filter-status") as HTMLSelectElement | null;
        const sortSelect = document.getElementById("filter-sort") as HTMLSelectElement | null;

        const search = searchParam !== undefined ? searchParam : (searchInput?.value.trim() || "");
        const status = statusParam !== undefined ? statusParam : (statusSelect?.value || "");
        const sort = sortParam !== undefined ? sortParam : (sortSelect?.value || "alpha_asc");

        const params = new URLSearchParams();
        if (search) {
          params.append("search", search);
          params.append("q", search);
        }
        if (status) params.append("salud", status);
        if (sort && !["has_stock", "no_stock"].includes(sort)) {
          params.append("sort", sort);
        }
        params.append("limit", "500");

        const res = await fetch(`${API_BASE}/inventario?${params.toString()}`);
        if (!res.ok) throw new Error("HTTP error " + res.status);
        const json = await res.json();
        if (json.success && json.data) {
          const items: any[] = json.data.items || [];
          if (!search && !status && (sort === "alpha_asc" || !sort)) {
            masterInventoryList = [...items];
          }
          allInventoryItems = applyFiltersAndSort(items, search, status, sort);
          inventoryCurrentPage = 1;
          renderPaginatedInventory();
        }
      } catch (err) {
        console.error("Error al cargar inventario:", err);
      }
    }

    function renderPaginatedInventory() {
      const totalItems = allInventoryItems.length;
      const totalPages = Math.ceil(totalItems / inventoryPageSize) || 1;

      if (inventoryCurrentPage > totalPages) inventoryCurrentPage = totalPages;
      if (inventoryCurrentPage < 1) inventoryCurrentPage = 1;

      const startIndex = (inventoryCurrentPage - 1) * inventoryPageSize;
      const endIndex = Math.min(startIndex + inventoryPageSize, totalItems);
      const pageItems = allInventoryItems.slice(startIndex, endIndex);

      renderTableRows(pageItems);

      const pagInfo = document.getElementById("inventory-pagination-info");
      if (pagInfo) {
        if (totalItems === 0) {
          pagInfo.innerHTML = `Mostrando <strong class="text-on-surface font-semibold">0</strong> de <strong class="text-on-surface font-semibold">0</strong> artículos`;
        } else {
          pagInfo.innerHTML = `Mostrando <strong class="text-on-surface font-semibold">${startIndex + 1}-${endIndex}</strong> de <strong class="text-on-surface font-semibold">${totalItems}</strong> artículos`;
        }
      }

      const controls = document.getElementById("inventory-pagination-controls");
      if (!controls) return;

      if (totalItems === 0) {
        controls.innerHTML = "";
        return;
      }

      let html = "";
      const isFirst = inventoryCurrentPage === 1;
      const isLast = inventoryCurrentPage === totalPages;

      // First page
      html += `
        <button
          class="h-7 w-7 rounded-lg bg-surface text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest flex items-center justify-center transition-colors disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
          ${isFirst ? "disabled" : ""}
          onclick="window.goToInventoryPage(1)"
          title="Primera página"
          type="button"
        >
          <span class="material-symbols-outlined text-[16px]">first_page</span>
        </button>
      `;

      // Prev
      html += `
        <button
          class="h-7 w-7 rounded-lg bg-surface text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest flex items-center justify-center transition-colors disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
          ${isFirst ? "disabled" : ""}
          onclick="window.goToInventoryPage(${inventoryCurrentPage - 1})"
          title="Página anterior"
          type="button"
        >
          <span class="material-symbols-outlined text-[16px]">chevron_left</span>
        </button>
      `;

      // Page numbers (smart window)
      for (let p = 1; p <= totalPages; p++) {
        if (totalPages <= 7 || p === 1 || p === totalPages || (p >= inventoryCurrentPage - 1 && p <= inventoryCurrentPage + 1)) {
          if (p === inventoryCurrentPage) {
            html += `
              <button class="h-7 px-2.5 rounded-lg bg-primary text-on-primary text-[12px] font-bold shadow-xs cursor-default" type="button">${p}</button>
            `;
          } else {
            html += `
              <button class="h-7 px-2.5 rounded-lg bg-surface hover:bg-surface-container-lowest text-on-surface text-[12px] font-medium cursor-pointer transition-colors" onclick="window.goToInventoryPage(${p})" type="button">${p}</button>
            `;
          }
        } else if (p === inventoryCurrentPage - 2 || p === inventoryCurrentPage + 2) {
          html += `<span class="text-[12px] text-on-surface-variant px-1 select-none">...</span>`;
        }
      }

      // Next
      html += `
        <button
          class="h-7 w-7 rounded-lg bg-surface text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest flex items-center justify-center transition-colors disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
          ${isLast ? "disabled" : ""}
          onclick="window.goToInventoryPage(${inventoryCurrentPage + 1})"
          title="Página siguiente"
          type="button"
        >
          <span class="material-symbols-outlined text-[16px]">chevron_right</span>
        </button>
      `;

      // Last page
      html += `
        <button
          class="h-7 w-7 rounded-lg bg-surface text-on-surface-variant hover:text-on-surface hover:bg-surface-container-lowest flex items-center justify-center transition-colors disabled:opacity-30 disabled:cursor-not-allowed cursor-pointer"
          ${isLast ? "disabled" : ""}
          onclick="window.goToInventoryPage(${totalPages})"
          title="Última página"
          type="button"
        >
          <span class="material-symbols-outlined text-[16px]">last_page</span>
        </button>
      `;

      controls.innerHTML = html;
    }

    (window as any).goToInventoryPage = function(page: number) {
      inventoryCurrentPage = page;
      renderPaginatedInventory();
    };

    // 2. Cargar KPIs desde la base de datos
    async function fetchKpis() {
      try {
        const res = await fetch(`${API_BASE}/inventario/kpis`);
        if (!res.ok) throw new Error("HTTP error " + res.status);
        const json = await res.json();
        if (json.success && json.data) {
          const k = json.data;
          const totalSkusEl = document.getElementById("kpi-total-skus");
          const valEl = document.getElementById("kpi-valorizacion");
          const alertaEl = document.getElementById("kpi-alerta-count");
          const rotEl = document.getElementById("kpi-rotacion");

          if (totalSkusEl) totalSkusEl.textContent = String(k.total_skus || 0);
          if (valEl) valEl.textContent = k.valorizacion_formato || "$ 0";
          if (alertaEl) alertaEl.textContent = String(k.en_alerta || 0);
          if (rotEl) rotEl.textContent = String(k.rotacion_dias || 0);
        }
      } catch (err) {
        console.error("Error al cargar KPIs:", err);
      }
    }

    // 3. Cargar categorías dinámicas en los selectores
    async function fetchCategories() {
      try {
        const res = await fetch(`${API_BASE}/categorias`);
        if (!res.ok) throw new Error("HTTP error " + res.status);
        const json = await res.json();
        if (json.success && json.data && Array.isArray(json.data.categorias)) {
          const cats = json.data.categorias;

          // Selector del Drawer (Categoría para nuevo/editar producto)
          const drawerCat = document.getElementById("drawer-category") as HTMLSelectElement | null;
          if (drawerCat) {
            drawerCat.innerHTML = `<option value="">Seleccione categoría...</option>` +
              cats.map((c: any) => `<option value="${c.id}">${c.nombre} (${c.prefijo || "GEN"})</option>`).join("");
          }
        }
      } catch (err) {
        console.error("Error al cargar categorías:", err);
      }
    }

    // Renderizar filas de la tabla de inventario
    function renderTableRows(items: any[]) {
      const tbody = document.getElementById("inventory-table-body");
      if (!tbody) return;

      if (!items || items.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="10" class="px-4 py-12 text-center text-on-surface-variant">
              No se encontraron productos que coincidan con los filtros aplicados.
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = items
        .map((item) => {
          const icon = item.tipo === "FISICO" ? "inventory_2" : item.tipo === "CONSUMIBLE" ? "format_paint" : "build";
          return `
            <tr
              class="inventory-row h-12 hover:bg-surface-container-low transition-colors group"
              data-id="${item.id}"
              data-category="${item.categoria_id}"
              data-status="${item.salud_status}"
            >
              <td class="px-3 py-2 text-center">
                <input class="row-checkbox w-4 h-4 rounded text-secondary-container focus:ring-0 cursor-pointer" type="checkbox" value="${item.id}" />
              </td>
              <td class="px-3 py-2 font-semibold text-primary">
                ${item.sku}
                <div class="text-[11px] text-on-surface-variant font-normal">${item.codigo_barras || "S/C"}</div>
              </td>
              <td class="px-3 py-2">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center shrink-0 text-on-surface-variant">
                    <span class="material-symbols-outlined text-[19px]">${icon}</span>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-semibold text-on-surface truncate">${item.nombre}</span>
                    <span class="text-[11px] text-on-surface-variant truncate">${item.tipo || "Producto físico"}</span>
                  </div>
                </div>
              </td>
              <td class="px-3 py-2">
                <span class="px-2 py-0.5 rounded-lg bg-surface-container text-[11px] text-on-surface font-medium">
                  ${item.categoria || "General"}
                </span>
              </td>
              <td class="px-3 py-2 text-right text-on-surface-variant font-medium">${item.precio_compra_formato}</td>
              <td class="px-3 py-2 text-right text-on-surface font-bold">${item.precio_venta_formato}</td>
              <td class="px-3 py-2 text-right">
                <span class="text-[11px] text-on-tertiary-container font-semibold bg-surface-container-high px-1.5 py-0.5 rounded-lg">
                  ${item.margen_porcentaje}
                </span>
              </td>
              <td class="px-3 py-2 text-center">
                <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-lg text-[11px] ${item.badge_class}">
                  <span class="w-1.5 h-1.5 rounded-full ${item.dot_class}"></span>
                  <span>${item.salud_label}</span>
                </div>
              </td>
              <td class="px-3 py-2 text-[12px] text-on-surface-variant">${item.ubicacion || "Bodega Central"}</td>
              <td class="px-4 py-2 text-right">
                <div class="flex items-center justify-end gap-1 opacity-80 group-hover:opacity-100 transition-opacity">
                  <button
                    class="p-1 text-on-surface-variant hover:text-secondary-container hover:bg-surface-container rounded-lg cursor-pointer"
                    title="Actualizar Producto"
                    type="button"
                    onclick="window.openEditProductDrawer && window.openEditProductDrawer('${item.id}')"
                  >
                    <span class="material-symbols-outlined text-[18px]">edit</span>
                  </button>
                  <button
                    class="p-1 text-on-surface-variant hover:text-error hover:bg-error-container/40 rounded-lg cursor-pointer"
                    title="Eliminar producto"
                    type="button"
                    onclick="window.deleteProductItem && window.deleteProductItem('${item.id}', '${item.nombre}')"
                  >
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                  </button>
                </div>
              </td>
            </tr>
          `;
        })
        .join("");
    }

    // 4. Ajuste rápido de stock vía PATCH
    (window as any).quickAdjustStock = async function(id: string, sku: string, currentStock: number) {
      const input = prompt(`Ajustar stock para ${sku} (Stock actual: ${currentStock}):\nIngrese la nueva cantidad:`, String(currentStock));
      if (input === null) return;
      const nuevaCantidad = parseInt(input.trim(), 10);
      if (isNaN(nuevaCantidad) || nuevaCantidad < 0) {
        alert("Por favor ingrese un número entero válido mayor o igual a 0.");
        return;
      }

      try {
        const res = await fetch(`${API_BASE}/inventario/producto/${id}/stock`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            cantidad: nuevaCantidad,
            motivo: "Ajuste manual desde panel de control",
          }),
        });
        const json = await res.json();
        if (json.success) {
          showInventoryToast(`Stock de ${sku} actualizado a ${nuevaCantidad} unidades.`);
          fetchInventory();
          fetchKpis();
        } else {
          alert(json.error || "No se pudo actualizar el stock.");
        }
      } catch (err) {
        console.error("Error al actualizar stock:", err);
        alert("Error de conexión con el servidor.");
      }
    };

    // 5. Eliminar producto vía DELETE
    (window as any).deleteProductItem = async function(id: string, name: string) {
      if (!confirm(`¿Estás seguro de eliminar el producto "${name}" del catálogo?`)) return;

      try {
        const res = await fetch(`${API_BASE}/inventario/producto/${id}`, {
          method: "DELETE",
        });
        const json = await res.json();
        if (json.success) {
          showInventoryToast(`Producto "${name}" eliminado del catálogo.`);
          fetchInventory();
          fetchKpis();
          fetchCategories();
        } else {
          alert(json.error || "No se pudo eliminar el producto.");
        }
      } catch (err) {
        console.error("Error al eliminar producto:", err);
        alert("Error de conexión con el servidor.");
      }
    };

    // 6. Guardar / Reabastecer / Editar producto desde el Drawer con persistencia de modo y edición directa de Stock Total
    function setupDrawerForm() {
      const btnSave = document.getElementById("btn-save-drawer");
      const costInput = document.getElementById("drawer-cost") as HTMLInputElement | null;
      const priceInput = document.getElementById("drawer-price") as HTMLInputElement | null;
      const marginEl = document.getElementById("drawer-margin");
      const skuInput = document.getElementById("drawer-sku") as HTMLInputElement | null;
      const eanInput = document.getElementById("drawer-ean") as HTMLInputElement | null;
      const nameInput = document.getElementById("drawer-name") as HTMLInputElement | null;
      const catSelect = document.getElementById("drawer-category") as HTMLSelectElement | null;
      const locInput = document.getElementById("drawer-location") as HTMLInputElement | null;
      const stockInput = document.getElementById("drawer-stock-initial") as HTMLInputElement | null;
      const minInput = document.getElementById("drawer-stock-min") as HTMLInputElement | null;
      const stockLabel = document.getElementById("drawer-stock-label");
      const alertBox = document.getElementById("drawer-existing-alert");
      const descEl = document.getElementById("drawer-existing-desc");
      const supplierSelect = document.getElementById("drawer-supplier") as HTMLSelectElement | null;
      const hTitle = document.getElementById("drawer-header-title");
      const hSub = document.getElementById("drawer-header-subtitle");

      const stockSecTitle = document.getElementById("drawer-stock-section-title");
      const stockBadge = document.getElementById("drawer-stock-badge");
      const stockHint = document.getElementById("drawer-stock-hint");
      const reabastecerBox = document.getElementById("drawer-reabastecer-box");
      const stockAddInput = document.getElementById("drawer-stock-add") as HTMLInputElement | null;

      let existingProduct: any = null;

      // Restablecer modo normal de creación
      function resetExistingMode() {
        existingProduct = null;
        if (alertBox) alertBox.classList.add("hidden");
        if (hTitle) hTitle.textContent = "Agregar Producto";
        if (hSub) hSub.textContent = "Flujo de alta en catálogo maestro de almacén";

        if (stockSecTitle) stockSecTitle.textContent = "Gestión de Stock Inicial";
        if (stockBadge) stockBadge.classList.add("hidden");
        if (stockHint) stockHint.classList.add("hidden");
        if (reabastecerBox) reabastecerBox.classList.add("hidden");
        if (stockAddInput) stockAddInput.value = "";

        if (nameInput) {
          nameInput.readOnly = false;
          nameInput.classList.remove("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }
        if (skuInput) {
          skuInput.readOnly = false;
          skuInput.classList.remove("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }
        if (eanInput) {
          eanInput.readOnly = false;
          eanInput.classList.remove("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }
        if (catSelect) {
          catSelect.disabled = false;
          catSelect.classList.remove("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }
        if (locInput) {
          locInput.readOnly = false;
          locInput.classList.remove("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }
        if (minInput) {
          minInput.readOnly = false;
          minInput.classList.remove("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }
        if (stockLabel) {
          stockLabel.textContent = "Cantidad Inicial (Ingreso) *";
        }
        if (btnSave) {
          btnSave.innerHTML = `<span class="material-symbols-outlined text-[18px]">save</span><span>Guardar Producto</span>`;
          btnSave.classList.remove("bg-emerald-600", "hover:bg-emerald-700");
          btnSave.classList.add("bg-secondary-container", "hover:bg-secondary");
        }
      }

      // Aplica un producto existente al Drawer en modo actualización y edición directa de Stock Total
      function applyProductToDrawer(p: any) {
        existingProduct = p;

        if (hTitle) hTitle.textContent = "Actualizar Producto";
        if (hSub) hSub.textContent = "Edición directa de existencias en BD y datos comerciales";

        if (alertBox) alertBox.classList.remove("hidden");
        if (descEl) {
          descEl.innerHTML = `Producto <strong>"${p.nombre}"</strong> (SKU: ${p.sku}) cargado. Los datos maestros están protegidos. <strong>Puedes modificar:</strong> Stock Total en Almacén, Alerta de Stock Mínimo, Precio de Compra, Precio de Venta y Proveedor.`;
        }

        // Bloquear datos maestros
        if (nameInput) {
          nameInput.value = p.nombre || "";
          nameInput.readOnly = true;
          nameInput.classList.add("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }
        if (skuInput) {
          skuInput.value = p.sku || "";
          skuInput.readOnly = true;
          skuInput.classList.add("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }
        if (eanInput) {
          eanInput.value = p.codigo_barras || "";
          eanInput.readOnly = true;
          eanInput.classList.add("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }
        if (catSelect) {
          catSelect.value = p.categoria_id || "";
          catSelect.disabled = true;
          catSelect.classList.add("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }
        if (locInput) {
          locInput.value = p.ubicacion || "";
          locInput.readOnly = true;
          locInput.classList.add("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }

        // Habilitar edición directa de stock total y stock mínimo en la BD
        const currentStock = Number(p.stock_actual) || 0;
        if (stockSecTitle) stockSecTitle.textContent = "Control de Stock en Base de Datos";
        if (stockBadge) stockBadge.classList.remove("hidden");
        if (stockHint) stockHint.classList.remove("hidden");
        if (reabastecerBox) reabastecerBox.classList.remove("hidden");
        if (stockAddInput) stockAddInput.value = "";

        if (stockLabel) {
          stockLabel.innerHTML = `Stock Total en BD <span class="text-secondary font-bold">(Actual: ${currentStock} unid.)</span> *`;
        }
        if (stockInput) {
          stockInput.value = String(currentStock);
        }

        if (minInput) {
          minInput.value = String(p.stock_minimo !== undefined ? p.stock_minimo : 5);
          minInput.readOnly = false;
          minInput.classList.remove("bg-surface-container", "opacity-75", "cursor-not-allowed");
        }

        // Precios habilitados para modificar
        if (costInput) costInput.value = String(p.precio_compra ?? 0);
        if (priceInput) priceInput.value = String(p.precio_venta ?? 0);

        updateMargin();

        // Botón: '+' dentro del círculo con el texto 'Actualizar Producto'
        if (btnSave) {
          btnSave.innerHTML = `<span class="material-symbols-outlined text-[18px]">add_circle</span><span>Actualizar Producto</span>`;
          btnSave.classList.remove("bg-secondary-container", "hover:bg-secondary");
          btnSave.classList.add("bg-emerald-600", "hover:bg-emerald-700");
        }
      }

      // Sincronización entre input de suma rápida y el stock total
      stockAddInput?.addEventListener("input", () => {
        if (!existingProduct) return;
        const base = Number(existingProduct.stock_actual) || 0;
        const add = Number(stockAddInput.value) || 0;
        if (stockInput) {
          stockInput.value = String(Math.max(0, base + add));
        }
      });

      // Exponer apertura en modo edición/actualización por ID para las acciones de la tabla
      (window as any).openEditProductDrawer = async function(productId: string) {
        if (!productId) return;
        resetExistingMode();
        openProductDrawer();
        try {
          const res = await fetch(`${API_BASE}/inventario/producto/${productId}`);
          const json = await res.json();
          if (json.success && json.data) {
            applyProductToDrawer(json.data);
          } else {
            alert(json.error || "No se pudo obtener la información del producto.");
          }
        } catch (err) {
          console.error("Error al cargar producto para edición:", err);
          alert("Error de conexión al cargar el producto.");
        }
      };
      (window as any).quickAdjustStock = (window as any).openEditProductDrawer;

      // Averigua con la BD si el producto ya existe por SKU o Código de Barras
      async function checkForExistingProduct(code: string) {
        if (existingProduct) return; // Si ya se está editando un producto, no re-verificar
        const clean = (code || "").trim();
        if (!clean || clean.length < 3 || clean === "SKU-" || clean === "SKU-2024-") {
          return;
        }

        try {
          const res = await fetch(`${API_BASE}/inventario/producto/verificar-codigo?codigo=${encodeURIComponent(clean)}`);
          if (!res.ok) return;
          const json = await res.json();

          if (json.exists && json.producto) {
            applyProductToDrawer(json.producto);
          }
        } catch (e) {
          console.warn("Error al verificar código de producto:", e);
        }
      }

      // Cálculo de margen en tiempo real en el Drawer
      const updateMargin = () => {
        const cost = Number(costInput?.value) || 0;
        const price = Number(priceInput?.value) || 0;
        if (price > 0 && cost > 0) {
          const margin = (((price - cost) / price) * 100).toFixed(1);
          if (marginEl) marginEl.textContent = `+${margin}%`;
        } else {
          if (marginEl) marginEl.textContent = "0.0%";
        }
      };

      costInput?.addEventListener("input", updateMargin);
      priceInput?.addEventListener("input", updateMargin);

      // Verificación en tiempo real al escribir o escanear (sólo si no estamos en modo edición)
      skuInput?.addEventListener("blur", () => {
        if (existingProduct) return;
        if (skuInput.value && skuInput.value.trim().length >= 4) {
          checkForExistingProduct(skuInput.value);
        }
      });

      eanInput?.addEventListener("blur", () => {
        if (existingProduct) return;
        if (eanInput.value && eanInput.value.trim().length >= 3) {
          checkForExistingProduct(eanInput.value);
        }
      });

      eanInput?.addEventListener("change", () => {
        if (existingProduct) return;
        if (eanInput.value && eanInput.value.trim().length >= 3) {
          checkForExistingProduct(eanInput.value);
        }
      });

      const catSelectEl = document.getElementById("drawer-category") as HTMLSelectElement | null;
      catSelectEl?.addEventListener("change", () => {
        if (existingProduct) return;
        if (!skuInput) return;
        const optText = catSelectEl.options[catSelectEl.selectedIndex]?.text || "";
        const match = optText.match(/\(([^)]+)\)/);
        const pref = match ? match[1] : "GEN";
        const numMatch = skuInput.value.match(/\d+/);
        const num = numMatch ? numMatch[0] : String(Math.floor(1000 + Math.random() * 9000));
        skuInput.value = `SKU-${num}-${pref}`;
      });

      // Apertura desde botón "+ Agregar Producto"
      document.getElementById("btn-open-drawer")?.addEventListener("click", () => {
        resetExistingMode();
        if (nameInput) nameInput.value = "";
        if (skuInput) skuInput.value = "SKU-";
        if (eanInput) eanInput.value = "";
        if (costInput) costInput.value = "";
        if (priceInput) priceInput.value = "";
        if (locInput) locInput.value = "";
        if (stockInput) stockInput.value = "10";
        if (catSelect) catSelect.value = "";
        updateMargin();
      });

      // PREVENCIÓN DE BUGS DE CLIC:
      // Cualquier clic dentro de drawer-panel no debe propagarse al backdrop
      const drawerPanel = document.getElementById("drawer-panel");
      drawerPanel?.addEventListener("click", (e) => {
        e.stopPropagation();
      });

      // Botones cancelar / cerrar
      document.getElementById("btn-cancel-drawer")?.addEventListener("click", (e) => {
        e.stopPropagation();
        resetExistingMode();
        closeProductDrawer();
      });
      document.getElementById("btn-close-drawer")?.addEventListener("click", (e) => {
        e.stopPropagation();
        resetExistingMode();
        closeProductDrawer();
      });

      // Cerrar solo si se hace clic explícitamente en el fondo oscuro (backdrop)
      const drawerBackdrop = document.getElementById("drawer-backdrop");
      drawerBackdrop?.addEventListener("click", (e) => {
        if (e.target === drawerBackdrop) {
          resetExistingMode();
          closeProductDrawer();
        }
      });

      if (btnSave) {
        btnSave.addEventListener("click", async () => {
          const isExisting = Boolean(existingProduct);
          const id = existingProduct?.id || null;
          const nombre = nameInput?.value.trim() || existingProduct?.nombre;
          const sku = skuInput?.value.trim() || existingProduct?.sku;
          const categoria_id = catSelect?.value || existingProduct?.categoria_id;
          const precio_compra = Number(costInput?.value) || 0;
          const precio_venta = Number(priceInput?.value) || 0;
          const stock_total = isExisting ? (Number(stockInput?.value) || 0) : undefined;
          const stock_inicial = isExisting ? 0 : (Number(stockInput?.value) || 0);
          const stock_minimo = Number(minInput?.value) || 5;
          const ubicacion = locInput?.value.trim() || existingProduct?.ubicacion || "";
          const codigo_barras = eanInput?.value.trim() || existingProduct?.codigo_barras || "";
          const proveedor = supplierSelect?.value || "";

          if (!nombre) {
            alert("Por favor ingrese el nombre del producto.");
            nameInput?.focus();
            return;
          }
          if (!sku) {
            alert("Por favor ingrese un SKU.");
            skuInput?.focus();
            return;
          }
          if (!categoria_id) {
            alert("Por favor seleccione una categoría.");
            catSelect?.focus();
            return;
          }
          if (!precio_compra || precio_compra <= 0) {
            alert("El precio de compra es obligatorio y debe ser mayor a 0.");
            costInput?.focus();
            return;
          }
          if (!precio_venta || precio_venta <= 0) {
            alert("El precio de venta es obligatorio y debe ser mayor a 0.");
            priceInput?.focus();
            return;
          }

          try {
            btnSave.setAttribute("disabled", "true");
            btnSave.innerHTML = `<span class="material-symbols-outlined text-[18px] animate-spin">sync</span><span>Guardando...</span>`;

            const res = await fetch(`${API_BASE}/inventario/producto`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                id,
                nombre,
                sku,
                categoria_id,
                precio_compra,
                precio_venta,
                stock_total,
                stock_inicial,
                stock_minimo,
                ubicacion,
                codigo_barras,
                proveedor,
              }),
            });

            const json = await res.json();
            if (json.success) {
              if (json.reabastecido) {
                showInventoryToast(json.message || `Producto "${nombre}" actualizado con éxito.`);
              } else {
                showInventoryToast(`Producto "${nombre}" registrado con éxito en el catálogo.`);
              }
              closeProductDrawer();
              resetExistingMode();
              // Limpiar formulario
              if (nameInput) nameInput.value = "";
              if (skuInput) skuInput.value = "SKU-";
              if (eanInput) eanInput.value = "";
              if (costInput) costInput.value = "";
              if (priceInput) priceInput.value = "";
              if (locInput) locInput.value = "";
              if (stockInput) stockInput.value = "10";
              // Refrescar inventario y métricas
              fetchInventory();
              fetchKpis();
              fetchCategories();
            } else {
              alert(json.error || "No se pudo procesar el producto.");
            }
          } catch (err) {
            console.error("Error al registrar producto:", err);
            alert("Error al conectar con el servidor.");
          } finally {
            btnSave.removeAttribute("disabled");
            if (!existingProduct) {
              btnSave.innerHTML = `<span class="material-symbols-outlined text-[18px]">save</span><span>Guardar Producto</span>`;
            } else {
              btnSave.innerHTML = `<span class="material-symbols-outlined text-[18px]">add_circle</span><span>Actualizar Producto</span>`;
            }
          }
        });
      }
    }

    // 7. Configuración de filtros reactivos
    function setupFilters() {
      const searchInput = document.getElementById("inventory-search") as HTMLInputElement | null;
      const sortSelect = document.getElementById("filter-sort") as HTMLSelectElement | null;
      const statusSelect = document.getElementById("filter-status") as HTMLSelectElement | null;
      const pageSizeSelect = document.getElementById("inventory-page-size") as HTMLSelectElement | null;
      const btnReset = document.getElementById("btn-reset-filters");

      let debounceTimer: any = null;

      const triggerFilter = () => {
        inventoryCurrentPage = 1;
        triggerLocalFilter();
        fetchInventory();
      };

      searchInput?.addEventListener("input", () => {
        // Filtrado visual instantáneo en 0ms
        triggerLocalFilter();
        // Sincronización con el servidor backend
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          inventoryCurrentPage = 1;
          fetchInventory();
        }, 200);
      });

      searchInput?.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          searchInput.value = "";
          triggerFilter();
        }
      });

      sortSelect?.addEventListener("change", triggerFilter);
      statusSelect?.addEventListener("change", triggerFilter);

      pageSizeSelect?.addEventListener("change", (e: any) => {
        inventoryPageSize = parseInt(e.target.value, 10) || 10;
        inventoryCurrentPage = 1;
        renderPaginatedInventory();
      });

      btnReset?.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        if (statusSelect) statusSelect.value = "";
        if (sortSelect) sortSelect.value = "alpha_asc";
        inventoryCurrentPage = 1;
        triggerLocalFilter();
        fetchInventory("", "", "alpha_asc");
      });
    }

    // Inicializar eventos y micro-interacciones de inventario
    function setupInventory() {
      initInventoryAnimations();
      setupDrawerForm();
      setupFilters();

      // Cargar datos en vivo
      fetchInventory();
      fetchKpis();
      fetchCategories();
    }

    // Escuchar eventos globales de actualización
    window.addEventListener("categoriaActualizada", () => {
      fetchCategories();
      fetchInventory();
      fetchKpis();
    });

    window.addEventListener("inventarioActualizado", () => {
      fetchInventory();
      fetchKpis();
      fetchCategories();
    });

    document.addEventListener("astro:page-load", setupInventory);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupInventory);
    } else {
      setupInventory();
    }
  </script>
</Layout>
