          </div>

          <!-- Reabastecimiento rápido opcional en modo edición -->
          <div id="drawer-reabastecer-box" class="hidden pt-2 border-t border-surface-container/40 flex items-center justify-between text-[11px]">
            <span class="text-on-surface-variant">¿Deseas sumar unidades al stock total?</span>
            <div class="flex items-center gap-1.5">
              <span class="text-[11px] text-secondary font-semibold">+</span>
              <input
                id="drawer-stock-add"
