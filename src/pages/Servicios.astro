---
// Servicios.astro - Módulo de Gestión de Servicios Técnicos y Órdenes de Trabajo
import Layout from "../layouts/Layout.astro";
import SlideBar from "../components/SlideBar.astro";
import NavBar from "../components/Nav.astro";
---

<Layout title="Gestión de Servicios - StockControl Enterprise JR">
  <div class="min-h-screen bg-surface flex flex-col font-body-md text-on-surface">
    {/* Barra lateral y superior globales y responsivas */}
    <SlideBar currentPath="servicios" />
    <NavBar storeName="Central Sucursal 01" operationStatus="Taller Activo" />

    {/* Contenedor principal */}
    <div id="app-content" class="pt-16 min-h-screen flex flex-col flex-1">
      <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">

        <!-- Header Section with Quick Actions -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 flex-wrap w-full">
          <div class="max-w-3xl min-w-0">
            <div class="flex items-center gap-1.5 text-on-surface-variant text-[12px] uppercase tracking-wider mb-1 font-semibold">
              <span>Módulo Técnico</span>
              <span class="material-symbols-outlined text-[14px]">chevron_right</span>
              <span class="text-secondary">Servicios & Taller</span>
            </div>
            <h1 class="text-[24px] sm:text-[28px] font-bold text-primary tracking-tight">
              Gestión de Servicios
            </h1>
            <p class="text-[13px] sm:text-[14px] text-on-surface-variant mt-0.5 max-w-2xl">
              Catálogo de prestaciones técnicas, órdenes de trabajo, asignación de mano de obra y facturación de servicios.
            </p>
          </div>

          <div class="flex items-center flex-wrap gap-2.5 shrink-0 w-full sm:w-auto">
            <button
              id="btn-rates-contracts"
              class="h-[38px] px-3.5 bg-surface-container-lowest hover:bg-surface-container-low text-on-surface rounded-xl text-[12px] font-medium border border-surface-container/70 shadow-2xs hover:shadow-xs transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
              type="button"
              onclick="window.showServiceToast && window.showServiceToast('Tarifario corporativo de contratos descargado.', 'info')"
            >
              <span class="material-symbols-outlined text-[17px] text-on-surface-variant">receipt_long</span>
              <span>Tarifario & Contratos</span>
            </button>
            <button
              id="btn-new-service"
              class="h-[38px] px-4 bg-primary hover:bg-secondary text-on-primary rounded-xl text-[12px] font-semibold shadow-xs hover:shadow-md transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
              type="button"
            >
              <span class="material-symbols-outlined text-[18px]">add</span>
              <span>Registrar Nuevo Servicio</span>
            </button>
          </div>
        </div>

        <!-- KPI Metrics Grid (2 Big Responsive Bento Cards) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
          <!-- Card 1 -->
          <div class="service-kpi-card bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between relative overflow-hidden group hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
              <span class="text-[12px] text-on-surface-variant font-medium">Servicios realizados (Mes)</span>
              <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-tertiary-fixed text-tertiary-container flex items-center gap-0.5">
                <span class="material-symbols-outlined text-[13px]">arrow_upward</span>
                +18.4%
              </span>
            </div>
            <div class="mt-3">
              <div class="flex items-baseline gap-2">
                <span class="text-[26px] sm:text-[28px] font-bold text-on-surface">148</span>
                <span class="text-[12px] text-on-surface-variant font-medium">prestaciones técnicas</span>
              </div>
              <div class="flex items-center justify-between text-on-surface-variant mt-2 pt-2 bg-surface-container-low/60 -mx-4 sm:-mx-5 -mb-4 sm:-mb-5 px-4 sm:px-5 py-2 rounded-b-xl border-t border-surface-container/50">
                <span class="text-[11px] flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
                  32 en ejecución activa hoy
                </span>
                <span class="text-[11px] font-bold text-on-surface">Meta: 160</span>
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="service-kpi-card bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between relative overflow-hidden group hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
              <span class="text-[12px] text-on-surface-variant font-medium">Facturación por Servicios</span>
              <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-tertiary-fixed text-tertiary-container flex items-center gap-0.5">
                <span class="material-symbols-outlined text-[13px]">trending_up</span>
                +12.2%
              </span>
            </div>
            <div class="mt-3">
              <div class="flex items-baseline gap-1.5">
                <span class="text-[26px] sm:text-[28px] font-bold text-on-surface">$16,310.00</span>
                <span class="text-[12px] text-on-surface-variant font-medium">USD Mes</span>
              </div>
              <div class="flex items-center justify-between text-on-surface-variant mt-2 pt-2 bg-surface-container-low/60 -mx-4 sm:-mx-5 -mb-4 sm:-mb-5 px-4 sm:px-5 py-2 rounded-b-xl border-t border-surface-container/50">
                <span class="text-[11px] truncate">+12.2% margen operacional neto</span>
                <span class="text-[11px] font-bold text-on-surface">76.5% prom.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Operational Workspace: Tabs & Filtering -->
        <div class="bg-surface-container-lowest rounded-xl border border-surface-container/60 shadow-xs overflow-hidden flex flex-col">
          
          <!-- Horizontal Tab Navigation Bar -->
          <div class="flex flex-wrap items-center justify-between px-4 pt-2 bg-surface-container-low/40 gap-2 w-full border-b border-surface-container/60">
            <div class="flex items-center gap-1 overflow-x-auto flex-wrap sm:flex-nowrap">
              <button
                id="tab-service-catalog"
                class="px-3.5 py-2.5 text-[13px] font-semibold text-secondary-container bg-surface-container-lowest rounded-t-xl shadow-xs flex items-center gap-2 cursor-pointer transition-all"
                type="button"
                onclick="window.switchServiceTab && window.switchServiceTab('catalog')"
              >
                <span class="material-symbols-outlined text-[18px]">build_circle</span>
                <span>Catálogo de Servicios & Tarifas</span>
                <span class="px-1.5 py-0.2 bg-secondary-fixed text-on-secondary-fixed-variant text-[11px] font-bold rounded-full">
                  24
                </span>
              </button>
              <button
                id="tab-service-orders"
                class="px-3.5 py-2.5 text-[13px] font-medium text-on-surface-variant hover:text-on-surface rounded-t-xl hover:bg-surface-container/50 transition-colors flex items-center gap-2 cursor-pointer"
                type="button"
                onclick="window.switchServiceTab && window.switchServiceTab('orders')"
              >
                <span class="material-symbols-outlined text-[18px]">pending_actions</span>
                <span>Órdenes de Trabajo en Curso</span>
                <span class="px-1.5 py-0.2 bg-surface-container text-on-surface-variant text-[11px] font-bold rounded-full">
                  32
                </span>
              </button>
            </div>

            <div class="flex items-center gap-1.5 py-2 sm:py-0 shrink-0">
              <button
                class="h-8 px-3 bg-surface hover:bg-surface-container text-on-surface-variant hover:text-on-surface rounded-xl text-[12px] font-medium flex items-center gap-1 shadow-2xs transition-colors cursor-pointer border border-surface-container/60"
                title="Exportar CSV o Excel"
                type="button"
                onclick="window.showServiceToast && window.showServiceToast('Exportando catálogo de servicios a CSV...', 'info')"
              >
                <span class="material-symbols-outlined text-[16px]">file_download</span>
                <span>Exportar</span>
              </button>
              <button
                class="h-8 w-8 bg-surface hover:bg-surface-container text-on-surface-variant hover:text-on-surface rounded-xl flex items-center justify-center shadow-2xs transition-colors cursor-pointer border border-surface-container/60"
                title="Actualizar datos"
                type="button"
                onclick="window.showServiceToast && window.showServiceToast('Catálogo de tarifas sincronizado.')"
              >
                <span class="material-symbols-outlined text-[16px]">refresh</span>
              </button>
            </div>
          </div>

          <!-- TAB VIEW 1: CATALOG OF SERVICES -->
          <div id="view-service-catalog" class="flex flex-col">
            <!-- Filter & Search Toolbar -->
            <div class="p-3 sm:p-4 bg-surface-container-lowest flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3 w-full border-b border-surface-container/50">
              <div class="flex-1 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 flex-wrap">
                <div class="relative flex-1 min-w-[240px] max-w-md w-full sm:w-auto">
                  <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[17px]">
                    search
                  </span>
                  <input
                    id="service-search-input"
                    class="w-full h-9 pl-8 pr-12 bg-surface rounded-xl text-[12px] text-on-surface placeholder:text-on-surface-variant/70 focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-colors shadow-2xs border border-transparent hover:border-surface-container"
                    placeholder="Filtrar por código, servicio o descripción..."
                    type="text"
                  />
                  <span class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] bg-surface-container text-on-surface-variant px-1.5 py-0.5 rounded font-semibold pointer-events-none">
                    ESC
                  </span>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                  <!-- Categoría -->
                  <div class="relative flex-1 sm:flex-initial">
                    <select
                      id="service-category-filter"
                      class="w-full sm:w-auto h-9 pl-3 pr-7 bg-surface text-on-surface rounded-xl text-[12px] appearance-none shadow-2xs focus:outline-none focus:border-secondary cursor-pointer border border-transparent hover:border-surface-container"
                    >
                      <option>Categoría: Todas</option>
                      <option>Mantenimiento</option>
                      <option>Instalación & Redes</option>
                      <option>Soporte POS</option>
                      <option>Laboratorio</option>
                      <option>Soporte Remoto</option>
                      <option>Consultoría</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-1.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[16px] pointer-events-none">
                      expand_more
                    </span>
                  </div>

                  <!-- Tarifa -->
                  <div class="relative flex-1 sm:flex-initial">
                    <select
                      id="service-rate-filter"
                      class="w-full sm:w-auto h-9 pl-3 pr-7 bg-surface text-on-surface rounded-xl text-[12px] appearance-none shadow-2xs focus:outline-none focus:border-secondary cursor-pointer border border-transparent hover:border-surface-container"
                    >
                      <option>Tarifa: Todas</option>
                      <option>Tarifa Fija</option>
                      <option>Por Hora</option>
                      <option>Por Punto / Unidad</option>
                      <option>Por Proyecto</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-1.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[16px] pointer-events-none">
                      expand_more
                    </span>
                  </div>

                  <!-- Estado -->
                  <div class="relative flex-1 sm:flex-initial">
                    <select
                      id="service-status-filter"
                      class="w-full sm:w-auto h-9 pl-3 pr-7 bg-surface text-on-surface rounded-xl text-[12px] appearance-none shadow-2xs focus:outline-none focus:border-secondary cursor-pointer border border-transparent hover:border-surface-container"
                    >
                      <option>Estado: Todos</option>
                      <option>Estado: Activo</option>
                      <option>Estado: Inactivo</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-1.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[16px] pointer-events-none">
                      expand_more
                    </span>
                  </div>

                  <button
                    id="btn-reset-service-filters"
                    class="h-9 px-3 text-on-surface-variant hover:text-error hover:bg-error-container/40 rounded-xl text-[12px] font-medium transition-colors flex items-center gap-1 shrink-0 cursor-pointer"
                    title="Restablecer filtros"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[16px]">filter_alt_off</span>
                    <span>Limpiar</span>
                  </button>
                </div>
              </div>

              <div class="flex items-center gap-2 text-on-surface-variant text-[12px] shrink-0 mt-1 lg:mt-0">
                <span class="w-2 h-2 rounded-full bg-secondary-container"></span>
                <span>Mostrando <span id="service-visible-count" class="font-bold text-on-surface">6</span> de 24 registros</span>
              </div>
            </div>

            <!-- Data Table Container -->
            <div class="overflow-x-auto w-full">
              <table class="w-full text-left border-collapse text-[13px]">
                <thead>
                  <tr class="bg-surface-container-low text-on-surface-variant text-[11px] uppercase tracking-wider h-10 border-b border-surface-container/60">
                    <th class="w-10 px-4 text-center">
                      <input class="w-4 h-4 rounded text-secondary-container focus:ring-0 focus:outline-none cursor-pointer" type="checkbox" />
                    </th>
                    <th class="px-3 py-2 font-semibold">CÓDIGO / SKU</th>
                    <th class="px-3 py-2 min-w-[320px] font-semibold">NOMBRE DEL SERVICIO & DESCRIPCIÓN TÉCNICA</th>
                    <th class="px-3 py-2 font-semibold">CATEGORÍA</th>
                    <th class="px-3 py-2 font-semibold">TIPO & DURACIÓN</th>
                    <th class="px-3 py-2 text-right font-semibold">PRECIO</th>
                    <th class="px-3 py-2 text-center font-semibold">ESTADO</th>
                    <th class="w-24 px-4 py-2 text-center font-semibold">ACCIONES</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-surface-container/40 text-on-surface">
                  <!-- Row 1 -->
                  <tr
                    class="service-row group hover:bg-surface-container-low transition-colors h-12"
                    data-category="mantenimiento"
                    data-rate="fija"
                    data-status="activo"
                  >
                    <td class="px-4 text-center">
                      <input class="w-4 h-4 rounded text-secondary-container focus:ring-0 focus:outline-none cursor-pointer" type="checkbox" />
                    </td>
                    <td class="px-3 py-2">
                      <span class="font-semibold text-primary px-2 py-0.5 bg-surface-container rounded-lg text-[12px]">
                        SRV-MNT-01
                      </span>
                    </td>
                    <td class="px-3 py-2">
                      <div class="flex flex-col">
                        <span class="font-semibold text-on-surface group-hover:text-secondary transition-colors">
                          Mantenimiento Preventivo Servidores y Racks
                        </span>
                        <span class="text-[11px] text-on-surface-variant line-clamp-1">
                          Limpieza física interna, revisión de fuentes redundantes y firmware
                        </span>
                      </div>
                    </td>
                    <td class="px-3 py-2">
                      <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed">
                        <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                        Mantenimiento
                      </span>
                    </td>
                    <td class="px-3 py-2">
                      <div class="flex items-center gap-1.5 text-on-surface-variant text-[12px]">
                        <span class="font-semibold text-on-surface">Fijo</span>
                        <span>•</span>
                        <span class="flex items-center gap-0.5 text-on-surface-variant">
                          <span class="material-symbols-outlined text-[14px]">schedule</span> ~2.5 hrs
                        </span>
                      </div>
                    </td>
                    <td class="px-3 py-2 text-right font-bold text-on-surface">$85.00</td>
                    <td class="px-3 py-2 text-center">
                      <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-tertiary-fixed text-tertiary-container">
                        Activo
                      </span>
                    </td>
                    <td class="px-4 py-2 text-center">
                      <div class="flex items-center justify-center gap-1 opacity-80 group-hover:opacity-100 transition-opacity">
                        <button
                          class="p-1 hover:bg-surface-container rounded-lg text-on-surface-variant hover:text-secondary cursor-pointer"
                          title="Editar Servicio"
                          type="button"
                          onclick="window.openServiceModal && window.openServiceModal()"
                        >
                          <span class="material-symbols-outlined text-[18px]">edit</span>
                        </button>
                        <button
                          class="p-1 hover:bg-surface-container rounded-lg text-on-surface-variant hover:text-primary cursor-pointer"
                          title="Asignar a Orden"
                          type="button"
                          onclick="window.showServiceToast && window.showServiceToast('Servicio SRV-MNT-01 asignado a orden.')"
                        >
                          <span class="material-symbols-outlined text-[18px]">add_task</span>
                        </button>
                      </div>
                    </td>
                  </tr>

                  <!-- Row 2 -->
                  <tr
                    class="service-row group hover:bg-surface-container-low transition-colors h-12 bg-surface-container-low/20"
                    data-category="instalación & redes"
                    data-rate="punto"
                    data-status="activo"
                  >
                    <td class="px-4 text-center">
                      <input class="w-4 h-4 rounded text-secondary-container focus:ring-0 focus:outline-none cursor-pointer" type="checkbox" />
                    </td>
                    <td class="px-3 py-2">
                      <span class="font-semibold text-primary px-2 py-0.5 bg-surface-container rounded-lg text-[12px]">
                        SRV-INST-04
                      </span>
                    </td>
                    <td class="px-3 py-2">
                      <div class="flex flex-col">
                        <span class="font-semibold text-on-surface group-hover:text-secondary transition-colors">
                          Instalación y Certificación de Cableado Cat 6A
                        </span>
                        <span class="text-[11px] text-on-surface-variant line-clamp-1">
                          Despliegue estructurado por punto de red, conectorización y rotulado fluke
                        </span>
                      </div>
                    </td>
                    <td class="px-3 py-2">
                      <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-surface-container-high text-on-surface">
                        <span class="w-1.5 h-1.5 rounded-full bg-secondary-container"></span>
                        Instalación & Redes
                      </span>
                    </td>
                    <td class="px-3 py-2">
                      <div class="flex items-center gap-1.5 text-on-surface-variant text-[12px]">
                        <span class="font-semibold text-on-surface">Por Punto</span>
                        <span>•</span>
                        <span class="flex items-center gap-0.5 text-on-surface-variant">
                          <span class="material-symbols-outlined text-[14px]">schedule</span> ~1.0 hr
                        </span>
                      </div>
                    </td>
                    <td class="px-3 py-2 text-right font-bold text-on-surface">$35.00</td>
                    <td class="px-3 py-2 text-center">
                      <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-tertiary-fixed text-tertiary-container">
                        Activo
                      </span>
                    </td>
                    <td class="px-4 py-2 text-center">
                      <div class="flex items-center justify-center gap-1 opacity-80 group-hover:opacity-100 transition-opacity">
                        <button
                          class="p-1 hover:bg-surface-container rounded-lg text-on-surface-variant hover:text-secondary cursor-pointer"
                          title="Editar Servicio"
                          type="button"
                          onclick="window.openServiceModal && window.openServiceModal()"
                        >
                          <span class="material-symbols-outlined text-[18px]">edit</span>
                        </button>
                        <button
                          class="p-1 hover:bg-surface-container rounded-lg text-on-surface-variant hover:text-primary cursor-pointer"
                          title="Asignar a Orden"
                          type="button"
                          onclick="window.showServiceToast && window.showServiceToast('Servicio SRV-INST-04 asignado a orden.')"
                        >
                          <span class="material-symbols-outlined text-[18px]">add_task</span>
                        </button>
                      </div>
                    </td>
                  </tr>

                  <!-- Row 3 -->
                  <tr
                    class="service-row group hover:bg-surface-container-low transition-colors h-12"
                    data-category="soporte pos"
                    data-rate="fija"
                    data-status="activo"
                  >
                    <td class="px-4 text-center">
                      <input class="w-4 h-4 rounded text-secondary-container focus:ring-0 focus:outline-none cursor-pointer" type="checkbox" />
                    </td>
                    <td class="px-3 py-2">
                      <span class="font-semibold text-primary px-2 py-0.5 bg-surface-container rounded-lg text-[12px]">
                        SRV-POS-02
                      </span>
                    </td>
                    <td class="px-3 py-2">
                      <div class="flex flex-col">
                        <span class="font-semibold text-on-surface group-hover:text-secondary transition-colors">
                          Configuración y Puesta en Marcha Terminales POS
                        </span>
                        <span class="text-[11px] text-on-surface-variant line-clamp-1">
                          Sincronización de periféricos lectores, gaveta electrónica e impresora fiscal
                        </span>
                      </div>
                    </td>
                    <td class="px-3 py-2">
                      <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed">
                        <span class="w-1.5 h-1.5 rounded-full bg-secondary-container"></span>
                        Soporte POS
                      </span>
                    </td>
                    <td class="px-3 py-2">
                      <div class="flex items-center gap-1.5 text-on-surface-variant text-[12px]">
                        <span class="font-semibold text-on-surface">Fijo</span>
                        <span>•</span>
                        <span class="flex items-center gap-0.5 text-on-surface-variant">
                          <span class="material-symbols-outlined text-[14px]">schedule</span> ~1.5 hrs
                        </span>
                      </div>
                    </td>
                    <td class="px-3 py-2 text-right font-bold text-on-surface">$50.00</td>
                    <td class="px-3 py-2 text-center">
                      <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-tertiary-fixed text-tertiary-container">
                        Activo
                      </span>
                    </td>
                    <td class="px-4 py-2 text-center">
                      <div class="flex items-center justify-center gap-1 opacity-80 group-hover:opacity-100 transition-opacity">
                        <button
                          class="p-1 hover:bg-surface-container rounded-lg text-on-surface-variant hover:text-secondary cursor-pointer"
                          title="Editar Servicio"
                          type="button"
                          onclick="window.openServiceModal && window.openServiceModal()"
                        >
                          <span class="material-symbols-outlined text-[18px]">edit</span>
                        </button>
                        <button
                          class="p-1 hover:bg-surface-container rounded-lg text-on-surface-variant hover:text-primary cursor-pointer"
                          title="Asignar a Orden"
                          type="button"
                          onclick="window.showServiceToast && window.showServiceToast('Servicio SRV-POS-02 asignado a orden.')"
                        >
                          <span class="material-symbols-outlined text-[18px]">add_task</span>
                        </button>
                      </div>
                    </td>
                  </tr>

                  <!-- Row 4 -->
                  <tr
                    class="service-row group hover:bg-surface-container-low transition-colors h-12 bg-surface-container-low/20"
                    data-category="laboratorio"
                    data-rate="fija"
                    data-status="activo"
                  >
                    <td class="px-4 text-center">
                      <input class="w-4 h-4 rounded text-secondary-container focus:ring-0 focus:outline-none cursor-pointer" type="checkbox" />
                    </td>
