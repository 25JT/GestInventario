---
// Servicios.astro - Módulo de Gestión de Servicios Técnicos y Órdenes de Trabajo
import Layout from "../layouts/Layout.astro";
import SlideBar from "../components/SlideBar.astro";
import NavBar from "../components/Nav.astro";
import AggServicio from "../components/AggServicio.astro";
---

<Layout title="Gestión de Servicios - StockControl Enterprise JR">
  <div class="min-h-screen bg-surface flex flex-col font-body-md text-on-surface">
    {/* Barra lateral y superior globales y responsivas */}
    <SlideBar currentPath="servicios" />
    <NavBar storeName="Central Sucursal 01" operationStatus="Taller Activo" />

    {/* Contenedor principal */}
    <div id="app-content" class="pt-16 min-h-screen flex flex-col flex-1">
      <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">

        <!-- Header Section with Quick Actions -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 flex-wrap w-full">
          <div class="max-w-3xl min-w-0">
            <div class="flex items-center gap-1.5 text-on-surface-variant text-[12px] uppercase tracking-wider mb-1 font-semibold">
              <span>Módulo Técnico</span>
              <span class="material-symbols-outlined text-[14px]">chevron_right</span>
              <span class="text-secondary">Servicios & Taller</span>
            </div>
            <h1 class="text-[24px] sm:text-[28px] font-bold text-primary tracking-tight">
              Gestión de Servicios
            </h1>
            <p class="text-[13px] sm:text-[14px] text-on-surface-variant mt-0.5 max-w-2xl">
              Catálogo de prestaciones técnicas, órdenes de trabajo, asignación de mano de obra y facturación de servicios.
            </p>
          </div>

          <div class="flex items-center flex-wrap gap-2.5 shrink-0 w-full sm:w-auto">
            <button
              id="btn-rates-contracts"
              class="h-[38px] px-3.5 bg-surface-container-lowest hover:bg-surface-container-low text-on-surface rounded-xl text-[12px] font-medium border border-surface-container/70 shadow-2xs hover:shadow-xs transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
              type="button"
              onclick="window.showServiceToast && window.showServiceToast('Tarifario corporativo de contratos descargado.', 'info')"
            >
              <span class="material-symbols-outlined text-[17px] text-on-surface-variant">receipt_long</span>
              <span>Tarifario & Contratos</span>
            </button>
            <button
              id="btn-new-service"
              class="h-[38px] px-4 bg-primary hover:bg-secondary text-on-primary rounded-xl text-[12px] font-semibold shadow-xs hover:shadow-md transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
              type="button"
              onclick="window.openServiceModal && window.openServiceModal()"
            >
              <span class="material-symbols-outlined text-[18px]">add</span>
              <span>Registrar Nuevo Servicio</span>
            </button>
          </div>
        </div>

        <!-- KPI Metrics Grid (2 Big Responsive Bento Cards Conectados a la BD) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full">
          <!-- Card 1 -->
          <div class="service-kpi-card bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between relative overflow-hidden group hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
              <span class="text-[12px] text-on-surface-variant font-medium">Servicios en Catálogo</span>
              <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-tertiary-fixed text-tertiary-container flex items-center gap-0.5" id="kpi-activos-pill">
                <span class="material-symbols-outlined text-[13px]">check_circle</span>
                <span id="kpi-activos-label">Sincronizado</span>
              </span>
            </div>
            <div class="mt-3">
              <div class="flex items-baseline gap-2">
                <span id="kpi-total-servicios" class="text-[26px] sm:text-[28px] font-bold text-on-surface">0</span>
                <span class="text-[12px] text-on-surface-variant font-medium">servicios técnicos</span>
              </div>
              <div class="flex items-center justify-between text-on-surface-variant mt-2 pt-2 bg-surface-container-low/60 -mx-4 sm:-mx-5 -mb-4 sm:-mb-5 px-4 sm:px-5 py-2 rounded-b-xl border-t border-surface-container/50">
                <span class="text-[11px] flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
                  <span id="kpi-servicios-disponibles">Cargando catálogo...</span>
                </span>
                <span class="text-[11px] font-bold text-on-surface" id="kpi-servicios-meta">100% operativos</span>
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="service-kpi-card bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between relative overflow-hidden group hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
              <span class="text-[12px] text-on-surface-variant font-medium">Facturación Acumulada</span>
              <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-tertiary-fixed text-tertiary-container flex items-center gap-0.5">
                <span class="material-symbols-outlined text-[13px]">trending_up</span>
                Ventas POS
              </span>
            </div>
            <div class="mt-3">
              <div class="flex items-baseline gap-1.5">
                <span id="kpi-facturacion-servicios" class="text-[26px] sm:text-[28px] font-bold text-on-surface">$0</span>
                <span class="text-[12px] text-on-surface-variant font-medium">COP</span>
              </div>
              <div class="flex items-center justify-between text-on-surface-variant mt-2 pt-2 bg-surface-container-low/60 -mx-4 sm:-mx-5 -mb-4 sm:-mb-5 px-4 sm:px-5 py-2 rounded-b-xl border-t border-surface-container/50">
                <span class="text-[11px] truncate" id="kpi-prestaciones-count">0 órdenes facturadas</span>
                <span class="text-[11px] font-bold text-on-surface" id="kpi-margen-promedio">62.0% prom.</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Operational Workspace: Tabs & Filtering -->
        <div class="bg-surface-container-lowest rounded-xl border border-surface-container/60 shadow-xs overflow-hidden flex flex-col">
          
          <!-- Horizontal Tab Navigation Bar -->
          <div class="flex flex-wrap items-center justify-between px-4 pt-2 bg-surface-container-low/40 gap-2 w-full border-b border-surface-container/60">
            <div class="flex items-center gap-1 overflow-x-auto flex-wrap sm:flex-nowrap">
              <button
                id="tab-service-catalog"
                class="px-3.5 py-2.5 text-[13px] font-semibold text-secondary-container bg-surface-container-lowest rounded-t-xl shadow-xs flex items-center gap-2 cursor-pointer transition-all"
                type="button"
                onclick="window.switchServiceTab && window.switchServiceTab('catalog')"
              >
                <span class="material-symbols-outlined text-[18px]">build_circle</span>
                <span>Catálogo de Servicios & Tarifas</span>
                <span id="tab-services-count" class="px-1.5 py-0.2 bg-secondary-fixed text-on-secondary-fixed-variant text-[11px] font-bold rounded-full">
                  0
                </span>
              </button>
              <button
                id="tab-service-orders"
                class="px-3.5 py-2.5 text-[13px] font-medium text-on-surface-variant hover:text-on-surface rounded-t-xl hover:bg-surface-container/50 transition-colors flex items-center gap-2 cursor-pointer"
                type="button"
                onclick="window.switchServiceTab && window.switchServiceTab('orders')"
              >
                <span class="material-symbols-outlined text-[18px]">pending_actions</span>
                <span>Órdenes de Trabajo en Curso</span>
                <span class="px-1.5 py-0.2 bg-surface-container text-on-surface-variant text-[11px] font-bold rounded-full">
                  32
                </span>
              </button>
            </div>

            <div class="flex items-center gap-1.5 py-2 sm:py-0 shrink-0">
              <button
                class="h-8 px-3 bg-surface hover:bg-surface-container text-on-surface-variant hover:text-on-surface rounded-xl text-[12px] font-medium flex items-center gap-1 shadow-2xs transition-colors cursor-pointer border border-surface-container/60"
                title="Exportar CSV o Excel"
                type="button"
                onclick="window.showServiceToast && window.showServiceToast('Exportando catálogo de servicios a CSV...', 'info')"
              >
                <span class="material-symbols-outlined text-[16px]">file_download</span>
                <span>Exportar</span>
              </button>
              <button
                class="h-8 w-8 bg-surface hover:bg-surface-container text-on-surface-variant hover:text-on-surface rounded-xl flex items-center justify-center shadow-2xs transition-colors cursor-pointer border border-surface-container/60"
                title="Actualizar datos"
                type="button"
                onclick="window.showServiceToast && window.showServiceToast('Catálogo de tarifas sincronizado.')"
              >
                <span class="material-symbols-outlined text-[16px]">refresh</span>
              </button>
            </div>
          </div>

          <!-- TAB VIEW 1: CATALOG OF SERVICES -->
          <div id="view-service-catalog" class="flex flex-col">
            <!-- Filter & Search Toolbar -->
            <div class="p-3 sm:p-4 bg-surface-container-lowest flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3 w-full border-b border-surface-container/50">
              <div class="flex-1 flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 flex-wrap">
                <div class="relative flex-1 min-w-[240px] max-w-md w-full sm:w-auto">
                  <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[17px]">
                    search
                  </span>
                  <input
                    id="service-search-input"
                    class="w-full h-9 pl-8 pr-12 bg-surface rounded-xl text-[12px] text-on-surface placeholder:text-on-surface-variant/70 focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-colors shadow-2xs border border-transparent hover:border-surface-container"
                    placeholder="Filtrar por código, servicio o descripción..."
                    type="text"
                  />
                  <span class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] bg-surface-container text-on-surface-variant px-1.5 py-0.5 rounded font-semibold pointer-events-none">
                    ESC
                  </span>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                  <!-- Categoría -->
                  <div class="relative flex-1 sm:flex-initial">
                    <select
                      id="service-category-filter"
                      class="w-full sm:w-auto h-9 pl-3 pr-7 bg-surface text-on-surface rounded-xl text-[12px] appearance-none shadow-2xs focus:outline-none focus:border-secondary cursor-pointer border border-transparent hover:border-surface-container"
                    >
                      <option>Categoría: Todas</option>
                      <option>Mantenimiento</option>
                      <option>Instalación & Redes</option>
                      <option>Soporte POS</option>
                      <option>Laboratorio</option>
                      <option>Soporte Remoto</option>
                      <option>Consultoría</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-1.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[16px] pointer-events-none">
                      expand_more
                    </span>
                  </div>

                  <!-- Tarifa -->
                  <div class="relative flex-1 sm:flex-initial">
                    <select
                      id="service-rate-filter"
                      class="w-full sm:w-auto h-9 pl-3 pr-7 bg-surface text-on-surface rounded-xl text-[12px] appearance-none shadow-2xs focus:outline-none focus:border-secondary cursor-pointer border border-transparent hover:border-surface-container"
                    >
                      <option>Tarifa: Todas</option>
                      <option>Tarifa Fija</option>
                      <option>Por Hora</option>
                      <option>Por Punto / Unidad</option>
                      <option>Por Proyecto</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-1.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[16px] pointer-events-none">
                      expand_more
                    </span>
                  </div>

                  <!-- Estado -->
                  <div class="relative flex-1 sm:flex-initial">
                    <select
                      id="service-status-filter"
                      class="w-full sm:w-auto h-9 pl-3 pr-7 bg-surface text-on-surface rounded-xl text-[12px] appearance-none shadow-2xs focus:outline-none focus:border-secondary cursor-pointer border border-transparent hover:border-surface-container"
                    >
                      <option>Estado: Todos</option>
                      <option>Estado: Activo</option>
                      <option>Estado: Inactivo</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-1.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[16px] pointer-events-none">
                      expand_more
                    </span>
                  </div>

                  <button
                    id="btn-reset-service-filters"
                    class="h-9 px-3 text-on-surface-variant hover:text-error hover:bg-error-container/40 rounded-xl text-[12px] font-medium transition-colors flex items-center gap-1 shrink-0 cursor-pointer"
                    title="Restablecer filtros"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[16px]">filter_alt_off</span>
                    <span>Limpiar</span>
                  </button>
                </div>
              </div>

              <div class="flex items-center gap-2 text-on-surface-variant text-[12px] shrink-0 mt-1 lg:mt-0">
                <span class="w-2 h-2 rounded-full bg-secondary-container"></span>
                <span>Mostrando <span id="service-visible-count" class="font-bold text-on-surface">0</span> de <span id="service-total-count">0</span> registros</span>
              </div>
            </div>

            <!-- Data Table Container -->
            <div class="overflow-x-auto w-full">
              <table class="w-full text-left border-collapse text-[13px]">
                <thead>
                  <tr class="bg-surface-container-low text-on-surface-variant text-[11px] uppercase tracking-wider h-10 border-b border-surface-container/60">
                    <th class="w-10 px-4 text-center">
                      <input class="w-4 h-4 rounded text-secondary-container focus:ring-0 focus:outline-none cursor-pointer" type="checkbox" />
                    </th>
                    <th class="px-3 py-2 font-semibold">CÓDIGO / SKU</th>
                    <th class="px-3 py-2 min-w-[320px] font-semibold">NOMBRE DEL SERVICIO & DESCRIPCIÓN TÉCNICA</th>
                    <th class="px-3 py-2 font-semibold">CATEGORÍA</th>
                    <th class="px-3 py-2 font-semibold">TIPO & DURACIÓN</th>
                    <th class="px-3 py-2 text-right font-semibold">PRECIO (COP)</th>
                    <th class="px-3 py-2 text-center font-semibold">ESTADO</th>
                    <th class="w-24 px-4 py-2 text-center font-semibold">ACCIONES</th>
                  </tr>
                </thead>
                <tbody id="services-table-body" class="divide-y divide-surface-container/40 text-on-surface">
                  <tr>
                    <td colspan="8" class="p-8 text-center text-on-surface-variant">
                      <span class="material-symbols-outlined text-[32px] animate-spin mb-2 block text-secondary">progress_activity</span>
                      <span>Cargando servicios técnicos desde la base de datos...</span>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <!-- Table Footer / Pagination -->
            <div class="p-3 bg-surface-container-low/30 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-surface-container/60 text-[12px] text-on-surface-variant">
              <div class="flex items-center gap-4">
                <span id="services-pagination-info">Mostrando <strong class="text-on-surface font-semibold">0</strong> servicios</span>
                <div class="flex items-center gap-1.5">
                  <span>Filas:</span>
                  <select class="bg-surface text-on-surface rounded-lg px-2 py-1 text-[11px] border border-surface-container focus:outline-none cursor-pointer">
                    <option>10</option>
                    <option>25</option>
                    <option>50</option>
                  </select>
                </div>
              </div>

              <!-- Pagination Controls -->
              <div class="flex items-center gap-1">
                <button class="h-7 w-7 rounded-lg flex items-center justify-center text-on-surface-variant bg-surface hover:bg-surface-container border border-surface-container/60 transition-colors disabled:opacity-40 cursor-pointer" disabled type="button">
                  <span class="material-symbols-outlined text-[16px]">chevron_left</span>
                </button>
                <button class="h-7 w-7 rounded-lg font-semibold bg-secondary-container text-on-secondary shadow-xs cursor-pointer" type="button">
                  1
                </button>
                <button class="h-7 w-7 rounded-lg text-on-surface bg-surface hover:bg-surface-container border border-surface-container/60 transition-colors cursor-pointer" type="button">
                  2
                </button>
                <button class="h-7 w-7 rounded-lg text-on-surface bg-surface hover:bg-surface-container border border-surface-container/60 transition-colors cursor-pointer" type="button">
                  3
                </button>
                <button class="h-7 w-7 rounded-lg text-on-surface bg-surface hover:bg-surface-container border border-surface-container/60 transition-colors cursor-pointer" type="button">
                  4
                </button>
                <button class="h-7 w-7 rounded-lg flex items-center justify-center text-on-surface-variant bg-surface hover:bg-surface-container border border-surface-container/60 transition-colors cursor-pointer" type="button">
                  <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                </button>
              </div>
            </div>
          </div>

          <!-- TAB VIEW 2: ÓRDENES DE TRABAJO EN CURSO (Inicialmente oculto) -->
          <div id="view-service-orders" class="p-8 flex flex-col items-center justify-center text-center hidden py-16">
            <div class="w-14 h-14 rounded-2xl bg-secondary-container/10 text-secondary-container flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-[32px]">pending_actions</span>
            </div>
            <h3 class="text-[18px] font-bold text-on-surface">32 Órdenes de Trabajo Activas</h3>
            <p class="text-[13px] text-on-surface-variant max-w-md mt-1 mb-6">
              Módulo de órdenes en curso sincronizado en tiempo real con el taller y los técnicos de campo.
            </p>
            <button
              class="px-4 py-2 bg-primary hover:bg-secondary text-on-primary font-semibold text-[13px] rounded-xl shadow-xs transition-all flex items-center gap-2 cursor-pointer active:scale-95"
              type="button"
              onclick="window.switchServiceTab && window.switchServiceTab('catalog')"
            >
              <span class="material-symbols-outlined text-[18px]">arrow_back</span>
              <span>Regresar al Catálogo de Servicios</span>
            </button>
          </div>
        </div>

      </main>
    </div>
  </div>

  <!-- MODAL: REGISTRAR NUEVO SERVICIO TÉCNICO -->
  <AggServicio />

  <!-- NOTIFICATION TOAST -->
  <div
    id="serviceToast"
    class="fixed bottom-6 right-6 z-50 hidden bg-primary text-on-primary px-4 py-3 rounded-xl shadow-xl flex items-center gap-2.5 transition-all pointer-events-none"
  >
    <span id="serviceToastIcon" class="material-symbols-outlined text-secondary-fixed text-[20px]">check_circle</span>
    <span id="serviceToastMsg" class="text-[13px] font-medium">Operación completada con éxito</span>
  </div>

  <script>
    import {
      initServicios,
      switchServiceTab,
      openServiceModal,
      closeServiceModal,
      showServiceToast,
    } from "../animaciones/animaServicios.js";

    (window as any).switchServiceTab = switchServiceTab;
    (window as any).openServiceModal = openServiceModal;
    (window as any).closeServiceModal = closeServiceModal;
    (window as any).showServiceToast = showServiceToast;

    const BACKEND_URL = "http://localhost:3000";
    let allServicios: any[] = [];

    function formatCOP(num: any) {
      const val = Math.round(Number(num) || 0);
      return `$${val.toLocaleString("es-CO")} COP`;
    }

    function formatDuration(minutes: number) {
      if (!minutes || minutes <= 0) return "~45 min";
      if (minutes >= 60) {
        const h = (minutes / 60).toFixed(1).replace(".0", "");
        return `~${h} hrs`;
      }
      return `~${minutes} min`;
    }

    function escapeHtml(str: any) {
      return String(str || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    // Cargar servicios técnicos desde la base de datos MySQL
    (window as any).loadServicesFromDB = async function () {
      const tbody = document.getElementById("services-table-body");
      if (!tbody) return;

      try {
        const response = await fetch(`${BACKEND_URL}/api/servicios`);
        if (!response.ok) throw new Error("No se pudo obtener el catálogo de servicios.");

        const resData = await response.json();
        const data = resData.data || {};
        allServicios = data.servicios || [];
        const kpis = data.kpis || {};

        // Actualizar KPIs superiores
        const kpiTotal = document.getElementById("kpi-total-servicios");
        const kpiDisp = document.getElementById("kpi-servicios-disponibles");
        const kpiFact = document.getElementById("kpi-facturacion-servicios");
        const kpiPrest = document.getElementById("kpi-prestaciones-count");
        const kpiMargen = document.getElementById("kpi-margen-promedio");
        const tabCount = document.getElementById("tab-services-count");

        if (kpiTotal) kpiTotal.textContent = String(kpis.total_servicios || allServicios.length);
        if (kpiDisp) kpiDisp.textContent = `${kpis.servicios_activos || 0} activos en catálogo`;
        if (kpiFact) kpiFact.textContent = `$${Math.round(kpis.facturacion_mes || 0).toLocaleString("es-CO")}`;
        if (kpiPrest) kpiPrest.textContent = `${kpis.total_prestaciones_mes || 0} prestaciones facturadas`;
        if (kpiMargen) kpiMargen.textContent = `${kpis.margen_promedio || 62}% prom.`;
        if (tabCount) tabCount.textContent = String(allServicios.length);

        renderServicesTable(allServicios);
      } catch (err: any) {
        console.error("Error al cargar servicios:", err);
        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="p-8 text-center text-error">
              <span class="material-symbols-outlined text-[32px] mb-2 block">error</span>
              <span class="font-medium">Error al conectar con la base de datos</span>
              <p class="text-[12px] opacity-80 mt-1">${err.message || ""}</p>
            </td>
          </tr>
        `;
      }
    };

    function renderServicesTable(list: any[]) {
      const tbody = document.getElementById("services-table-body");
      const visibleCountEl = document.getElementById("service-visible-count");
      const totalCountEl = document.getElementById("service-total-count");
      const pagInfo = document.getElementById("services-pagination-info");

      if (!tbody) return;

      if (visibleCountEl) visibleCountEl.textContent = String(list.length);
      if (totalCountEl) totalCountEl.textContent = String(allServicios.length);
      if (pagInfo) {
        pagInfo.innerHTML = `Mostrando <strong class="text-on-surface font-semibold">1-${list.length}</strong> de <strong class="text-on-surface font-semibold">${allServicios.length}</strong> servicios`;
      }

      if (list.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" class="p-10 text-center text-on-surface-variant">
              <span class="material-symbols-outlined text-[38px] mb-2 block text-on-surface-variant/40">home_repair_service</span>
              <span class="font-semibold text-[14px] text-primary">No se encontraron servicios en el catálogo</span>
              <p class="text-[12px] text-on-surface-variant/70 mt-1">
                Haz clic en "Registrar Nuevo Servicio" para dar de alta una nueva prestación técnica.
              </p>
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = list
        .map((srv, idx) => {
          const sku = srv.codigo_sku || `SRV-${srv.id.slice(0, 6).toUpperCase()}`;
          const catName = srv.categoria_nombre || "Servicios técnicos";
          const desc = srv.descripcion || "Prestación técnica y mano de obra especializada";
          const cleanName = escapeHtml(srv.nombre);
          const cleanDesc = escapeHtml(desc);
          const cleanCat = escapeHtml(catName);
          const cleanTarifa = escapeHtml(srv.tipo_tarifa || "fija");
          const bgAlt = idx % 2 === 1 ? "bg-surface-container-low/20" : "";

          // Formateo de tarifa
          let tipoLabel = "Fijo";
          if (cleanTarifa.includes("hora") || cleanTarifa.includes("hourly")) tipoLabel = "Por Hora";
          else if (cleanTarifa.includes("punto") || cleanTarifa.includes("unit")) tipoLabel = "Por Punto";
          else if (cleanTarifa.includes("proyecto") || cleanTarifa.includes("custom")) tipoLabel = "Por Proyecto";

          const statusBadge = srv.estado
            ? `<button onclick="window.toggleServiceStatus('${srv.id}')" title="Clic para pausar" class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-tertiary-fixed text-tertiary-container hover:opacity-80 transition-opacity cursor-pointer">Activo</button>`
            : `<button onclick="window.toggleServiceStatus('${srv.id}')" title="Clic para activar" class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-surface-container text-on-surface-variant hover:opacity-80 transition-opacity cursor-pointer">Inactivo</button>`;

          return `
            <tr
              class="service-row group hover:bg-surface-container-low transition-colors h-12 ${bgAlt}"
              data-category="${cleanCat.toLowerCase()}"
              data-rate="${cleanTarifa.toLowerCase()}"
              data-status="${srv.estado ? "activo" : "inactivo"}"
            >
              <td class="px-4 text-center">
                <input class="w-4 h-4 rounded text-secondary-container focus:ring-0 focus:outline-none cursor-pointer" type="checkbox" />
              </td>
              <td class="px-3 py-2">
                <span class="font-semibold text-primary px-2 py-0.5 bg-surface-container rounded-lg text-[12px] font-mono">
                  ${escapeHtml(sku)}
                </span>
              </td>
              <td class="px-3 py-2">
                <div class="flex flex-col">
                  <span class="font-semibold text-on-surface group-hover:text-secondary transition-colors">
                    ${cleanName}
                  </span>
                  <span class="text-[11px] text-on-surface-variant line-clamp-1">
                    ${cleanDesc}
                  </span>
                </div>
              </td>
              <td class="px-3 py-2">
                <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed">
                  <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                  ${cleanCat}
                </span>
              </td>
              <td class="px-3 py-2">
                <div class="flex items-center gap-1.5 text-on-surface-variant text-[12px]">
                  <span class="font-semibold text-on-surface">${tipoLabel}</span>
                  <span>•</span>
                  <span class="flex items-center gap-0.5 text-on-surface-variant">
                    <span class="material-symbols-outlined text-[14px]">schedule</span> ${formatDuration(srv.tiempo_estimado_min)}
                  </span>
                </div>
              </td>
              <td class="px-3 py-2 text-right font-bold text-on-surface font-mono whitespace-nowrap">
                ${formatCOP(srv.precio)}
              </td>
              <td class="px-3 py-2 text-center">
                ${statusBadge}
              </td>
              <td class="px-4 py-2 text-center">
                <div class="flex items-center justify-center gap-1 opacity-80 group-hover:opacity-100 transition-opacity">
                  <button
                    class="p-1 hover:bg-surface-container rounded-lg text-on-surface-variant hover:text-secondary transition-colors cursor-pointer"
                    title="Editar Servicio"
                    type="button"
                    onclick="window.openServiceModal && window.openServiceModal()"
                  >
                    <span class="material-symbols-outlined text-[18px]">edit</span>
                  </button>
                  <button
                    class="p-1 hover:bg-error-container/30 rounded-lg text-on-surface-variant hover:text-error transition-colors cursor-pointer"
                    title="Eliminar Servicio"
                    type="button"
                    onclick="window.deleteService('${srv.id}', '${cleanName.replace(/'/g, "\\'")}')"
                  >
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                  </button>
                </div>
              </td>
            </tr>
          `;
        })
        .join("");
    }

    // Alternar estado de servicio activo/inactivo
    (window as any).toggleServiceStatus = async function (id: string) {
      try {
        const res = await fetch(`${BACKEND_URL}/api/servicios/${id}/toggle`, {
          method: "PATCH",
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || "No se pudo cambiar el estado.");

        if ((window as any).showServiceToast) {
          (window as any).showServiceToast(data.message || "Estado actualizado con éxito.");
        }
        await (window as any).loadServicesFromDB();
      } catch (err: any) {
        console.error("Error al alternar estado:", err);
        if ((window as any).showServiceToast) {
          (window as any).showServiceToast(err.message, "warning");
        }
      }
    };

    // Eliminar servicio de la base de datos
    (window as any).deleteService = async function (id: string, name: string) {
      const confirmMsg = `¿Estás seguro de que deseas eliminar permanentemente el servicio:\n\n"${name}"?\n\nEsta acción lo borrará de la base de datos y no se podrá recuperar.`;
      if (!confirm(confirmMsg)) return;

      try {
        const response = await fetch(`${BACKEND_URL}/api/servicios/${id}`, {
          method: "DELETE",
        });
        const data = await response.json();

        if (!response.ok || !data.success) {
          throw new Error(data.error || "No se pudo eliminar el servicio.");
        }

        if ((window as any).showServiceToast) {
          (window as any).showServiceToast(`Servicio "${name}" eliminado correctamente.`);
        }
        await (window as any).loadServicesFromDB();
      } catch (err: any) {
        console.error("Error al eliminar servicio:", err);
        if ((window as any).showServiceToast) {
          (window as any).showServiceToast(err.message || "Error al eliminar servicio.", "warning");
        } else {
          alert(err.message);
        }
      }
    };

    function setupFilters() {
      const searchInput = document.getElementById("service-search-input") as HTMLInputElement | null;
      const categoryFilter = document.getElementById("service-category-filter") as HTMLSelectElement | null;
      const rateFilter = document.getElementById("service-rate-filter") as HTMLSelectElement | null;
      const statusFilter = document.getElementById("service-status-filter") as HTMLSelectElement | null;
      const resetBtn = document.getElementById("btn-reset-service-filters");

      function applyFilters() {
        const q = (searchInput?.value || "").toLowerCase().trim();
        const cat = (categoryFilter?.value || "").toLowerCase().trim();
        const rate = (rateFilter?.value || "").toLowerCase().trim();
        const status = (statusFilter?.value || "").toLowerCase().trim();

        const filtered = allServicios.filter((srv) => {
          const name = (srv.nombre || "").toLowerCase();
          const sku = (srv.codigo_sku || "").toLowerCase();
          const desc = (srv.descripcion || "").toLowerCase();
          const catName = (srv.categoria_nombre || "").toLowerCase();
          const srvRate = (srv.tipo_tarifa || "").toLowerCase();
          const srvStatus = srv.estado ? "activo" : "inactivo";

          const matchesQ = !q || name.includes(q) || sku.includes(q) || desc.includes(q);
          const matchesCat = !cat || cat.includes("todas") || catName.includes(cat);
          const matchesRate = !rate || rate.includes("todas") || srvRate.includes(rate);
          const matchesStatus = !status || status.includes("todos") || srvStatus === status;

          return matchesQ && matchesCat && matchesRate && matchesStatus;
        });

        renderServicesTable(filtered);
      }

      if (searchInput) searchInput.addEventListener("input", applyFilters);
      if (categoryFilter) categoryFilter.addEventListener("change", applyFilters);
      if (rateFilter) rateFilter.addEventListener("change", applyFilters);
      if (statusFilter) statusFilter.addEventListener("change", applyFilters);

      if (resetBtn) {
        resetBtn.addEventListener("click", () => {
          if (searchInput) searchInput.value = "";
          if (categoryFilter) categoryFilter.value = "Categoría: Todas";
          if (rateFilter) rateFilter.value = "Tarifa: Todas";
          if (statusFilter) statusFilter.value = "Estado: Todos";
          applyFilters();
          showServiceToast("Filtros restablecidos.", "info");
        });
      }
    }

    function setupServicios() {
      initServicios();
      setupFilters();
      (window as any).loadServicesFromDB();
    }

    document.addEventListener("astro:page-load", setupServicios);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupServicios);
    } else {
      setupServicios();
    }
  </script>
</Layout>
