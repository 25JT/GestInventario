---
// RegVenta.astro - Terminal de Punto de Venta (POS) y Facturación
import Layout from "../layouts/Layout.astro";
import SlideBar from "../components/SlideBar.astro";
import NavBar from "../components/Nav.astro";
---

<Layout title="Registro de Ventas - StockControl Enterprise JR">
  <div class="min-h-screen bg-surface flex flex-col font-body-md text-on-surface">
    {/* Barra lateral y superior globales y responsivas */}
    <SlideBar currentPath="ventas" />
    <NavBar storeName="Central Sucursal 01" operationStatus="Caja Abierta" />

    {/* Contenedor principal */}
    <div id="app-content" class="pt-16 min-h-screen flex flex-col flex-1">
      <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">

        <!-- Top Context & Mode Switcher Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 bg-surface-container-lowest p-3 sm:p-4 rounded-xl border border-surface-container/60 shadow-xs">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1 bg-surface-container/60 p-1 rounded-xl">
              <button
                id="tab-pos"
                class="px-3.5 py-1.5 rounded-lg text-[13px] font-semibold bg-surface-container-lowest text-primary shadow-xs transition-all flex items-center gap-1.5 cursor-pointer"
                type="button"
                onclick="window.switchView && window.switchView('pos')"
              >
                <span class="material-symbols-outlined text-[18px]">point_of_sale</span>
                <span>Terminal POS</span>
              </button>
              <button
                id="tab-history"
                class="px-3.5 py-1.5 rounded-lg text-[13px] font-medium text-on-surface-variant hover:text-on-surface transition-all flex items-center gap-1.5 cursor-pointer"
                type="button"
                onclick="window.switchView && window.switchView('history')"
              >
                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                <span>Historial y Facturación</span>
                <span class="bg-surface-variant text-on-surface-variant text-[10px] font-bold px-1.5 py-0.5 rounded-full">
                  24 Hoy
                </span>
              </button>
            </div>
          </div>

          <div class="flex items-center gap-2 sm:gap-3">
            {/* Vendedor activo */}
            <div class="hidden sm:flex items-center gap-1.5 bg-surface-container-low px-3 py-1.5 rounded-xl border border-surface-container/50">
              <span class="material-symbols-outlined text-[16px] text-secondary">badge</span>
              <span class="text-[11px] text-on-surface-variant">Vendedor:</span>
              <span id="pos-cashier-name" class="text-[12px] font-semibold text-on-surface">Luis Torres</span>
              <span class="bg-tertiary-container/20 text-on-tertiary-container text-[10px] font-bold px-1.5 py-0.2 rounded-full">
                Turno Activo
              </span>
            </div>

            {/* Caja actual */}
            <div class="flex items-center gap-2 bg-surface-container-low px-3 py-1.5 rounded-xl border border-surface-container/50">
              <span class="text-[11px] text-on-surface-variant">Caja:</span>
              <span class="text-[12px] font-bold text-on-surface">Principal 01</span>
              <span class="inline-block w-2 h-2 rounded-full bg-on-tertiary-container"></span>
            </div>
          </div>
        </div>

        <!-- VIEW 1: POS WORKSTATION -->
        <div id="view-pos" class="flex flex-col lg:flex-row gap-6 items-start w-full min-w-0">
          
          <!-- Left Column: Catalog & Search (8 cols aprox) -->
          <div class="flex-1 min-w-0 w-full flex flex-col gap-4">
            
            <!-- Clean Header & Search Bar -->
            <div class="bg-surface-container-lowest p-3 sm:p-4 rounded-xl border border-surface-container/60 shadow-xs flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center">
              <div class="relative flex-1">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">
                  search
                </span>
                <input
                  id="productSearch"
                  class="w-full h-10 pl-10 pr-24 bg-surface rounded-xl text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all"
                  placeholder="Buscar producto, servicio o escanear código de barras..."
                  type="text"
                />
                <div class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center gap-1.5">
                  <button
                    class="flex items-center text-on-surface-variant hover:text-secondary-container transition-colors cursor-pointer"
                    onclick="window.simulateBarcodeScan && window.simulateBarcodeScan()"
                    title="Escanear código (F2)"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[20px]">barcode_scanner</span>
                  </button>
                  <kbd class="bg-surface-container px-1.5 py-0.5 rounded text-[10px] text-on-surface-variant font-semibold">
                    F2
                  </kbd>
                </div>
              </div>

              <button
                class="h-10 px-3.5 bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-on-surface text-[12px] font-medium rounded-xl flex items-center justify-center gap-1.5 shrink-0 transition-colors cursor-pointer"
                onclick="window.clearSearch && window.clearSearch()"
                title="Limpiar búsqueda"
                type="button"
              >
                <span class="material-symbols-outlined text-[18px]">backspace</span>
                <span>Limpiar</span>
              </button>
            </div>

            <!-- Clean Category Filter Pills -->
            <div class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
              <button
                class="cat-pill active-cat px-4 py-1.5 rounded-full text-[12px] font-semibold bg-primary text-on-primary shrink-0 transition-all flex items-center gap-1.5 shadow-xs cursor-pointer"
                onclick="window.selectCategory && window.selectCategory('all', this)"
                type="button"
              >
                <span class="material-symbols-outlined text-[16px]">apps</span>
                <span>Todos</span>
              </button>
              <button
                class="cat-pill px-3.5 py-1.5 rounded-full text-[12px] font-medium bg-surface-container-lowest hover:bg-surface-container-high text-on-surface shrink-0 transition-all flex items-center gap-1.5 border border-surface-container/60 cursor-pointer"
                onclick="window.selectCategory && window.selectCategory('inventario', this)"
                type="button"
              >
                <span class="material-symbols-outlined text-[16px] text-secondary-container">inventory_2</span>
                <span>Productos de Inventario</span>
              </button>
              <button
                class="cat-pill px-3.5 py-1.5 rounded-full text-[12px] font-medium bg-surface-container-lowest hover:bg-surface-container-high text-on-surface shrink-0 transition-all flex items-center gap-1.5 border border-surface-container/60 cursor-pointer"
                onclick="window.selectCategory && window.selectCategory('servicio', this)"
                type="button"
              >
                <span class="material-symbols-outlined text-[16px] text-secondary">handyman</span>
                <span>Servicios Técnicos</span>
              </button>
              <button
                class="cat-pill px-3.5 py-1.5 rounded-full text-[12px] font-medium bg-surface-container-lowest hover:bg-surface-container-high text-on-surface shrink-0 transition-all flex items-center gap-1.5 border border-surface-container/60 cursor-pointer"
                onclick="window.selectCategory && window.selectCategory('consumibles', this)"
                type="button"
              >
                <span class="material-symbols-outlined text-[16px]">local_cafe</span>
                <span>Bebidas y Consumibles</span>
              </button>
              <button
                class="cat-pill px-3.5 py-1.5 rounded-full text-[12px] font-medium bg-surface-container-lowest hover:bg-surface-container-high text-on-surface shrink-0 transition-all flex items-center gap-1.5 border border-surface-container/60 cursor-pointer"
                onclick="window.selectCategory && window.selectCategory('accesorios', this)"
                type="button"
              >
                <span class="material-symbols-outlined text-[16px]">devices_other</span>
                <span>Accesorios</span>
              </button>
            </div>

            <!-- Simplified, Readable Grid of Catalog Items -->
            <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4">
              
              <!-- Product 1 -->
              <div
                class="product-item bg-surface-container-lowest rounded-xl p-3 border border-surface-container/60 shadow-xs flex flex-col justify-between group hover:shadow-md transition-all"
                data-category="inventario accesorios"
              >
                <div>
                  <div class="relative w-full h-28 rounded-lg overflow-hidden bg-surface-container-low mb-2">
                    <img
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      alt="Lector Láser 2D Inalámbrico"
                      src="https://lh3.googleusercontent.com/aida-public/AB6AXuD3NC9zilWFQG7afVIZ8b8U-ro2A7K59vIsS51zes0leeIRJCrGJpEPt7glD5zlOUh5I7E-h71sSoKEZhapRIDF7H8WNu-EOamxWg3kbnahC49rZGKNtd4fRwF6eTgFOmSvZaAqLBv2OM3UCf03oPEVwSqATRRWNkgQd7QtkiLqY5_1b4A_jFcUMqMOZrbDv42Pjy24blmrESxtZGW9AxrjSqmmxTyaSpFEY6IEucX-P_u6jCtVtYqSsw"
                    />
                    <span class="absolute top-1.5 left-1.5 text-[10px] font-semibold bg-surface-container-lowest/90 px-1.5 py-0.5 rounded text-on-surface backdrop-blur-xs">
                      Producto
                    </span>
                    <span class="absolute bottom-1.5 right-1.5 text-[10px] font-bold bg-tertiary-container text-on-tertiary-container px-1.5 py-0.5 rounded">
                      Stock: 18
                    </span>
                  </div>
                  <div class="flex flex-col gap-0.5 mb-2">
                    <h4 class="text-[13px] font-semibold text-on-surface line-clamp-1">Lector Láser 2D Inalámbrico</h4>
                    <span class="text-[11px] text-on-surface-variant">SKU: BAR-204</span>
                  </div>
                </div>
                <div class="flex items-center justify-between pt-2 border-t border-surface-container/40">
                  <span class="text-[16px] text-primary font-bold">$78.50</span>
                  <button
                    class="h-8 px-3 rounded-lg bg-secondary-container hover:bg-secondary text-on-secondary text-[12px] font-semibold flex items-center gap-1 shadow-2xs active:scale-95 transition-all cursor-pointer"
                    onclick="window.addToTicket && window.addToTicket('Lector Láser 2D Inalámbrico', 78.50, 'BAR-204', 'Producto')"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[16px]">add</span>
                    <span>Agregar</span>
                  </button>
                </div>
              </div>

              <!-- Product 2 -->
              <div
                class="product-item bg-surface-container-lowest rounded-xl p-3 border border-surface-container/60 shadow-xs flex flex-col justify-between group hover:shadow-md transition-all"
                data-category="inventario consumibles"
              >
                <div>
                  <div class="relative w-full h-28 rounded-lg overflow-hidden bg-surface-container-low mb-2">
                    <img
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      alt="Rollo Térmico 80mm"
                      src="https://lh3.googleusercontent.com/aida-public/AB6AXuDXcHMud47RHkqAiEcJpGAEsYl4VzRgDYW3ssRN108VCxUBv_MTUfzBWCkyJgVmOz8CcJYFiAq3sH5DfiBPQ6LTWZ_UNjXswPsELp6fFJ0IccXEvTi3W8VpR1RCnIHqeznexYFUYU-7AVIEgektuTV5aL6Rl7v281oyjCOBQRxLjkVg9GIDfUgga-cuxz1qB299gqfiaRFA1x1qVzEwuI0ViZn3L9JoS6eZ4LXdprsuTE-ZpR4N2JsOQw"
                    />
                    <span class="absolute top-1.5 left-1.5 text-[10px] font-semibold bg-surface-container-lowest/90 px-1.5 py-0.5 rounded text-on-surface backdrop-blur-xs">
                      Producto
                    </span>
                    <span class="absolute bottom-1.5 right-1.5 text-[10px] font-bold bg-tertiary-container text-on-tertiary-container px-1.5 py-0.5 rounded">
                      Stock: 142
                    </span>
                  </div>
                  <div class="flex flex-col gap-0.5 mb-2">
                    <h4 class="text-[13px] font-semibold text-on-surface line-clamp-1">Rollo Térmico 80mm (Pack x5)</h4>
                    <span class="text-[11px] text-on-surface-variant">SKU: PAP-80M</span>
                  </div>
                </div>
                <div class="flex items-center justify-between pt-2 border-t border-surface-container/40">
                  <span class="text-[16px] text-primary font-bold">$12.00</span>
                  <button
                    class="h-8 px-3 rounded-lg bg-secondary-container hover:bg-secondary text-on-secondary text-[12px] font-semibold flex items-center gap-1 shadow-2xs active:scale-95 transition-all cursor-pointer"
                    onclick="window.addToTicket && window.addToTicket('Rollo Térmico 80mm (Pack x5)', 12.00, 'PAP-80M', 'Producto')"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[16px]">add</span>
                    <span>Agregar</span>
                  </button>
                </div>
              </div>

              <!-- Product 3 -->
              <div
                class="product-item bg-surface-container-lowest rounded-xl p-3 border border-surface-container/60 shadow-xs flex flex-col justify-between group hover:shadow-md transition-all"
                data-category="consumibles"
              >
                <div>
                  <div class="relative w-full h-28 rounded-lg overflow-hidden bg-surface-container-low mb-2">
                    <img
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      alt="Café de Origen Tostado 500g"
                      src="https://lh3.googleusercontent.com/aida-public/AB6AXuDPpzJ7xRMtGeLfLw_fOF9ZJhxhgP80j4mS7KGqesFdXQFLQmaeTRyA3DD9qF3Ja4ObzW8bdqhXi7GYa3x_accJLK6yPG0GPfqeMPVkRbUNtr2mNM4wTXFha9SpwHK1l10tnhC-fjhWqL8hLdxEurbwk39IPg_yzrYFwjR_SGrMMB9U56DvUUB2JN26WRl0bBYUCilb6vvk3huvMOuHBn9CxpTOto_17CF288K3y7JKz7wkUB4GiMiKgw"
                    />
                    <span class="absolute top-1.5 left-1.5 text-[10px] font-semibold bg-surface-container-lowest/90 px-1.5 py-0.5 rounded text-on-surface backdrop-blur-xs">
                      Producto
                    </span>
                    <span class="absolute bottom-1.5 right-1.5 text-[10px] font-bold bg-tertiary-container text-on-tertiary-container px-1.5 py-0.5 rounded">
                      Stock: 45
                    </span>
                  </div>
                  <div class="flex flex-col gap-0.5 mb-2">
                    <h4 class="text-[13px] font-semibold text-on-surface line-clamp-1">Café de Origen Tostado 500g</h4>
                    <span class="text-[11px] text-on-surface-variant">SKU: CAF-500</span>
                  </div>
                </div>
                <div class="flex items-center justify-between pt-2 border-t border-surface-container/40">
                  <span class="text-[16px] text-primary font-bold">$16.50</span>
                  <button
                    class="h-8 px-3 rounded-lg bg-secondary-container hover:bg-secondary text-on-secondary text-[12px] font-semibold flex items-center gap-1 shadow-2xs active:scale-95 transition-all cursor-pointer"
                    onclick="window.addToTicket && window.addToTicket('Café de Origen Tostado 500g', 16.50, 'CAF-500', 'Producto')"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[16px]">add</span>
                    <span>Agregar</span>
                  </button>
                </div>
              </div>

              <!-- Product 4 -->
              <div
                class="product-item bg-surface-container-lowest rounded-xl p-3 border border-surface-container/60 shadow-xs flex flex-col justify-between group hover:shadow-md transition-all"
                data-category="consumibles"
              >
                <div>
                  <div class="relative w-full h-28 rounded-lg overflow-hidden bg-surface-container-low flex items-center justify-center mb-2">
                    <span class="material-symbols-outlined text-[42px] text-secondary-container">water_bottle</span>
                    <span class="absolute top-1.5 left-1.5 text-[10px] font-semibold bg-surface-container-lowest/90 px-1.5 py-0.5 rounded text-on-surface">
                      Producto
                    </span>
                    <span class="absolute bottom-1.5 right-1.5 text-[10px] font-bold bg-error-container text-error px-1.5 py-0.5 rounded">
                      Stock: 4
                    </span>
                  </div>
                  <div class="flex flex-col gap-0.5 mb-2">
                    <h4 class="text-[13px] font-semibold text-on-surface line-clamp-1">Agua Mineral Alcalina 600ml</h4>
                    <span class="text-[11px] text-on-surface-variant">SKU: BEB-012</span>
                  </div>
                </div>
                <div class="flex items-center justify-between pt-2 border-t border-surface-container/40">
                  <span class="text-[16px] text-primary font-bold">$2.50</span>
                  <button
                    class="h-8 px-3 rounded-lg bg-secondary-container hover:bg-secondary text-on-secondary text-[12px] font-semibold flex items-center gap-1 shadow-2xs active:scale-95 transition-all cursor-pointer"
                    onclick="window.addToTicket && window.addToTicket('Agua Mineral Alcalina 600ml', 2.50, 'BEB-012', 'Producto')"
