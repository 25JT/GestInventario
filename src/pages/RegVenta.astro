  <!-- NOTIFICATION TOAST GLOBAL -->
  <div
    id="posToast"
    class="fixed bottom-6 right-6 z-50 hidden bg-primary text-on-primary px-4 py-3 rounded-xl shadow-xl flex items-center gap-2.5 transition-all pointer-events-none"
  >
    <span id="toastIcon" class="material-symbols-outlined text-secondary-fixed text-[20px]">check_circle</span>
    <span id="toastMessage" class="text-[13px] font-medium">Venta procesada con éxito</span>
  </div>

  <script>
    import {
      initVentas,
      switchPosView,
      filterCategoryPills,
      filterProductsLive,
      addProductToTicket,
      clearActiveCart,
      selectPaymentMethod,
      openCustomerModal,
      closeCustomerModal,
      showPosToast,
    } from "../animaciones/animaVentas.js";

    // Exponer al scope global para enlaces HTML nativos
    window.switchView = switchPosView;
    window.selectCategory = filterCategoryPills;
    window.filterProducts = filterProductsLive;
    window.addToTicket = addProductToTicket;
    window.clearCart = clearActiveCart;
    window.setPaymentMethod = selectPaymentMethod;
    window.openNewCustomerModal = openCustomerModal;
    window.closeNewCustomerModal = closeCustomerModal;
    window.showPosToast = showPosToast;

    window.simulateBarcodeScan = function() {
      const input = document.getElementById("productSearch") as HTMLInputElement | null;
      if (input) {
        input.value = "BAR-204";
        filterProductsLive();
      }
      addProductToTicket("Lector Láser 2D Inalámbrico", 78.50, "BAR-204", "Producto");
      showPosToast("Código de barras detectado: BAR-204");
    };

    window.clearSearch = function() {
      const input = document.getElementById("productSearch") as HTMLInputElement | null;
      if (input) input.value = "";
      filterProductsLive();
    };

    window.saveQuickCustomer = function() {
      const nameInput = document.getElementById("newCustName") as HTMLInputElement | null;
      const docInput = document.getElementById("newCustDoc") as HTMLInputElement | null;
      const name = nameInput?.value.trim() || "";
      const doc = docInput?.value.trim() || "";

      if (!name) {
        showPosToast("Por favor ingrese el nombre del cliente", "warning");
        return;
      }

      const currentCustEl = document.getElementById("currentCustomerName");
      if (currentCustEl) {
        currentCustEl.textContent = `${name}${doc ? " (" + doc + ")" : ""}`;
      }

      closeCustomerModal();
      showPosToast("Cliente asociado exitosamente.");
    };

    window.processCheckout = function() {
      const countEl = document.getElementById("cartCount");
      const count = parseInt(countEl?.textContent || "0", 10);
      if (count === 0) {
        showPosToast("El ticket está vacío. Agregue productos antes de procesar.", "warning");
        return;
      }
      showPosToast("Factura #V-0842 emitida e impresa correctamente.");
      setTimeout(() => {
        clearActiveCart();
      }, 900);
    };

    window.holdTicket = function() {
      showPosToast("Venta guardada en espera temporalmente.", "info");
      clearActiveCart();
    };

    window.resumeHeldTicket = function() {
      switchPosView("pos");
      showPosToast("Orden #ESP-2024-0839 reanudada en terminal.");
    };

    // Hidratar nombre de vendedor según la sesión activa
    function loadCashierSession() {
      try {
        const raw = localStorage.getItem("stock_auth_user") || sessionStorage.getItem("stock_auth_user");
        if (raw) {
          const user = JSON.parse(raw);
          const name = (user.name || user.nombre || "Luis Torres").trim();
          const cashierEl = document.getElementById("pos-cashier-name");
          if (cashierEl) cashierEl.textContent = name;
        }
      } catch (e) {}
    }

    // Inicializar eventos de teclado y componentes
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        loadCashierSession();
        initVentas();
        const searchInput = document.getElementById("productSearch");
        if (searchInput) {
          searchInput.addEventListener("input", filterProductsLive);
        }
      });
    } else {
      loadCashierSession();
      initVentas();
      const searchInput = document.getElementById("productSearch");
      if (searchInput) {
        searchInput.addEventListener("input", filterProductsLive);
      }
    }
  </script>
