---
// RegVenta.astro - Terminal de Punto de Venta (POS) y Facturación
import Layout from "../layouts/Layout.astro";
import SlideBar from "../components/SlideBar.astro";
import NavBar from "../components/Nav.astro";
---

<Layout title="Registro de Ventas - StockControl Enterprise JR">
  <div class="min-h-screen bg-surface flex flex-col font-body-md text-on-surface">
    {/* Barra lateral y superior globales y responsivas */}
    <SlideBar currentPath="ventas" />
    <NavBar storeName="Central Sucursal 01" operationStatus="Caja Abierta" />

    {/* Contenedor principal */}
    <div id="app-content" class="pt-16 min-h-screen flex flex-col flex-1">
      <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">

        <!-- Top Context & Mode Switcher Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 bg-surface-container-lowest p-3 sm:p-4 rounded-xl border border-surface-container/60 shadow-xs">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-1 bg-surface-container/60 p-1 rounded-xl">
              <button
                id="tab-pos"
                class="px-3.5 py-1.5 rounded-lg text-[13px] font-semibold bg-surface-container-lowest text-primary shadow-xs transition-all flex items-center gap-1.5 cursor-pointer"
                type="button"
                onclick="window.switchView && window.switchView('pos')"
              >
                <span class="material-symbols-outlined text-[18px]">point_of_sale</span>
                <span>Terminal POS</span>
              </button>
              <button
                id="tab-history"
                class="px-3.5 py-1.5 rounded-lg text-[13px] font-medium text-on-surface-variant hover:text-on-surface transition-all flex items-center gap-1.5 cursor-pointer"
                type="button"
                onclick="window.switchView && window.switchView('history')"
              >
                <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                <span>Historial y Facturación</span>
                <span class="bg-surface-variant text-on-surface-variant text-[10px] font-bold px-1.5 py-0.5 rounded-full">
                  24 Hoy
                </span>
              </button>
            </div>
          </div>

          <div class="flex items-center gap-2 sm:gap-3">
            {/* Vendedor activo */}
            <div class="hidden sm:flex items-center gap-1.5 bg-surface-container-low px-3 py-1.5 rounded-xl border border-surface-container/50">
              <span class="material-symbols-outlined text-[16px] text-secondary">badge</span>
              <span class="text-[11px] text-on-surface-variant">Vendedor:</span>
              <span id="pos-cashier-name" class="text-[12px] font-semibold text-on-surface">Cargando...</span>
              <span class="bg-tertiary-container/20 text-on-tertiary-container text-[10px] font-bold px-1.5 py-0.2 rounded-full">
                Turno Activo
              </span>
            </div>

            {/* Caja actual */}
            <div class="flex items-center gap-2 bg-surface-container-low px-3 py-1.5 rounded-xl border border-surface-container/50">
              <span class="text-[11px] text-on-surface-variant">Caja:</span>
              <span class="text-[12px] font-bold text-on-surface">Principal 01</span>
              <span class="inline-block w-2 h-2 rounded-full bg-on-tertiary-container"></span>
            </div>
          </div>
        </div>

        <!-- VIEW 1: POS WORKSTATION -->
        <div id="view-pos" class="flex flex-col lg:flex-row gap-6 items-start w-full min-w-0">
          
          <!-- Left Column: Catalog & Search (8 cols aprox) -->
          <div class="flex-1 min-w-0 w-full flex flex-col gap-4">
            
            <!-- Clean Header & Search Bar -->
            <div class="bg-surface-container-lowest p-3 sm:p-4 rounded-xl border border-surface-container/60 shadow-xs flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center">
              <div class="relative flex-1">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">
                  search
                </span>
                <input
                  id="productSearch"
                  class="w-full h-10 pl-10 pr-24 bg-surface rounded-xl text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all"
                  placeholder="Buscar producto, servicio o escanear código de barras..."
                  type="text"
                />
                <div class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center gap-1.5">
                  <button
                    class="flex items-center text-on-surface-variant hover:text-secondary-container transition-colors cursor-pointer"
                    onclick="window.simulateBarcodeScan && window.simulateBarcodeScan()"
                    title="Escanear código (F2)"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[20px]">barcode_scanner</span>
                  </button>
                  <kbd class="bg-surface-container px-1.5 py-0.5 rounded text-[10px] text-on-surface-variant font-semibold">
                    F2
                  </kbd>
                </div>
              </div>

              <button
                class="h-10 px-3.5 bg-surface-container-low hover:bg-surface-container text-on-surface-variant hover:text-on-surface text-[12px] font-medium rounded-xl flex items-center justify-center gap-1.5 shrink-0 transition-colors cursor-pointer"
                onclick="window.clearSearch && window.clearSearch()"
                title="Limpiar búsqueda"
                type="button"
              >
                <span class="material-symbols-outlined text-[18px]">backspace</span>
                <span>Limpiar</span>
              </button>
            </div>

            <!-- Category Filter Pills (Generadas dinámicamente) -->
            <div id="cat-pills-container" class="flex items-center gap-2 overflow-x-auto pb-1 no-scrollbar">
              <button
                class="cat-pill active-cat px-4 py-1.5 rounded-full text-[12px] font-semibold bg-primary text-on-primary shrink-0 transition-all flex items-center gap-1.5 shadow-xs cursor-pointer"
                onclick="window.selectCategory && window.selectCategory('all', this)"
                type="button"
              >
                <span class="material-symbols-outlined text-[16px]">apps</span>
                <span>Todos</span>
              </button>
            </div>

            <!-- Grid de Catálogo de Productos y Servicios (Cargado dinámicamente de la BD) -->
            <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4">
              <!-- Cargando items de la base de datos... -->
            </div>

            <!-- Estado Vacío cuando no hay resultados de búsqueda -->
            <div id="catalog-empty" class="hidden flex-col items-center justify-center p-12 bg-surface-container-lowest rounded-xl border border-surface-container/60 text-center gap-2">
              <span class="material-symbols-outlined text-[48px] text-on-surface-variant/40">inventory_2</span>
              <h4 class="text-[15px] font-semibold text-on-surface">No se encontraron productos o servicios</h4>
              <p class="text-[12px] text-on-surface-variant">Intenta con otro término de búsqueda o selecciona otra categoría.</p>
            </div>
          </div>

          <!-- Right Column: Streamlined Order Ticket / Cart (4 cols aprox) -->
          <div class="w-full lg:w-[360px] xl:w-[380px] shrink-0 flex flex-col gap-4">
            <div class="bg-surface-container-lowest rounded-xl border border-surface-container/60 shadow-xs p-4 flex flex-col">
              
              <!-- Ticket Header -->
              <div class="flex items-center justify-between pb-3 border-b border-surface-container/60">
                <div class="flex flex-col gap-0.5">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-secondary-container animate-pulse"></span>
                    <span class="text-[16px] font-bold text-primary">Ticket #V-0842</span>
                  </div>
                  <div class="flex items-center gap-1 text-[11px] text-on-surface-variant">
                    <span class="material-symbols-outlined text-[14px] text-secondary">person</span>
                    <span>Atendido por: <strong id="ticket-cashier-name" class="text-on-surface font-semibold">Cargando...</strong></span>
                  </div>
                </div>
                <div class="flex flex-col items-end gap-0.5">
                  <span class="text-[11px] bg-surface-container px-2 py-0.5 rounded text-on-surface-variant font-medium">
                    En Edición
                  </span>
                  <span class="text-[10px] text-on-surface-variant">Caja 01</span>
                </div>
              </div>

              <!-- Customer Selector Bar -->
              <div class="bg-surface-container-low p-2.5 rounded-xl flex items-center justify-between my-3 border border-surface-container/50">
                <div class="flex items-center gap-2 min-w-0">
                  <span class="material-symbols-outlined text-[20px] text-on-surface-variant shrink-0">account_circle</span>
                  <div class="flex flex-col min-w-0">
                    <span class="text-[10px] text-on-surface-variant uppercase font-semibold">Cliente</span>
                    <span id="currentCustomerName" class="text-[12px] font-semibold text-on-surface truncate">
                      Cliente General / Mostrador
                    </span>
                  </div>
                </div>
                <button
                  class="px-2.5 py-1 bg-surface-container-lowest hover:bg-surface-container text-secondary text-[11px] font-semibold rounded-lg shrink-0 transition-colors flex items-center gap-1 cursor-pointer border border-surface-container/60"
                  onclick="window.openNewCustomerModal && window.openNewCustomerModal()"
                  type="button"
                >
                  <span class="material-symbols-outlined text-[14px]">edit</span>
                  <span>Cambiar</span>
                </button>
              </div>

              <!-- Order Items Header -->
              <div class="flex items-center justify-between py-1 text-on-surface-variant text-[11px] font-semibold uppercase tracking-wider">
                <span>PRODUCTOS (<span id="cartCount">0</span>)</span>
                <button
                  class="text-error hover:underline flex items-center gap-0.5 text-[11px] font-normal cursor-pointer"
                  onclick="window.clearCart && window.clearCart()"
                  type="button"
                >
                  <span class="material-symbols-outlined text-[14px]">delete_sweep</span>
                  <span>Vaciar</span>
                </button>
              </div>

              <!-- Added Items List (Vacío por defecto) -->
              <div id="cartItemsList" class="flex flex-col gap-2 max-h-[250px] overflow-y-auto pr-0.5 py-1">
                <!-- Se poblará en tiempo real con las selecciones -->
              </div>
              <div id="cartEmptyState" class="flex flex-col items-center justify-center py-6 text-center text-on-surface-variant/70 gap-1.5 border border-dashed border-surface-container rounded-xl">
                <span class="material-symbols-outlined text-[28px] text-on-surface-variant/40">shopping_cart</span>
                <span class="text-[12px] font-medium">Ticket sin artículos</span>
                <span class="text-[10px] text-on-surface-variant/60">Haz clic en "Agregar" en el catálogo para registrar</span>
              </div>

              <!-- Simple 3-Button Payment Method Selector -->
              <div class="mt-3 pt-2 border-t border-surface-container/50">
                <span class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider block mb-1.5">
                  Método de Pago
                </span>
                <div class="grid grid-cols-3 gap-2">
                  <button
                    class="pay-btn flex flex-col items-center justify-center py-2 px-1 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface text-center transition-all cursor-pointer"
                    onclick="window.setPaymentMethod && window.setPaymentMethod('cash', this)"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[18px]">payments</span>
                    <span class="text-[11px] font-medium mt-0.5">Efectivo</span>
                  </button>
                  <button
                    class="pay-btn flex flex-col items-center justify-center py-2 px-1 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface text-center transition-all cursor-pointer"
                    onclick="window.setPaymentMethod && window.setPaymentMethod('card', this)"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[18px]">credit_card</span>
                    <span class="text-[11px] font-medium mt-0.5">Tarjeta</span>
                  </button>
                  <button
                    class="pay-btn flex flex-col items-center justify-center py-2 px-1 rounded-xl bg-primary text-on-primary text-center transition-all shadow-xs cursor-pointer"
                    onclick="window.setPaymentMethod && window.setPaymentMethod('transfer', this)"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[18px]">account_balance</span>
                    <span class="text-[11px] font-medium mt-0.5">Transf.</span>
                  </button>
                </div>
              </div>

              <!-- Summary Box -->
              <div class="mt-3 bg-surface-container-low p-3 rounded-xl flex flex-col gap-1.5 border border-surface-container/50">
                <div class="flex items-center justify-between text-[12px] text-on-surface-variant">
                  <span>Subtotal</span>
                  <span id="summarySubtotal" class="font-semibold text-on-surface">$ 0</span>
                </div>
                <div class="flex items-center justify-between text-[12px] text-on-surface-variant">
                  <span>Impuestos (Incluidos)</span>
                  <span id="summaryTax" class="font-semibold text-on-surface">$ 0</span>
                </div>
                <div class="pt-2 mt-1 border-t border-surface-container/60 flex items-baseline justify-between">
                  <span class="text-[14px] font-bold text-primary">Total a Pagar</span>
                  <span id="summaryTotal" class="text-[24px] font-bold text-primary tracking-tight">$ 0</span>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="flex flex-col gap-2 mt-4">
                <button
                  id="btnCheckoutAction"
                  class="w-full h-11 bg-on-tertiary-container hover:bg-tertiary text-on-tertiary rounded-xl text-[14px] font-bold shadow-xs hover:shadow-md flex items-center justify-center gap-2 transition-all active:scale-[0.99] cursor-pointer"
                  onclick="window.processCheckout && window.processCheckout()"
                  type="button"
                >
                  <span class="material-symbols-outlined text-[20px]">point_of_sale</span>
                  <span id="btnCheckoutLabel">Cobrar y Facturar ($ 0)</span>
                </button>
                <div class="grid grid-cols-2 gap-2">
                  <button
                    class="h-9 bg-surface-container-low hover:bg-surface-container text-on-surface text-[12px] font-semibold rounded-xl flex items-center justify-center gap-1.5 transition-colors cursor-pointer border border-surface-container/60"
                    onclick="window.holdTicket && window.holdTicket()"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[17px]">pause_circle</span>
                    <span>En Espera</span>
                  </button>
                  <button
                    class="h-9 bg-error-container/60 hover:bg-error-container text-error text-[12px] font-semibold rounded-xl flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
                    onclick="window.clearCart && window.clearCart()"
                    type="button"
                  >
                    <span class="material-symbols-outlined text-[17px]">cancel</span>
                    <span>Cancelar</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- VIEW 2: SALES HISTORY & TRANSACTION CRUD (Initially Hidden) -->
        <div id="view-history" class="flex flex-col gap-6 hidden">
          
          <!-- KPI Summary Row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between">
              <div class="flex items-center justify-between text-on-surface-variant mb-1">
                <span id="hist-period-title" class="text-[12px] font-medium">Ventas del Periodo</span>
                <span class="text-[11px] text-on-tertiary-container bg-tertiary-container/20 px-2 py-0.5 rounded-lg font-semibold">
                  Sincronizado
                </span>
              </div>
              <span id="hist-total-ventas" class="text-[26px] font-bold text-on-surface tracking-tight mt-1">$ 0</span>
              <span id="hist-count-ventas" class="text-[12px] text-on-surface-variant mt-1">0 transacciones registradas</span>
            </div>

            <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between">
              <div class="flex items-center justify-between text-on-surface-variant mb-1">
                <span class="text-[12px] font-medium">Ticket Promedio</span>
                <span class="text-[11px] text-secondary bg-secondary-fixed/50 px-2 py-0.5 rounded-lg font-semibold">
                  Promedio
                </span>
              </div>
              <span id="hist-avg-ticket" class="text-[26px] font-bold text-on-surface tracking-tight mt-1">$ 0</span>
              <span class="text-[12px] text-on-surface-variant mt-1">Monto promedio por factura</span>
            </div>

            <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between">
              <div class="flex items-center justify-between text-on-surface-variant mb-1">
                <span class="text-[12px] font-medium">Artículos Vendidos</span>
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">shopping_bag</span>
              </div>
              <span id="hist-total-items" class="text-[26px] font-bold text-on-surface tracking-tight mt-1">0</span>
              <span class="text-[12px] text-on-surface-variant mt-1">Unidades despachadas</span>
            </div>

            <div class="bg-surface-container-lowest p-4 sm:p-5 rounded-xl border border-surface-container/60 shadow-xs flex flex-col justify-between">
              <div class="flex items-center justify-between text-on-surface-variant mb-1">
                <span class="text-[12px] font-medium">Estado Operativo</span>
                <span class="text-[11px] text-tertiary bg-tertiary-container/20 px-2 py-0.5 rounded-lg font-semibold">En Línea</span>
              </div>
              <span class="text-[26px] font-bold text-secondary tracking-tight mt-1">Caja Activa</span>
              <span id="hist-active-cashier-label" class="text-[12px] text-on-surface-variant mt-1">Cajero: Activo</span>
            </div>
          </div>

          <!-- Filters & Control Toolbar -->
          <div class="bg-surface-container-lowest p-3 sm:p-4 rounded-xl border border-surface-container/60 shadow-xs flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2 flex-1 min-w-[260px]">
              <!-- Search in History -->
              <div class="relative min-w-[200px] flex-1 sm:flex-none">
                <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[16px]">
                  search
                </span>
                <input
                  id="history-search"
                  class="w-full h-8 pl-8 pr-3 bg-surface rounded-xl text-[12px] text-on-surface placeholder:text-on-surface-variant/70 border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary"
                  placeholder="Buscar factura o vendedor..."
                  type="text"
                />
              </div>

              <!-- Date Period Filter (4 periodos solicitados) -->
              <div class="flex items-center gap-1 bg-surface rounded-xl px-2 h-8 border border-surface-container/60">
                <span class="material-symbols-outlined text-on-surface-variant text-[16px]">calendar_today</span>
                <select id="history-period-select" class="bg-transparent text-[12px] text-on-surface focus:outline-none pr-1 cursor-pointer">
                  <option value="hoy" selected>El día de hoy</option>
                  <option value="ayer">El día anterior (Ayer)</option>
                  <option value="semana">La semana anterior</option>
                  <option value="mes">Lo que lleva del mes</option>
                </select>
              </div>

              <!-- Seller Filter -->
              <div class="flex items-center gap-1 bg-surface rounded-xl px-2 h-8 border border-surface-container/60">
                <span class="material-symbols-outlined text-on-surface-variant text-[16px]">person</span>
                <select id="history-seller-select" class="bg-transparent text-[12px] text-on-surface focus:outline-none pr-1 cursor-pointer">
                  <option value="all" selected>Todos los Vendedores</option>
                </select>
              </div>

              <!-- Status Filter -->
              <div class="flex items-center gap-1 bg-surface rounded-xl px-2 h-8 border border-surface-container/60">
                <span class="material-symbols-outlined text-on-surface-variant text-[16px]">filter_list</span>
                <select id="history-status-select" class="bg-transparent text-[12px] text-on-surface focus:outline-none pr-1 cursor-pointer">
                  <option value="all" selected>Todos los Estados</option>
                  <option value="COMPLETADA">Completada</option>
                  <option value="ANULADA">Anulada</option>
                </select>
              </div>
            </div>

            <!-- Export / Actions -->
            <div class="flex items-center gap-2">
              <button
                class="h-8 px-3 bg-surface-container-low hover:bg-surface-container text-on-surface text-[12px] font-medium rounded-xl flex items-center gap-1.5 transition-colors cursor-pointer border border-surface-container/60"
                type="button"
                onclick="window.showPosToast && window.showPosToast('Exportando historial a CSV...', 'info')"
              >
                <span class="material-symbols-outlined text-[16px]">download</span>
                <span>Exportar CSV</span>
              </button>
              <button
                class="h-8 px-3 bg-surface-container-low hover:bg-surface-container text-on-surface text-[12px] font-medium rounded-xl flex items-center gap-1.5 transition-colors cursor-pointer border border-surface-container/60"
                type="button"
                onclick="window.showPosToast && window.showPosToast('Imprimiendo Cierre Z Fiscal...', 'info')"
              >
                <span class="material-symbols-outlined text-[16px]">print</span>
                <span>Cierre Z / Fiscal</span>
              </button>
            </div>
          </div>

          <!-- Transactions CRUD Table -->
          <div class="bg-surface-container-lowest rounded-xl border border-surface-container/60 shadow-xs overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-[13px]">
                <thead>
                  <tr class="bg-surface-container-low h-10 text-on-surface-variant uppercase text-[11px] tracking-wider border-b border-surface-container/60">
                    <th class="py-2 px-4 font-semibold">Ticket / Factura</th>
                    <th class="py-2 px-4 font-semibold">Fecha y Hora</th>
                    <th class="py-2 px-4 font-semibold">Cliente</th>
                    <th class="py-2 px-4 font-semibold">Vendedor</th>
                    <th class="py-2 px-4 font-semibold">Método</th>
                    <th class="py-2 px-4 font-semibold text-right">Items</th>
                    <th class="py-2 px-4 font-semibold text-right">Monto Total</th>
                    <th class="py-2 px-4 font-semibold">Estado</th>
                    <th class="py-2 px-4 font-semibold text-right">Acciones</th>
                  </tr>
                </thead>
                <tbody id="history-table-body" class="divide-y divide-surface-container/40">
                  <!-- Se cargará dinámicamente con los registros de la base de datos -->
                </tbody>
              </table>
            </div>

            <!-- Table Pagination & Metrics Info -->
            <div class="p-3 bg-surface-container-low flex flex-col sm:flex-row items-center justify-between gap-3 text-[12px] text-on-surface-variant border-t border-surface-container/60">
              <span id="history-pagination-info">Cargando transacciones registradas...</span>
              <div class="flex items-center gap-1">
                <button class="px-2.5 py-1 bg-surface-container-lowest rounded-lg hover:bg-surface-container text-on-surface cursor-pointer border border-surface-container/60 flex items-center gap-1" type="button" onclick="window.refreshHistory && window.refreshHistory()">
                  <span class="material-symbols-outlined text-[14px]">refresh</span>
                  <span>Actualizar</span>
                </button>
              </div>
            </div>
          </div>
        </div>

      </main>
    </div>
  </div>

  <!-- MODAL: FAST NEW CUSTOMER CREATION -->
  <div
    id="customerModal"
    class="fixed inset-0 z-50 hidden flex items-center justify-center bg-primary/40 backdrop-blur-xs p-4"
    aria-hidden="true"
  >
    <div
      id="customerModalPanel"
      class="bg-surface-container-lowest rounded-2xl max-w-md w-full shadow-2xl p-5 sm:p-6 flex flex-col gap-4 border border-surface-container"
    >
      <div class="flex items-center justify-between pb-1 border-b border-surface-container/60">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed">
            <span class="material-symbols-outlined text-[20px]">person_add</span>
          </div>
          <h3 class="text-[17px] font-bold text-on-surface">Registrar Cliente Rápido</h3>
        </div>
        <button
          class="text-on-surface-variant hover:text-on-surface p-1 rounded-lg hover:bg-surface-container transition-colors cursor-pointer"
          onclick="window.closeNewCustomerModal && window.closeNewCustomerModal()"
          type="button"
        >
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>

      <div class="flex flex-col gap-3">
        <div class="flex flex-col gap-1">
          <label class="text-[12px] font-semibold text-on-surface uppercase tracking-wide">
            Nombre Completo o Razón Social *
          </label>
          <input
            id="newCustName"
            class="w-full h-9 px-3 bg-surface rounded-xl text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all"
            placeholder="Ej. Soluciones Logísticas C.A."
            type="text"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="flex flex-col gap-1">
            <label class="text-[12px] font-semibold text-on-surface uppercase tracking-wide">
              Documento / RIF / CI *
            </label>
            <input
              id="newCustDoc"
              class="w-full h-9 px-3 bg-surface rounded-xl text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all"
              placeholder="J-12345678-0"
              type="text"
            />
          </div>
          <div class="flex flex-col gap-1">
            <label class="text-[12px] font-semibold text-on-surface uppercase tracking-wide">
              Teléfono
            </label>
            <input
              id="newCustPhone"
              class="w-full h-9 px-3 bg-surface rounded-xl text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all"
              placeholder="+58 412 000-0000"
              type="text"
            />
          </div>
        </div>

        <div class="flex flex-col gap-1">
          <label class="text-[12px] font-semibold text-on-surface uppercase tracking-wide">
            Correo Electrónico (Factura Digital)
          </label>
          <input
            id="newCustEmail"
            class="w-full h-9 px-3 bg-surface rounded-xl text-[13px] text-on-surface placeholder:text-on-surface-variant/70 border border-transparent hover:border-surface-container focus:outline-none focus:border-secondary focus:bg-surface-container-lowest transition-all"
            placeholder="facturacion@empresa.com"
            type="email"
          />
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-surface-container/60">
        <button
          class="px-4 h-9 bg-surface-container-low hover:bg-surface-container text-on-surface text-[12px] font-medium rounded-xl transition-colors cursor-pointer"
          onclick="window.closeNewCustomerModal && window.closeNewCustomerModal()"
          type="button"
        >
          Cancelar
        </button>
        <button
          class="px-4 h-9 bg-secondary-container hover:bg-secondary text-on-secondary text-[12px] font-semibold rounded-xl shadow-xs transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
          onclick="window.saveQuickCustomer && window.saveQuickCustomer()"
          type="button"
        >
          <span class="material-symbols-outlined text-[18px]">check</span>
          <span>Guardar y Asociar</span>
        </button>
      </div>
    </div>
  </div>

  <!-- NOTIFICATION TOAST GLOBAL -->
  <div
    id="posToast"
    class="fixed bottom-6 right-6 z-50 hidden bg-primary text-on-primary px-4 py-3 rounded-xl shadow-xl flex items-center gap-2.5 transition-all pointer-events-none"
  >
    <span id="toastIcon" class="material-symbols-outlined text-secondary-fixed text-[20px]">check_circle</span>
    <span id="toastMessage" class="text-[13px] font-medium">Venta procesada con éxito</span>
  </div>

  <script>
    import {
      initVentas,
      switchPosView,
      filterCategoryPills,
      addProductToTicket,
      clearActiveCart,
      selectPaymentMethod,
      getActivePaymentMethod,
      formatCOP,
      openCustomerModal,
      closeCustomerModal,
      showPosToast,
    } from "../animaciones/animaVentas.js";

    // Exponer al scope global para eventos nativos
    window.switchView = switchPosView;
    window.selectCategory = filterCategoryPills;
    window.addToTicket = addProductToTicket;
    window.clearCart = clearActiveCart;
    window.setPaymentMethod = selectPaymentMethod;
    window.openNewCustomerModal = openCustomerModal;
    window.closeNewCustomerModal = closeCustomerModal;
    window.showPosToast = showPosToast;

    const API_BASE = "http://localhost:3000/api/ventas";

    let catalogItems: any[] = [];
    let currentFilterCat: string = "all";

    // 1. Cargar catálogo de productos y servicios desde la BD
    async function loadPosCatalog() {
      const grid = document.getElementById("product-grid");
      if (!grid) return;

      grid.innerHTML = `
        <div class="col-span-full py-12 flex flex-col items-center justify-center gap-2 text-on-surface-variant">
          <span class="material-symbols-outlined text-[32px] animate-spin text-secondary">sync</span>
          <p class="text-[13px] font-medium">Cargando catálogo en tiempo real...</p>
        </div>
      `;

      try {
        const res = await fetch(`${API_BASE}/catalogo`);
        const json = await res.json();

        if (json.success && json.data) {
          const prods = json.data.productos || [];
          const servs = json.data.servicios || [];
          catalogItems = [...prods, ...servs];

          renderCategoryPills(catalogItems);
          renderCatalogGrid(catalogItems);
        } else {
          grid.innerHTML = `<p class="col-span-full text-center text-error py-8">No se pudo cargar el catálogo.</p>`;
        }
      } catch (err) {
        console.error("Error al cargar catálogo POS:", err);
        grid.innerHTML = `<p class="col-span-full text-center text-error py-8">Error de conexión al cargar catálogo.</p>`;
      }
    }

    // 2. Renderizar píldoras de categorías dinámicas
    function renderCategoryPills(items: any[]) {
      const container = document.getElementById("cat-pills-container");
      if (!container) return;

      // Obtener categorías únicas
      const catsMap = new Map();
      items.forEach((item) => {
        if (item.categoria) {
          catsMap.set(item.categoria, {
            nombre: item.categoria,
            icono: item.categoria_icono || (item.tipo_item === "SERVICIO" ? "handyman" : "inventory_2"),
            prefijo: item.categoria_prefijo || "GEN"
          });
        }
      });

      let html = `
        <button
          class="cat-pill active-cat px-4 py-1.5 rounded-full text-[12px] font-semibold bg-primary text-on-primary shrink-0 transition-all flex items-center gap-1.5 shadow-xs cursor-pointer"
          onclick="window.filterByCat('all', this)"
          type="button"
        >
          <span class="material-symbols-outlined text-[16px]">apps</span>
          <span>Todos (${items.length})</span>
        </button>
      `;

      catsMap.forEach((c) => {
        const count = items.filter((i) => i.categoria === c.nombre).length;
        html += `
          <button
            class="cat-pill px-3.5 py-1.5 rounded-full text-[12px] font-medium bg-surface-container-lowest hover:bg-surface-container-high text-on-surface shrink-0 transition-all flex items-center gap-1.5 border border-surface-container/60 cursor-pointer"
            onclick="window.filterByCat('${c.nombre}', this)"
            type="button"
          >
            <span class="material-symbols-outlined text-[16px] text-secondary">${c.icono}</span>
            <span>${c.nombre} (${count})</span>
          </button>
        `;
      });

      container.innerHTML = html;
    }

    (window as any).filterByCat = function(catName: string, btn: HTMLElement) {
      currentFilterCat = catName;
      document.querySelectorAll(".cat-pill").forEach((el) => {
        el.classList.remove("active-cat", "bg-primary", "text-on-primary", "shadow-xs", "font-semibold");
        el.classList.add("bg-surface-container-lowest", "text-on-surface", "hover:bg-surface-container-high", "font-medium");
      });
      btn.classList.add("active-cat", "bg-primary", "text-on-primary", "shadow-xs", "font-semibold");
      btn.classList.remove("bg-surface-container-lowest", "text-on-surface", "hover:bg-surface-container-high", "font-medium");

      filterProductsLive();
    };

    // 3. Renderizar las tarjetas del catálogo
    function renderCatalogGrid(items: any[]) {
      const grid = document.getElementById("product-grid");
      const emptyState = document.getElementById("catalog-empty");
      if (!grid) return;

      if (items.length === 0) {
        grid.innerHTML = "";
        emptyState?.classList.remove("hidden");
        emptyState?.classList.add("flex");
        return;
      }

      emptyState?.classList.add("hidden");
      emptyState?.classList.remove("flex");

      grid.innerHTML = items.map((item) => {
        const isServicio = item.tipo_item === "SERVICIO";
        const stockNum = Number(item.stock) || 0;

        // Semáforo de stock solicitado:
        // 0 a 4: Rojo (Urgente / Agotado)
        // 5 a 6: Amarillo (Próximo)
        // 7 en adelante: Verde (Estado OK)
        let stockBadge = "";
        if (isServicio) {
          stockBadge = `<span class="text-[10px] font-bold bg-secondary-fixed text-on-secondary-fixed px-2 py-0.5 rounded-md">Servicio Técnico</span>`;
        } else if (stockNum === 0) {
          stockBadge = `<span class="text-[10px] font-bold bg-error-container text-error px-2 py-0.5 rounded-md">Agotado (0)</span>`;
        } else if (stockNum <= 4) {
          stockBadge = `<span class="text-[10px] font-bold bg-error-container/30 text-error px-2 py-0.5 rounded-md">Urgente (${stockNum} unid.)</span>`;
        } else if (stockNum <= 6) {
          stockBadge = `<span class="text-[10px] font-bold bg-yellow-100 text-yellow-800 px-2 py-0.5 rounded-md">Próximo (${stockNum} unid.)</span>`;
        } else {
          stockBadge = `<span class="text-[10px] font-bold bg-tertiary-container/30 text-on-tertiary-container px-2 py-0.5 rounded-md">Stock: ${stockNum}</span>`;
        }

        const iconName = item.categoria_icono || (isServicio ? "handyman" : "inventory_2");

        return `
          <div
            class="product-item bg-surface-container-lowest rounded-xl p-3 border border-surface-container/60 shadow-xs flex flex-col justify-between group hover:shadow-md hover:border-secondary transition-all"
            data-category="${item.categoria}"
            data-name="${item.nombre.toLowerCase()}"
            data-sku="${(item.sku || "").toLowerCase()}"
            data-barcode="${(item.codigo_barras || "").toLowerCase()}"
          >
            <div>
              <!-- Visual Header con icono y categoría (sin imágenes) -->
              <div class="relative w-full h-24 rounded-lg bg-surface-container-low flex flex-col items-center justify-center mb-2.5 overflow-hidden">
                <span class="material-symbols-outlined text-[38px] text-on-surface-variant/80 group-hover:scale-110 group-hover:text-primary transition-transform duration-300">
                  ${iconName}
                </span>
                <span class="absolute top-1.5 left-1.5 text-[10px] font-semibold bg-surface-container-lowest/90 px-1.5 py-0.5 rounded text-on-surface">
                  ${item.categoria}
                </span>
                <span class="absolute bottom-1.5 right-1.5">
                  ${stockBadge}
                </span>
              </div>
              
              <!-- Info del Producto -->
              <div class="flex flex-col gap-0.5 mb-2">
                <h4 class="text-[13px] font-semibold text-on-surface line-clamp-1" title="${item.nombre}">${item.nombre}</h4>
                <div class="flex items-center gap-1.5 text-[11px] text-on-surface-variant font-mono">
                  <span>SKU: ${item.sku || "N/A"}</span>
                  ${item.codigo_barras ? `<span class="text-[10px] text-on-surface-variant/70">&bull; ${item.codigo_barras}</span>` : ""}
                </div>
              </div>
            </div>

            <!-- Footer con Precio COP y Botón Agregar -->
            <div class="flex items-center justify-between pt-2 border-t border-surface-container/40">
              <span class="text-[15px] text-primary font-bold tracking-tight">${formatCOP(item.precio_venta)}</span>
              <button
                class="h-8 px-3 rounded-lg bg-secondary-container hover:bg-secondary text-on-secondary text-[12px] font-semibold flex items-center gap-1 shadow-2xs active:scale-95 transition-all cursor-pointer ${!isServicio && stockNum === 0 ? "opacity-50 pointer-events-none" : ""}"
                onclick="window.addProductFromCatalog('${item.id}')"
                type="button"
              >
                <span class="material-symbols-outlined text-[16px]">add</span>
                <span>Agregar</span>
              </button>
            </div>
          </div>
        `;
      }).join("");
    }

    // 4. Agregar ítem desde el catálogo al ticket
    (window as any).addProductFromCatalog = function(itemId: string) {
      const item = catalogItems.find((i) => i.id === itemId);
      if (!item) return;

      const isServ = item.tipo_item === "SERVICIO";
      addProductToTicket(
        item.nombre,
        item.precio_venta,
        item.sku,
        isServ ? "Servicio" : "Producto",
        item.id,
        item.stock,
        item.tipo
      );

      // Ocultar mensaje de carrito vacío si hay ítems
      const emptyCartEl = document.getElementById("cartEmptyState");
      if (emptyCartEl) emptyCartEl.classList.add("hidden");
    };

    // 5. Filtrar productos en vivo por búsqueda y categoría
    function filterProductsLive() {
      const input = document.getElementById("productSearch") as HTMLInputElement | null;
      const q = input?.value.toLowerCase().trim() || "";

      const filtered = catalogItems.filter((item) => {
        const matchesCategory = currentFilterCat === "all" || item.categoria === currentFilterCat;
        const matchesQuery = !q ||
          item.nombre.toLowerCase().includes(q) ||
          (item.sku && item.sku.toLowerCase().includes(q)) ||
          (item.codigo_barras && item.codigo_barras.toLowerCase().includes(q));

        return matchesCategory && matchesQuery;
      });

      renderCatalogGrid(filtered);
    }

    window.filterProducts = filterProductsLive;

    window.clearSearch = function() {
      const input = document.getElementById("productSearch") as HTMLInputElement | null;
      if (input) input.value = "";
      filterProductsLive();
    };

    // 6. Simular o escanear código de barras
    window.simulateBarcodeScan = function() {
      const input = document.getElementById("productSearch") as HTMLInputElement | null;
      const q = input?.value.trim();

      if (!q) {
        showPosToast("Escribe un código o SKU en el buscador para escanear", "info");
        return;
      }

      const match = catalogItems.find(
        (i) => (i.codigo_barras && i.codigo_barras.toLowerCase() === q.toLowerCase()) ||
               (i.sku && i.sku.toLowerCase() === q.toLowerCase())
      );

      if (match) {
        (window as any).addProductFromCatalog(match.id);
        showPosToast(`Código detectado: ${match.nombre}`);
        if (input) input.value = "";
        filterProductsLive();
      } else {
        showPosToast(`No se encontró producto con código: ${q}`, "warning");
      }
    };

    // 7. HISTORIAL DE VENTAS (4 PERIODOS SOLICITADOS)
    async function loadSalesHistory(periodo = "hoy") {
      const tbody = document.getElementById("history-table-body");
      const periodSelect = document.getElementById("history-period-select") as HTMLSelectElement | null;
      const sellerSelect = document.getElementById("history-seller-select") as HTMLSelectElement | null;
      const statusSelect = document.getElementById("history-status-select") as HTMLSelectElement | null;
      const searchInput = document.getElementById("history-search") as HTMLInputElement | null;

      const currentPeriod = periodo || periodSelect?.value || "hoy";
      const currentSeller = sellerSelect?.value || "all";
      const currentStatus = statusSelect?.value || "all";
      const currentQuery = searchInput?.value.trim() || "";

      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="9" class="py-8 text-center text-on-surface-variant">
              <span class="material-symbols-outlined text-[24px] animate-spin text-secondary align-middle">sync</span>
              <span class="align-middle ml-2 text-[13px]">Consultando ventas...</span>
            </td>
          </tr>
        `;
      }

      try {
        const queryParams = new URLSearchParams({
          periodo: currentPeriod,
          vendedor: currentSeller,
          estado: currentStatus,
          busqueda: currentQuery
        });

        const res = await fetch(`${API_BASE}/historial?${queryParams.toString()}`);
        const json = await res.json();

        if (json.success) {
          const ventas = json.ventas || [];
          const kpis = json.kpis || {};

          // Actualizar títulos y KPIs
          const periodTitleEl = document.getElementById("hist-period-title");
          const titles: Record<string, string> = {
            hoy: "Ventas de Hoy",
            ayer: "Ventas del Día Anterior",
            semana: "Ventas de la Semana Anterior",
            mes: "Ventas del Mes en Curso"
          };
          if (periodTitleEl) periodTitleEl.textContent = titles[currentPeriod] || "Ventas del Periodo";

          const totalEl = document.getElementById("hist-total-ventas");
          if (totalEl) totalEl.textContent = formatCOP(kpis.total_ventas || 0);

          const countEl = document.getElementById("hist-count-ventas");
          if (countEl) countEl.textContent = `${kpis.cantidad_transacciones || 0} transacciones completadas`;

          const avgEl = document.getElementById("hist-avg-ticket");
          if (avgEl) avgEl.textContent = formatCOP(kpis.ticket_promedio || 0);

          const totalUnits = ventas.reduce((acc: number, v: any) => acc + (Number(v.total_unidades) || 0), 0);
          const unitsEl = document.getElementById("hist-total-items");
          if (unitsEl) unitsEl.textContent = String(totalUnits);

          const infoEl = document.getElementById("history-pagination-info");
          if (infoEl) infoEl.textContent = `Mostrando ${ventas.length} transacciones registradas (${titles[currentPeriod] || "Periodo"})`;

          // Poblar desplegable de vendedores si aún está solo con "Todos"
          if (sellerSelect && sellerSelect.options.length <= 1) {
            const uniqueVendors = Array.from(new Set(ventas.map((v: any) => v.vendedor_nombre))).filter(Boolean);
            uniqueVendors.forEach((vendorName: any) => {
              const opt = document.createElement("option");
              opt.value = vendorName;
              opt.textContent = vendorName;
              sellerSelect.appendChild(opt);
            });
          }

          // Renderizar filas de la tabla
          if (!tbody) return;
          if (ventas.length === 0) {
            tbody.innerHTML = `
              <tr>
                <td colspan="9" class="py-12 text-center text-on-surface-variant">
                  <div class="flex flex-col items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[36px] text-on-surface-variant/40">receipt_long</span>
                    <p class="text-[13px] font-medium">No se registraron ventas en este periodo seleccionado (${titles[currentPeriod] || currentPeriod}).</p>
                  </div>
                </td>
              </tr>
            `;
            return;
          }

          tbody.innerHTML = ventas.map((v: any) => {
            const isAnulada = v.estado === "ANULADA";
            const dateStr = new Date(v.fecha_hora).toLocaleDateString("es-CO", {
              timeZone: "America/Bogota",
              day: "2-digit",
              month: "short",
              hour: "2-digit",
              minute: "2-digit"
            });

            let metodoIcon = "payments";
            let metodoNombre = "Efectivo";
            if (v.metodo_pago === "TARJETA") {
              metodoIcon = "credit_card";
              metodoNombre = "Tarjeta";
            } else if (v.metodo_pago === "TRANSFERENCIA") {
              metodoIcon = "account_balance";
              metodoNombre = "Transf. Bancaria";
            }

            return `
              <tr class="hover:bg-surface-container-low transition-colors group h-12 ${isAnulada ? "opacity-60 bg-error-container/5" : ""}">
                <td class="py-2 px-4">
                  <div class="flex flex-col">
                    <span class="font-semibold ${isAnulada ? "line-through text-on-surface-variant" : "text-primary"}">#${v.folio_ticket}</span>
                    <span class="text-[10px] text-on-surface-variant">${v.sucursal_nombre || "Principal"}</span>
                  </div>
                </td>
                <td class="py-2 px-4 whitespace-nowrap text-on-surface-variant text-[12px]">${dateStr}</td>
                <td class="py-2 px-4">
                  <span class="font-medium text-on-surface">Consumidor Final</span>
                </td>
                <td class="py-2 px-4 whitespace-nowrap font-medium">${v.vendedor_nombre}</td>
                <td class="py-2 px-4 whitespace-nowrap">
                  <span class="inline-flex items-center gap-1 text-[11px] text-on-surface bg-surface-container px-2 py-0.5 rounded-lg">
                    <span class="material-symbols-outlined text-[13px]">${metodoIcon}</span> ${metodoNombre}
                  </span>
                </td>
                <td class="py-2 px-4 text-right font-medium">${v.total_unidades} unid.</td>
                <td class="py-2 px-4 text-right font-bold ${isAnulada ? "line-through text-on-surface-variant" : "text-on-surface"}">${formatCOP(v.total)}</td>
                <td class="py-2 px-4">
                  ${isAnulada ? `
                    <span class="inline-flex items-center gap-1 text-[11px] text-error bg-error-container/30 px-2 py-0.5 rounded-full font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-error"></span> Anulada
                    </span>
                  ` : `
                    <span class="inline-flex items-center gap-1 text-[11px] text-on-tertiary-container bg-tertiary-container/20 px-2 py-0.5 rounded-full font-semibold">
                      <span class="w-1.5 h-1.5 rounded-full bg-on-tertiary-container"></span> Completada
                    </span>
                  `}
                </td>
                <td class="py-2 px-4 text-right">
                  <div class="flex items-center justify-end gap-1 opacity-80 group-hover:opacity-100">
                    <button class="p-1 hover:bg-surface-container rounded-lg text-on-surface-variant hover:text-on-surface cursor-pointer" onclick="window.showPosToast('Ticket #${v.folio_ticket} impreso con éxito.', 'info')" title="Imprimir Comprobante" type="button">
                      <span class="material-symbols-outlined text-[18px]">receipt</span>
                    </button>
                    ${!isAnulada ? `
                      <button class="p-1 hover:bg-error-container/40 rounded-lg text-on-surface-variant hover:text-error cursor-pointer" onclick="window.anularVenta('${v.id}', '${v.folio_ticket}')" title="Anular Factura" type="button">
                        <span class="material-symbols-outlined text-[18px]">delete</span>
                      </button>
                    ` : ""}
                  </div>
                </td>
              </tr>
            `;
          }).join("");
        }
      } catch (err) {
        console.error("Error al consultar historial:", err);
      }
    }

    (window as any).refreshHistory = function() {
      const periodSelect = document.getElementById("history-period-select") as HTMLSelectElement | null;
      loadSalesHistory(periodSelect?.value || "hoy");
    };

    // 8. Anular venta y restituir inventario
    (window as any).anularVenta = async function(ventaId: string, folio: string) {
      if (!confirm(`¿Estás seguro de anular la venta #${folio}?\nEl inventario de los productos será devuelto a la base de datos automáticamente.`)) {
        return;
      }

      try {
        const res = await fetch(`${API_BASE}/${ventaId}/anular`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ motivo: "Anulación solicitada por usuario" })
        });
        const json = await res.json();
        if (json.success) {
          showPosToast(`Venta #${folio} anulada y stock devuelto exitosamente.`);
          (window as any).refreshHistory();
          loadPosCatalog(); // Recargar stock en el POS
        } else {
          alert(json.error || "No se pudo anular la venta.");
        }
      } catch (err) {
        console.error("Error al anular venta:", err);
        alert("Error de conexión al anular venta.");
      }
    };

    // 9. PROCESAR CHECKOUT (FACTURAR Y GUARDAR EN LA BD)
    window.processCheckout = async function() {
      const rows = document.querySelectorAll(".cart-row");
      if (rows.length === 0) {
        showPosToast("El ticket está vacío. Agrega productos o servicios antes de procesar.", "warning");
        return;
      }

      const items: any[] = [];
      let calculatedTotal = 0;

      rows.forEach((row) => {
        const id = row.getAttribute("data-id") || null;
        const sku = row.getAttribute("data-sku") || "";
        const tipo = row.getAttribute("data-tipo") || "FISICO";
        const nombre = row.getAttribute("data-name") || row.querySelector(".cart-item-title")?.textContent?.trim() || "";
        const precioUnit = parseFloat(row.getAttribute("data-price") || "0");
        const qtyEl = row.querySelector(".item-qty") as HTMLInputElement | null;
        const cantidad = parseInt(qtyEl?.value || qtyEl?.textContent || "1", 10) || 1;
        const subtotalItem = precioUnit * cantidad;

        calculatedTotal += subtotalItem;
        items.push({
          id,
          sku,
          nombre,
          tipo,
          cantidad,
          precio_unitario: precioUnit,
          subtotal: subtotalItem
        });
      });

      const activeCashier = loadCashierSession();
      const metodoPago = getActivePaymentMethod();
      const customerName = document.getElementById("currentCustomerName")?.textContent?.trim() || "Consumidor Final";

      const btnCheckout = document.getElementById("btnCheckoutAction");
      const btnCheckoutLabel = document.getElementById("btnCheckoutLabel");

      try {
        if (btnCheckout) btnCheckout.setAttribute("disabled", "true");
        if (btnCheckoutLabel) btnCheckoutLabel.textContent = "Procesando venta...";

        const res = await fetch(API_BASE, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            vendedor_nombre: activeCashier,
            metodo_pago: metodoPago,
            items: items,
            subtotal: calculatedTotal,
            impuestos: 0,
            descuento: 0,
            total: calculatedTotal,
            cliente_nombre: customerName
          })
        });

        const json = await res.json();
        if (json.success) {
          showPosToast(`Venta #${json.data.folio_ticket} procesada y registrada con éxito!`, "success");
          clearActiveCart();

          const emptyCartEl = document.getElementById("cartEmptyState");
          if (emptyCartEl) emptyCartEl.classList.remove("hidden");

          // Recargar catálogo (actualiza existencias) e historial
          loadPosCatalog();
          loadSalesHistory("hoy");
        } else {
          alert(json.error || "No se pudo registrar la venta.");
        }
      } catch (err) {
        console.error("Error al procesar venta:", err);
        alert("Error de conexión al guardar la venta.");
      } finally {
        if (btnCheckout) btnCheckout.removeAttribute("disabled");
        if (btnCheckoutLabel) btnCheckoutLabel.textContent = `Cobrar y Facturar ($ 0)`;
      }
    };

    window.holdTicket = function() {
      showPosToast("Venta guardada en espera temporalmente.", "info");
      clearActiveCart();
      const emptyCartEl = document.getElementById("cartEmptyState");
      if (emptyCartEl) emptyCartEl.classList.remove("hidden");
    };

    window.resumeHeldTicket = function() {
      switchPosView("pos");
      showPosToast("Ticket reanudado en terminal.");
    };

    // 10. Hidratar nombre de vendedor según la sesión activa
    function loadCashierSession(): string {
      try {
        const raw = localStorage.getItem("stock_auth_user") || sessionStorage.getItem("stock_auth_user");
        let name = "";
        if (raw) {
          const user = JSON.parse(raw);
          const first = (user.name || user.nombre || (user.identifier ? user.identifier.split("@")[0] : "")).trim();
          const last = (user.lastname || user.apellido || "").trim();
          name = `${first} ${last}`.trim() || first;
        }
        if (!name) {
          const navName = document.querySelector("#user-display-name, [data-user-name]")?.textContent?.trim();
          if (navName && !navName.includes("Cargando")) name = navName;
        }
        if (!name) {
          name = "Carlos";
        }

        const cashierEl = document.getElementById("pos-cashier-name");
        if (cashierEl) cashierEl.textContent = name;
        const ticketCashier = document.getElementById("ticket-cashier-name");
        if (ticketCashier) ticketCashier.textContent = name;
        const histCashier = document.getElementById("hist-active-cashier-label");
        if (histCashier) histCashier.textContent = `Vendedor: ${name}`;
        return name;
      } catch (e) {
        return "Carlos";
      }
    }

    // 11. Inicializar eventos y vistas
    function setupSales() {
      loadCashierSession();
      initVentas();
      loadPosCatalog();
      loadSalesHistory("hoy");

      // Buscador en catálogo
      const searchInput = document.getElementById("productSearch");
      if (searchInput) {
        searchInput.addEventListener("input", filterProductsLive);
      }

      // Filtro de periodos en historial
      const periodSelect = document.getElementById("history-period-select");
      if (periodSelect) {
        periodSelect.addEventListener("change", (e: any) => {
          loadSalesHistory(e.target.value);
        });
      }

      // Filtros de vendedor y estado en historial
      const sellerSelect = document.getElementById("history-seller-select");
      if (sellerSelect) {
        sellerSelect.addEventListener("change", () => (window as any).refreshHistory());
      }
      const statusSelect = document.getElementById("history-status-select");
      if (statusSelect) {
        statusSelect.addEventListener("change", () => (window as any).refreshHistory());
      }
      const historySearch = document.getElementById("history-search");
      if (historySearch) {
        historySearch.addEventListener("input", () => (window as any).refreshHistory());
      }
    }

    document.addEventListener("astro:page-load", setupSales);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupSales);
    } else {
      setupSales();
    }
  </script>
</Layout>
