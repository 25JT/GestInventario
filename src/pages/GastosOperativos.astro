  >
    <span id="expenseToastIcon" class="material-symbols-outlined text-secondary-fixed text-[20px]">check_circle</span>
    <span id="expenseToastMsg" class="text-[13px] font-medium">Operación completada con éxito</span>
  </div>

  <script>
    import {
      initGastos,
      openExpenseModal,
      closeExpenseModal,
      showExpenseToast,
    } from "../animaciones/animaGastos.js";

    window.openExpenseModal = openExpenseModal;
    window.closeExpenseModal = closeExpenseModal;
    window.showExpenseToast = showExpenseToast;

    window.saveNewExpense = function() {
      const concept = (document.getElementById("newExpenseConcept") as HTMLInputElement | null)?.value.trim();
      const amount = (document.getElementById("newExpenseAmount") as HTMLInputElement | null)?.value.trim();

      if (!concept || !amount) {
        showExpenseToast("Por favor complete el concepto y el monto.", "warning");
        return;
      }

      closeExpenseModal();
      showExpenseToast(`Gasto por $${amount} asentado en libros correctamente.`);
    };

    function setupGastos() {
      initGastos();
    }

    document.addEventListener("astro:page-load", setupGastos);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupGastos);
    } else {
      setupGastos();
    }
  </script>
