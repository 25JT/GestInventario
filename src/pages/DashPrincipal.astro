---
// DashPrincipal.astro - Panel de Control Ejecutivo Principal
import Layout from "../layouts/Layout.astro";
import SlideBar from "../components/SlideBar.astro";
import NavBar from "../components/Nav.astro";
---

<Layout title="Panel de Control Ejecutivo - Control de Stock Enterprise JR">
  <div class="min-h-screen bg-surface flex flex-col font-body-md text-on-surface">
    {/* Barra Lateral y Barra Superior Responsivas Globales */}
    <SlideBar currentPath="principal" />
    <NavBar />

    {/* Contenedor Principal (con espacio superior para el Navbar fijo) */}
    <div
      id="app-content"
      class="pt-16 min-h-screen flex flex-col flex-1"
    >
      <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto space-y-6">
        <!-- Sub-header / Command Bar -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md mb-space-lg">
          <div class="flex flex-col">
            <div class="flex items-center gap-2">
              <span class="font-label-sm text-label-sm text-secondary-container tracking-wider uppercase font-semibold">
                Panel de Control Ejecutivo
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-outline-variant"></span>
            </div>
            <h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight mt-0.5 font-bold">
              Bienvenido, <span id="welcome-name">Carlos Mendoza</span>
            </h1>
            <p class="font-body-sm text-body-sm text-on-surface-variant">
              Visión general del rendimiento operativo, flujo de caja e inventario central.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-space-sm">
            <div class="inline-flex p-1 bg-surface-container-low rounded-xl shadow-xs" id="time-filter-group">
              <button
                class="time-tab px-3 py-1 font-label-md text-label-md rounded-lg text-on-surface-variant hover:text-on-surface transition-all cursor-pointer"
                onclick="window.setTimeFilter && window.setTimeFilter(this, 'hoy')"
                type="button"
              >
                Hoy
              </button>
              <button
                class="time-tab px-3 py-1 font-label-md text-label-md rounded-lg text-on-surface-variant hover:text-on-surface transition-all cursor-pointer"
                onclick="window.setTimeFilter && window.setTimeFilter(this, 'semana')"
                type="button"
              >
                Esta semana
              </button>
              <button
                class="time-tab active px-3 py-1 font-label-md text-label-md rounded-lg bg-surface-container-lowest text-primary shadow-xs font-semibold transition-all cursor-pointer"
                onclick="window.setTimeFilter && window.setTimeFilter(this, 'mes')"
                type="button"
              >
                Este mes
              </button>
            </div>
            <div class="flex items-center gap-2">
              <button
                id="btn-export"
                class="h-[34px] px-3.5 bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md rounded-xl shadow-xs flex items-center gap-2 transition-colors cursor-pointer"
                type="button"
              >
                <span class="material-symbols-outlined text-[18px]">download</span>
                <span>Exportar Informe</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Row 1: KPI Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md mb-space-lg">
          <!-- KPI 1 -->
          <div class="bg-surface-container-lowest p-4 rounded-xl shadow-xs border border-surface-container/60 flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between">
              <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold">
                  Ventas Totales (Mes)
                </span>
                <span id="kpi-ventas-val" class="font-headline-lg text-headline-lg text-on-surface tracking-tight mt-1 font-bold">
                  $48,250.00
                </span>
              </div>
              <div class="w-9 h-9 rounded-xl bg-surface-container-low flex items-center justify-center text-on-tertiary-container shrink-0">
                <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">trending_up</span>
              </div>
            </div>
            <div class="flex items-center justify-between mt-3 pt-2 bg-surface-container-low/50 -mx-4 -mb-4 px-4 py-2 rounded-b-xl border-t border-surface-container/40">
              <div class="flex items-center gap-1 text-on-tertiary-container font-label-sm text-label-sm font-semibold">
                <span class="material-symbols-outlined text-[16px]">arrow_upward</span>
                <span>+12.4%</span>
                <span class="text-on-surface-variant font-normal">vs mes ant.</span>
              </div>
              <span class="font-label-sm text-label-sm text-on-surface-variant">Obj: 94%</span>
            </div>
          </div>

          <!-- KPI 2 -->
          <div class="bg-surface-container-lowest p-4 rounded-xl shadow-xs border border-surface-container/60 flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between">
              <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold">
                  Gastos Operativos
                </span>
                <span id="kpi-gastos-val" class="font-headline-lg text-headline-lg text-on-surface tracking-tight mt-1 font-bold">
                  $14,820.00
                </span>
              </div>
              <div class="w-9 h-9 rounded-xl bg-surface-container-low flex items-center justify-center text-secondary-container shrink-0">
                <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">account_balance_wallet</span>
              </div>
            </div>
            <div class="flex items-center justify-between mt-3 pt-2 bg-surface-container-low/50 -mx-4 -mb-4 px-4 py-2 rounded-b-xl border-t border-surface-container/40">
              <div class="flex items-center gap-1 text-on-tertiary-container font-label-sm text-label-sm font-semibold">
                <span class="material-symbols-outlined text-[16px]">arrow_downward</span>
                <span>-3.1%</span>
                <span class="text-on-surface-variant font-normal">reducción</span>
              </div>
              <span class="font-label-sm text-label-sm text-on-surface-variant">Presupuesto OK</span>
            </div>
          </div>

          <!-- KPI 3 -->
          <div class="bg-surface-container-lowest p-4 rounded-xl shadow-xs border border-surface-container/60 flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between">
              <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold">
                  DINERO TOTAL
                </span>
                <span id="kpi-utilidad-val" class="font-headline-lg text-headline-lg text-on-surface tracking-tight mt-1 font-bold">
                  $33,430.00
                </span>
              </div>
              <div class="w-9 h-9 rounded-xl bg-tertiary-container text-on-tertiary-container flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">pie_chart</span>
              </div>
            </div>
            <div class="flex items-center justify-between mt-3 pt-2 bg-surface-container-low/50 -mx-4 -mb-4 px-4 py-2 rounded-b-xl border-t border-surface-container/40">
              <div class="flex items-center gap-1.5 font-label-sm text-label-sm">
                <span class="px-1.5 py-0.5 rounded bg-tertiary-fixed text-on-tertiary-fixed font-semibold text-[11px]">
                  Margen 69.3%
                </span>
              </div>
              <span class="font-label-sm text-label-sm text-on-surface-variant font-semibold text-on-tertiary-container">
                +$5,120
              </span>
            </div>
          </div>

          <!-- KPI 4 -->
          <div class="bg-surface-container-lowest p-4 rounded-xl shadow-xs border border-surface-container/60 flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between">
              <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold">
                  Estado de Inventario
                </span>
                <div class="flex items-baseline gap-2 mt-1">
                  <span class="font-headline-lg text-headline-lg text-on-surface tracking-tight font-bold">1,248</span>
                  <span class="font-label-sm text-label-sm text-on-surface-variant font-medium">items activos</span>
                </div>
              </div>
              <div class="w-9 h-9 rounded-xl bg-surface-container-low text-on-surface flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">inventory</span>
              </div>
            </div>
            <div class="flex items-center gap-2 mt-3 pt-2 bg-surface-container-low/50 -mx-4 -mb-4 px-4 py-2 rounded-b-xl border-t border-surface-container/40">
              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-lg bg-surface-container-high text-on-surface text-[11px] font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
                14 stock bajo
              </span>
              <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-lg bg-error-container text-on-error-container text-[11px] font-semibold">
                3 agotados
              </span>
            </div>
          </div>
        </div>

        <!-- Row 2: Analytics Split (65% / 35%) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-md mb-space-lg">
          <!-- Left Column: Chart & Sales Metrics (65% ~ 8 cols) -->
          <div class="lg:col-span-8 flex flex-col gap-space-md">
            <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-xs border border-surface-container/60">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 gap-2">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-headline-md text-headline-md text-on-surface font-bold">
                      Flujo Financiero &amp; Rendimiento
                    </span>
                    <span class="px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm font-semibold">
                      Oct 2024
                    </span>
                  </div>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">
                    Monitoreo dinámico de ingresos, egresos de almacén y margen neto
                  </p>
                </div>
                <div class="inline-flex p-0.5 bg-surface-container-low rounded-xl self-start sm:self-auto shadow-2xs">
                  <button
                    class="chart-tab px-3 py-1 font-label-md text-label-md rounded-lg bg-surface-container-lowest text-primary shadow-xs font-semibold transition-all cursor-pointer"
                    id="tab-ventas"
                    onclick="window.switchChartTab && window.switchChartTab('ventas')"
                    type="button"
                  >
                    Ventas
                  </button>
                  <button
                    class="chart-tab px-3 py-1 font-label-md text-label-md rounded-lg text-on-surface-variant hover:text-on-surface transition-all cursor-pointer"
                    id="tab-gastos"
                    onclick="window.switchChartTab && window.switchChartTab('gastos')"
                    type="button"
                  >
                    Gastos
                  </button>
                  <button
                    class="chart-tab px-3 py-1 font-label-md text-label-md rounded-lg text-on-surface-variant hover:text-on-surface transition-all cursor-pointer"
                    id="tab-utilidad"
                    onclick="window.switchChartTab && window.switchChartTab('utilidad')"
                    type="button"
                  >
                    Utilidad
                  </button>
                </div>
              </div>

              <!-- SVG Financial Trend Visualizer -->
              <div class="w-full relative pt-2">
                <div class="flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm mb-1 px-1">
                  <span id="chart-max-label" class="font-semibold">$50k</span>
                  <div class="flex items-center gap-4">
                    <div class="flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-secondary-container"></span>
                      <span>Ventas registradas</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-full bg-outline-variant"></span>
                      <span>Gastos operativos</span>
                    </div>
                  </div>
                </div>

                <div class="h-44 w-full relative">
                  <svg id="financial-svg-chart" class="w-full h-full overflow-visible" preserveAspectRatio="none" viewBox="0 0 600 160">
                    <defs>
                      <linearGradient id="salesGrad" x1="0%" x2="0%" y1="0%" y2="100%">
                        <stop offset="0%" stop-color="#316bf3" stop-opacity="0.28"></stop>
                        <stop offset="100%" stop-color="#316bf3" stop-opacity="0.0"></stop>
                      </linearGradient>
                      <linearGradient id="expenseGrad" x1="0%" x2="0%" y1="0%" y2="100%">
                        <stop offset="0%" stop-color="#75777d" stop-opacity="0.15"></stop>
                        <stop offset="100%" stop-color="#75777d" stop-opacity="0.0"></stop>
                      </linearGradient>
                    </defs>
                    <!-- Subtle Gridlines -->
                    <line stroke="#eff4ff" stroke-width="1.5" x1="0" x2="600" y1="30" y2="30"></line>
                    <line stroke="#eff4ff" stroke-width="1.5" x1="0" x2="600" y1="80" y2="80"></line>
                    <line stroke="#eff4ff" stroke-width="1.5" x1="0" x2="600" y1="130" y2="130"></line>

                    <!-- Expenses Area -->
                    <path
                      id="chart-expense-area"
                      d="M 0,110 Q 75,95 150,115 T 300,105 T 450,120 T 600,95 L 600,160 L 0,160 Z"
                      fill="url(#expenseGrad)"
                      class="transition-all duration-500"
                    ></path>
                    <path
                      id="chart-expense-line"
                      d="M 0,110 Q 75,95 150,115 T 300,105 T 450,120 T 600,95"
                      fill="none"
                      stroke="#75777d"
                      stroke-dasharray="3,3"
                      stroke-width="2"
                      class="transition-all duration-500"
                    ></path>

                    <!-- Sales Area -->
                    <path
                      id="chart-sales-area"
                      d="M 0,130 Q 80,70 160,80 T 320,40 T 460,55 T 600,20 L 600,160 L 0,160 Z"
                      fill="url(#salesGrad)"
                      class="transition-all duration-500"
                    ></path>
                    <path
                      id="chart-sales-line"
                      d="M 0,130 Q 80,70 160,80 T 320,40 T 460,55 T 600,20"
                      fill="none"
                      stroke="#316bf3"
                      stroke-width="2.5"
                      class="transition-all duration-500"
                    ></path>

                    <!-- Interactive Peak Indicators -->
                    <circle id="peak-dot-1" cx="460" cy="55" fill="#316bf3" r="4.5" stroke="#ffffff" stroke-width="2"></circle>
                    <circle id="peak-dot-2" cx="600" cy="20" fill="#00a472" r="5" stroke="#ffffff" stroke-width="2.5"></circle>
                  </svg>
                </div>

                <div class="flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm pt-2 px-1">
                  <span>01 Oct</span>
                  <span>07 Oct</span>
                  <span>14 Oct</span>
                  <span>21 Oct</span>
                  <span class="font-semibold text-primary">Hoy (24 Oct)</span>
                </div>
              </div>

              <!-- Category breakdown micro-cards inside graph panel -->
              <div class="mt-4 pt-3 bg-surface-container-low rounded-xl p-3 grid grid-cols-1 sm:grid-cols-3 gap-3 border border-surface-container/50">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-surface-container-lowest flex items-center justify-center text-secondary-container shadow-xs">
                    <span class="material-symbols-outlined text-[18px]">devices</span>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-label-sm text-label-sm text-on-surface-variant truncate">Productos</span>
                    <div class="flex items-baseline gap-1.5">
                      <span class="font-numeric-data text-numeric-data font-bold text-on-surface">$24,190</span>
                      <span class="font-label-sm text-label-sm text-on-tertiary-container font-semibold">+18%</span>
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-surface-container-lowest flex items-center justify-center text-primary shadow-xs">
                    <span class="material-symbols-outlined text-[18px]">build</span>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-label-sm text-label-sm text-on-surface-variant truncate">Servicios</span>
                    <div class="flex items-baseline gap-1.5">
                      <span class="font-numeric-data text-numeric-data font-bold text-on-surface">$16,310</span>
                      <span class="font-label-sm text-label-sm text-on-tertiary-container font-semibold">+7%</span>
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-surface-container-lowest flex items-center justify-center text-outline shadow-xs">
                    <span class="material-symbols-outlined text-[18px]">category</span>
                  </div>
                  <div class="flex flex-col min-w-0">
                    <span class="font-label-sm text-label-sm text-on-surface-variant truncate">Consumibles</span>
                    <div class="flex items-baseline gap-1.5">
                      <span class="font-numeric-data text-numeric-data font-bold text-on-surface">$7,750</span>
                      <span class="font-label-sm text-label-sm text-error font-semibold">-2%</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Critical Stock Alerts (35% ~ 4 cols) -->
          <div class="lg:col-span-4 flex flex-col">
            <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-xs border border-surface-container/60 flex flex-col justify-between h-full">
              <div>
                <div class="flex items-center justify-between pb-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-error animate-pulse"></span>
                    <h2 class="font-headline-md text-headline-md text-on-surface font-bold">Stock Crítico</h2>
                  </div>
                  <span class="px-2 py-0.5 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm font-semibold">
                    14 Urgentes
                  </span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant mb-3">
                  Reorden inmediata requerida para sucursal central.
                </p>

                <!-- List of critical items -->
                <div class="flex flex-col gap-2">
                  <!-- Item 1 -->
                  <div class="p-2.5 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors flex items-center justify-between border border-surface-container/40">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <div class="w-8 h-8 rounded-lg bg-error-container text-on-error-container flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[18px]">memory</span>
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class="font-label-md text-label-md font-semibold text-on-surface truncate">SSD NVMe 1TB Kingston</span>
                        <div class="flex items-center gap-1.5 font-label-sm text-label-sm text-on-surface-variant">
                          <span class="font-mono text-[10px] bg-surface-container px-1 rounded font-bold">SKU-9904</span>
                          <span class="text-error font-semibold">2 en stock</span>
                          <span>(Mín: 15)</span>
                        </div>
                      </div>
                    </div>
                    <button
                      class="h-7 px-2.5 bg-primary hover:bg-primary-container text-on-primary font-label-sm text-label-sm font-medium rounded-lg shadow-xs shrink-0 transition-all flex items-center gap-1 cursor-pointer"
                      onclick="window.quickRestock && window.quickRestock('SKU-9904', 'SSD NVMe 1TB Kingston')"
                      type="button"
                    >
                      <span class="material-symbols-outlined text-[14px]">local_shipping</span>
                      <span>Pedir</span>
                    </button>
                  </div>

                  <!-- Item 2 -->
                  <div class="p-2.5 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors flex items-center justify-between border border-surface-container/40">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <div class="w-8 h-8 rounded-lg bg-surface-container-high text-on-surface flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[18px]">cable</span>
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class="font-label-md text-label-md font-semibold text-on-surface truncate">Cable USB-C Blindado 2m</span>
                        <div class="flex items-center gap-1.5 font-label-sm text-label-sm text-on-surface-variant">
                          <span class="font-mono text-[10px] bg-surface-container px-1 rounded font-bold">SKU-3108</span>
                          <span class="text-error font-semibold">0 agotado</span>
                          <span>(Mín: 25)</span>
                        </div>
                      </div>
                    </div>
                    <button
                      class="h-7 px-2.5 bg-primary hover:bg-primary-container text-on-primary font-label-sm text-label-sm font-medium rounded-lg shadow-xs shrink-0 transition-all flex items-center gap-1 cursor-pointer"
                      onclick="window.quickRestock && window.quickRestock('SKU-3108', 'Cable USB-C Blindado')"
                      type="button"
                    >
                      <span class="material-symbols-outlined text-[14px]">local_shipping</span>
                      <span>Pedir</span>
                    </button>
                  </div>

                  <!-- Item 3 -->
                  <div class="p-2.5 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors flex items-center justify-between border border-surface-container/40">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <div class="w-8 h-8 rounded-lg bg-surface-container-high text-on-surface flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[18px]">power</span>
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class="font-label-md text-label-md font-semibold text-on-surface truncate">Fuente Poder 650W Modular</span>
                        <div class="flex items-center gap-1.5 font-label-sm text-label-sm text-on-surface-variant">
                          <span class="font-mono text-[10px] bg-surface-container px-1 rounded font-bold">SKU-7721</span>
                          <span class="text-on-surface font-semibold">4 en stock</span>
                          <span>(Mín: 10)</span>
                        </div>
                      </div>
                    </div>
                    <button
                      class="h-7 px-2.5 bg-surface-container hover:bg-surface-container-highest text-on-surface font-label-sm text-label-sm font-medium rounded-lg shadow-xs shrink-0 transition-all flex items-center gap-1 cursor-pointer"
                      onclick="window.quickRestock && window.quickRestock('SKU-7721', 'Fuente Poder 650W')"
                      type="button"
                    >
                      <span>Pedir</span>
                    </button>
                  </div>

                  <!-- Item 4 -->
                  <div class="p-2.5 rounded-xl bg-surface-container-low hover:bg-surface-container transition-colors flex items-center justify-between border border-surface-container/40">
                    <div class="flex items-center gap-2.5 min-w-0">
                      <div class="w-8 h-8 rounded-lg bg-surface-container-high text-on-surface flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[18px]">heat_pump</span>
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class="font-label-md text-label-md font-semibold text-on-surface truncate">Pasta Térmica Artic MX-4</span>
                        <div class="flex items-center gap-1.5 font-label-sm text-label-sm text-on-surface-variant">
                          <span class="font-mono text-[10px] bg-surface-container px-1 rounded font-bold">SKU-4419</span>
                          <span class="text-error font-semibold">1 en stock</span>
                          <span>(Mín: 12)</span>
                        </div>
                      </div>
                    </div>
                    <button
