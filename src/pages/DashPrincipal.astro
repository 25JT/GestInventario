  <script>
    // Recuperar y actualizar el nombre del colaborador desde la sesión activa
    function loadSessionData() {
      const storedUser =
        localStorage.getItem("stock_auth_user") ||
        sessionStorage.getItem("stock_auth_user");
      if (storedUser) {
        try {
          const user = JSON.parse(storedUser);
          const welcomeName = document.getElementById("welcome-name");
          const name = (user.name || user.nombre || (user.identifier ? user.identifier.split("@")[0] : "Carlos Mendoza")).trim();
          const lastname = (user.lastname || user.apellido || "").trim();
          const fullName = `${name} ${lastname}`.trim();
          if (welcomeName) {
            welcomeName.textContent = fullName || name;
          }
        } catch (e) {
          console.error("Error al cargar sesión de usuario:", e);
        }
      }
    }

    // Filtros de tiempo: Hoy / Esta semana / Este mes
    window.setTimeFilter = function(btn: HTMLElement, filter: string) {
      document.querySelectorAll("#time-filter-group .time-tab").forEach((tab) => {
        tab.classList.remove("active", "bg-surface-container-lowest", "text-primary", "shadow-xs", "font-semibold");
        tab.classList.add("text-on-surface-variant");
      });
      btn.classList.add("active", "bg-surface-container-lowest", "text-primary", "shadow-xs", "font-semibold");
      btn.classList.remove("text-on-surface-variant");

      // Datos demostrativos según filtro temporal
      const kpiVentas = document.getElementById("kpi-ventas-val");
      const kpiGastos = document.getElementById("kpi-gastos-val");
      const kpiUtilidad = document.getElementById("kpi-utilidad-val");

      if (filter === "hoy") {
        if (kpiVentas) kpiVentas.textContent = "$3,420.00";
        if (kpiGastos) kpiGastos.textContent = "$890.00";
        if (kpiUtilidad) kpiUtilidad.textContent = "$2,530.00";
      } else if (filter === "semana") {
        if (kpiVentas) kpiVentas.textContent = "$18,650.00";
        if (kpiGastos) kpiGastos.textContent = "$4,210.00";
        if (kpiUtilidad) kpiUtilidad.textContent = "$14,440.00";
      } else {
        if (kpiVentas) kpiVentas.textContent = "$48,250.00";
        if (kpiGastos) kpiGastos.textContent = "$14,820.00";
        if (kpiUtilidad) kpiUtilidad.textContent = "$33,430.00";
      }
    };

    // Pestañas del gráfico interactivo: Ventas / Gastos / Utilidad
    window.switchChartTab = function(tab: string) {
      document.querySelectorAll(".chart-tab").forEach((btn) => {
        btn.classList.remove("bg-surface-container-lowest", "text-primary", "shadow-xs", "font-semibold");
        btn.classList.add("text-on-surface-variant");
      });
      const activeBtn = document.getElementById(`tab-${tab}`);
      if (activeBtn) {
        activeBtn.classList.add("bg-surface-container-lowest", "text-primary", "shadow-xs", "font-semibold");
        activeBtn.classList.remove("text-on-surface-variant");
      }

      // Variación demostrativa de curvas SVG
      const salesArea = document.getElementById("chart-sales-area");
      const salesLine = document.getElementById("chart-sales-line");
      const maxLabel = document.getElementById("chart-max-label");

      if (tab === "ventas") {
        if (maxLabel) maxLabel.textContent = "$50k";
        if (salesArea) salesArea.setAttribute("d", "M 0,130 Q 80,70 160,80 T 320,40 T 460,55 T 600,20 L 600,160 L 0,160 Z");
        if (salesLine) salesLine.setAttribute("d", "M 0,130 Q 80,70 160,80 T 320,40 T 460,55 T 600,20");
      } else if (tab === "gastos") {
        if (maxLabel) maxLabel.textContent = "$20k";
        if (salesArea) salesArea.setAttribute("d", "M 0,140 Q 80,110 160,120 T 320,90 T 460,105 T 600,75 L 600,160 L 0,160 Z");
        if (salesLine) salesLine.setAttribute("d", "M 0,140 Q 80,110 160,120 T 320,90 T 460,105 T 600,75");
      } else if (tab === "utilidad") {
        if (maxLabel) maxLabel.textContent = "$40k";
        if (salesArea) salesArea.setAttribute("d", "M 0,120 Q 80,50 160,65 T 320,30 T 460,40 T 600,15 L 600,160 L 0,160 Z");
        if (salesLine) salesLine.setAttribute("d", "M 0,120 Q 80,50 160,65 T 320,30 T 460,40 T 600,15");
      }
    };

    // Toast de pedido rápido
    let toastTimeout: any;
    window.quickRestock = function(sku: string, productName: string) {
      const toast = document.getElementById("restock-toast");
      const title = document.getElementById("toast-title");
      const msg = document.getElementById("toast-msg");

      if (!toast) return;

      if (title) title.textContent = `Reorden: ${sku}`;
      if (msg) msg.textContent = `Solicitud de pedido enviada para "${productName}".`;

      toast.classList.remove("translate-y-24", "opacity-0", "pointer-events-none");
      toast.classList.add("translate-y-0", "opacity-100");

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.add("translate-y-24", "opacity-0", "pointer-events-none");
        toast.classList.remove("translate-y-0", "opacity-100");
      }, 3500);
    };

    // Filtro en tiempo real para la tabla de transacciones
    const searchInput = document.getElementById("search-transactions-input") as HTMLInputElement | null;
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
        const rows = document.querySelectorAll(".transaction-row");
        let visibleCount = 0;

        rows.forEach((row) => {
          const text = (row as HTMLElement).textContent?.toLowerCase() || "";
          if (text.includes(query)) {
            (row as HTMLElement).style.display = "";
            visibleCount++;
          } else {
            (row as HTMLElement).style.display = "none";
          }
        });

        const summary = document.getElementById("table-summary-text");
        if (summary) {
          summary.textContent = `Mostrando ${visibleCount} transacciones encontradas`;
        }
      });
    }

    // Inicializar
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", loadSessionData);
    } else {
      loadSessionData();
    }
  </script>
